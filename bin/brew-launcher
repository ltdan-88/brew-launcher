    rows+=("                    nothing's marked)")
    rows+=("  Favorite Multiple  Same idea, for Favorites")
    rows+=("Categorize Multiple  Same idea, for one category — prompts once")
    rows+=("                    for the whole batch, not once per tool")
    rows+=("")
