#!/usr/bin/env zsh

# ============================================================
# brew-launcher
#
# Interactive launcher for installed Homebrew CLI applications.
#
# Homebrew + fzf
#
# Usage:
#   brew-launcher
#   brew-launcher --refresh
#   brew-launcher --list
#   brew-launcher --preset <name>
#   brew-launcher --diagnose
#   brew-launcher --version
#   brew-launcher --help
# ============================================================

setopt pipefail
setopt null_glob

# Resolved once, used to re-invoke this same script for the footer
# mouse-click handler below (${0:A} follows symlinks to the real
# path — needed since Homebrew installs this via a symlink chain).
SCRIPT_PATH="${0:A}"

# The cache-writer used to be a python3 heredoc embedded right inside
# rebuild_cache() below; it's now a real standalone file, invoked as a
# plain script instead. ${SCRIPT_PATH:h:h} strips "/bin/brew-launcher"
# down to the install prefix (dev checkout root, or a Homebrew keg
# root) — this file lives at "lib/brew-launcher/..." under that same
# prefix in both cases, dev checkout and Homebrew keg alike, so one
# path expression covers both without knowing which one it's in.
CACHE_WRITER_PY="${SCRIPT_PATH:h:h}/lib/brew-launcher/cache_writer.py"

VERSION="0.58.0"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/brew-launcher"
CACHE_FILE="$CACHE_DIR/entries"
STATE_FILE="$CACHE_DIR/state"

# Bumped whenever the cache file's format changes in a way that makes
# an older cache wrong rather than merely stale. Recorded on the first
# line of STATE_FILE; a mismatch forces a rebuild even when Homebrew
# itself hasn't changed. Without this, a cache written by an older
# version stays "valid" indefinitely and format fixes never reach
# anyone whose installed formulae happen not to change.
#
#   2 — entries are newline-terminated (older caches dropped their
#       last entry when read back), and carry the 7th full_name field
#   3 — a rebuild also writes the per-formula details text (PREVIEW_DIR)
#   4 — that details text reserves a slot for the live category list
#   5 — details metadata labels are padded to 12, not 10
#   6 — a rebuild also writes the resolved executable path (8th
#       column), so Enter can launch it directly without a fresh
#       PATH lookup
#   7 — a rebuild also writes each formula's install timestamp (9th
#       column, from Homebrew's own installed[].time), for the
#       Recently Added view
#   8 — details text adds Installed/Update-available lines, and
#       metadata labels are padded to 18, not 12, to fit
#       "Update available"
#   9 — two new trailing fields per entry, default_category and
#       default_hidden, feeding the bundled curated data (see
#       "Bundled defaults" below)
CACHE_FORMAT_VERSION=9

# Side-channel for the footer mouse-click handler: which word was
# clicked, and which footer line it was on (for words that mean
# different things depending on context — see --internal-footer-click
# below). Cleared before every fzf call in run_fzf().
# PID-suffixed so two launchers running side by side can't consume
# each other's clicks.
#
# Exported, and only defaulted when unset, because the click handler
# re-runs this same script as a subprocess: computing "$$" fresh there
# would yield the *child's* PID and point at a different file than the
# launcher is watching. Inheriting the parent's value keeps both ends
# of the side-channel pointing at the same path.
export FOOTER_CLICK_FILE="${FOOTER_CLICK_FILE:-$CACHE_DIR/footer-click.$$}"

# Same idea as FOOTER_CLICK_FILE above, for a click on the main list's
# own NAME/SIZE column header — see --internal-header-click below.
export HEADER_CLICK_FILE="${HEADER_CLICK_FILE:-$CACHE_DIR/header-click.$$}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/brew-launcher"
IGNORE_FILE="$CONFIG_DIR/ignore"

# Override files for the bundled curated data (see "Bundled defaults"
# below) — both are the same one-command-per-line shape as IGNORE_FILE,
# just inverted in meaning:
#   SHOWN_FILE            force-show a command the bundled data hides
#                          by default (F6 on an entry hidden only
#                          because of that, never IGNORE_FILE)
#   CATEGORY_EXCLUDE_FILE force-exclude a command from every bundled
#                          category assignment (F8 "remove" on an entry
#                          whose only category membership is bundled)
# Neither is ever written to for a command the user hid/categorized
# themselves — those already have their own real, unambiguous file.
SHOWN_FILE="$CONFIG_DIR/shown"
CATEGORY_EXCLUDE_FILE="$CONFIG_DIR/category-exclude"

# Fixed path, overwritten on every Backup — see create_backup() below.
# Deliberately not timestamped: a backup you point a synced folder
# (iCloud Drive, Dropbox) at once and forget about, not one that needs
# manual cleanup of older copies over time.
BACKUP_FILE="$HOME/brew-launcher-backup.tar.gz"

# Persisted defaults for things an env var can already override for one
# run — BREW_LAUNCHER_TERMINAL and BREW_LAUNCHER_THEME still win if
# set, this is just what to fall back to instead of the hardcoded
# defaults, once, without setting an env var every session.
#
# Parsed as plain KEY=value data, not sourced as shell code — every
# other file in CONFIG_DIR (ignore, categories/*, launch-history) is
# inert data the user's own edits can't turn into something that
# executes, and this stays consistent with that rather than becoming
# the one file in here that's actually a script.
CONFIG_FILE="$CONFIG_DIR/config"

CONFIG_TERMINAL=""
CONFIG_THEME=""
CONFIG_CUSTOM_COLORS=""
CONFIG_DEFAULT_CATEGORIES=""
CONFIG_DEFAULT_HIDDEN=""
CONFIG_OPEN_TO_CATEGORIES=""
CONFIG_SORT=""
CONFIG_ALT_KEYBINDS=""
CONFIG_DETAILS_POSITION=""
CONFIG_COMPACT_VIEW=""

if [[ -f "$CONFIG_FILE" ]]; then

    while IFS='=' read -r config_key config_value; do

        config_key="${config_key#"${config_key%%[![:space:]]*}"}"
        config_key="${config_key%"${config_key##*[![:space:]]}"}"
        config_value="${config_value#"${config_value%%[![:space:]]*}"}"
        config_value="${config_value%"${config_value##*[![:space:]]}"}"

        [[ -z "$config_key" ]] && continue
        [[ "$config_key" == \#* ]] && continue

        case "$config_key" in
            TERMINAL)            CONFIG_TERMINAL="$config_value" ;;
            THEME)               CONFIG_THEME="$config_value" ;;
            CUSTOM_COLORS)       CONFIG_CUSTOM_COLORS="$config_value" ;;
            DEFAULT_CATEGORIES)  CONFIG_DEFAULT_CATEGORIES="$config_value" ;;
            DEFAULT_HIDDEN)      CONFIG_DEFAULT_HIDDEN="$config_value" ;;
            OPEN_TO_CATEGORIES)  CONFIG_OPEN_TO_CATEGORIES="$config_value" ;;
            SORT)                CONFIG_SORT="$config_value" ;;
            ALT_KEYBINDS)        CONFIG_ALT_KEYBINDS="$config_value" ;;
            DETAILS_POSITION)    CONFIG_DETAILS_POSITION="$config_value" ;;
            COMPACT_VIEW)        CONFIG_COMPACT_VIEW="$config_value" ;;
        esac

    done < "$CONFIG_FILE"
fi

# One file per category, one command per line — same convention as
# IGNORE_FILE above. Created/edited in-picker via F6 (Favorites only)
# and F7 (any category), or by hand. "Favorites" is just an ordinary
# category file with a name the picker order treats specially (see
# load_category_names).
CATEGORIES_DIR="$CONFIG_DIR/categories"

# One file per preset, same one-command-per-line convention as
# IGNORE_FILE and CATEGORIES_DIR — hand-edited, no in-picker creation
# UI. Consumed only by --preset, which launches every command in the
# file together in one tmux session (one pane each).
PRESETS_DIR="$CONFIG_DIR/presets"

# One line appended per successful launch — deliberately a plain
# append-only log, not a "name: count" file that would need reading,
# incrementing and rewriting on every single launch. Counting is done
# by tallying this on demand (see load_launch_counts), which stays
# cheap at any realistic size. Lives under CONFIG_DIR, not CACHE_DIR:
# usage history is something you'd want to survive a cache clear, the
# same reasoning that already puts Favorites/categories/ignore there.
LAUNCH_HISTORY_FILE="$CONFIG_DIR/launch-history"

# Tab-separated "command<TAB>flags" lines — extra arguments to always
# pass a command whenever it's actually launched. One answer for both
# the "always run this with specific arguments" and the "same, but
# for a preset member" cases. Keyed by command name, same as every
# other per-entry marker here (hidden, favorited, categorized), rather
# than per-formula or per-preset separately — one config answers both
# requests, since a preset launches the exact same commands the main
# list does (see run_preset()'s own lookup). Tab-separated, not
# KEY=value like CONFIG_FILE: a flags string legitimately contains "="
# (e.g. "--config=/path"), which set_config_value()'s own key=value
# split would misparse as part of the key.
LAUNCH_FLAGS_FILE="$CONFIG_DIR/launch-flags"

# How many entries the computed views (Most Used, Recently Launched,
# Recently Added) cap themselves to. All three stay meaningful —
# "your actual most-used tools", "what did I just run", "what's
# actually new" — only if they stay short; uncapped, "Recently Added"
# on a long-lived install would just become "everything, sorted by
# date", and the other two the same "everything, sorted by count/
# recency".
COMPUTED_VIEW_LIMIT=15

# Outdated-formula snapshot. Refreshed independently of the full cache
# (see refresh_outdated_if_stale below) so the outdated indicator doesn't
# go stale for days just because nothing locally installed has changed.
OUTDATED_FILE="$CACHE_DIR/outdated"
OUTDATED_TTL=21600  # 6 hours

# Homebrew's own on-disk footprint (the Cellar), for the border label.
# Unlike free disk space (a single fast syscall via `df`, cheap enough
# to check on every launch), this needs `du` to actually walk the
# Cellar tree — measured at ~0.28s against a real ~3GB/113-formula
# install, a real cost against this project's own "instant startup"
# bar. Cached here and only recomputed when rebuild_cache() runs,
# since a local install/uninstall is the only thing that changes it —
# no separate TTL needed, the existing cache-rebuild trigger already
# lines up exactly with when this number could actually be different.
HOMEBREW_USAGE_FILE="$CACHE_DIR/homebrew-usage"

# One plain-text file per formula, written during a cache rebuild from
# the JSON already fetched there. The preview pane just cats one of
# these — `brew info` takes ~0.64s and fzf re-runs the preview on every
# cursor move, which would make scrolling unusable.
PREVIEW_DIR="$CACHE_DIR/previews"

# Placeholder written into each preview file where the live category
# list belongs. Category membership is the one thing in the pane that
# can't be precomputed — F6/F7 change it constantly — so the cached
# text reserves a slot inside the metadata block and the renderer fills
# it in. Passed to the Python cache writer so both sides agree on it.
PREVIEW_CATEGORY_MARKER="@@CATEGORIES@@"

# Same reasoning as PREVIEW_CATEGORY_MARKER above, for "which presets
# is this command part of" in the F3 details pane. Preset membership
# is per-command too (a preset file lists commands,
# same as a category file), so it's filled in at render time from
# PRESETS_DIR the same way category membership is filled in from
# CATEGORIES_DIR, not baked into the per-formula cache at build time.
PREVIEW_PRESET_MARKER="@@PRESETS@@"

# How long to trust the cache without re-asking Homebrew whether
# anything was installed or removed. That check costs ~0.54s of a
# ~0.55s launch, so skipping it is effectively the entire startup time.
#
# The trade is a window where a just-installed tool isn't listed yet.
# 60s keeps that short, and F5 forces a refresh immediately if you hit
# it. --refresh bypasses this entirely.
STATE_TTL=60

# ------------------------------------------------------------
# The standard env-var trio every other SSH-aware tool checks — good
# enough to tell "remote text session" from "local GUI session"
# without a heavier dependency. Shared by preset_show_session(),
# the "auto" terminal-backend detection, and --diagnose, all further
# down, so all three stay in agreement about what counts as SSH
# rather than drifting apart. Defined up here (rather than next to its
# first use) specifically so --diagnose can call it: zsh doesn't
# hoist function definitions, so anything called from the early
# --diagnose dispatch below must already be defined by this point —
# see the F5/pick_view() startup crash in the roadmap history for why
# this ordering constraint is taken seriously here.
# ------------------------------------------------------------

is_ssh_session() {
    [[ -n "${SSH_TTY:-}${SSH_CONNECTION:-}${SSH_CLIENT:-}" ]]
}

# A plain function (rather than inlined at its call sites) specifically
# so it can be sourced and tested directly with real env vars, the same
# way test/*.sh already does for other pure decision logic in this
# file — this exact choice has now caused two live-reported hangs
# (Ghostty reached for over SSH, no display to put a window in), so it
# earns a real regression test rather than only living inline.
#
# SSH is checked first, ahead of Ghostty — a Mac reachable over SSH
# still has Ghostty.app sitting in /Applications, so that check alone
# can't tell "GUI available" from "GUI unreachable from here."
#
# Picking "tmux" for the SSH+already-in-tmux case is *not* the thing
# the comment on the real tmux-selection check (further down) warns
# against — that's about never choosing tmux just because it happens
# to be installed, an incidental machine fact. $TMUX being set means
# the opposite: the user already, deliberately, ran `tmux` themselves
# before this launcher. Detecting a session someone is already sitting
# in isn't starting one on their behalf, and it's a strictly better
# default than a GUI window it can't actually open — the "reattach"
# fallback presets already rely on, now the default over SSH for
# single tools too.
resolve_auto_terminal() {

    if is_ssh_session; then
        if [[ -n "$TMUX" ]]; then
            printf 'tmux'
        else
            printf 'current'
        fi
    elif [[ "$(uname -s)" == "Darwin" ]] &&
       command -v osascript >/dev/null 2>&1 &&
       [[ -d "/Applications/Ghostty.app" ]]; then
        printf 'ghostty'
    else
        printf 'current'
    fi
}

# ------------------------------------------------------------
# Portable file mtime, as a Unix timestamp.
#
# `stat -f %m` and `stat -c %Y` were tried in one line with `||`
# between them (BSD/macOS stat, then GNU/Linux stat), on the
# assumption that whichever flag the platform doesn't support would
# simply fail and fall through. That assumption was wrong: GNU stat's
# `-f` is a real, different flag ("filesystem status" instead of
# "format string"), so it doesn't error on Linux — it silently prints
# something else, which then reached an `(( ))` arithmetic context as
# non-numeric garbage and crashed with "bad math expression". Caught
# by the first real CI run on a Linux runner. Branching on `uname -s`
# explicitly, matching how the rest of the script already tells macOS
# and Linux apart, is correct where "try both and hope one errors"
# wasn't.
# ------------------------------------------------------------

file_mtime() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        stat -f %m "$1" 2>/dev/null
    else
        stat -c %Y "$1" 2>/dev/null
    fi
}

# ------------------------------------------------------------
# Help / version
# ------------------------------------------------------------

if [[ "$1" == "--version" || "$1" == "-v" ]]; then
    echo "brew-launcher $VERSION"
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<EOF
brew-launcher $VERSION

Interactive launcher for installed Homebrew CLI applications.

Usage:
  brew-launcher              Launch the application picker
  brew-launcher --refresh    Rebuild the application cache
  brew-launcher --list       Print entries as tab-separated plain text
  brew-launcher --preset X   Launch preset X's commands together in tmux
  brew-launcher --diagnose   Check dependencies, config and cache health
  brew-launcher --version    Show version
  brew-launcher --help       Show this help

Requirements:
  Homebrew
  fzf
  python3
  tmux    Optional — only for the tmux terminal backend and Presets

Terminal:
  BREW_LAUNCHER_TERMINAL=auto     Default behavior — see below for
                                  exactly what "auto" picks and when
  BREW_LAUNCHER_TERMINAL=current  Run in the current terminal
  BREW_LAUNCHER_TERMINAL=ghostty  Launch in a new Ghostty tab
  BREW_LAUNCHER_TERMINAL=tmux     Launch in a new tmux window (only
                                  when already inside a tmux session;
                                  falls back to "current" otherwise —
                                  never auto-starts tmux for you)

  "auto" itself: a Mac with Ghostty installed gets "ghostty", unless
  connected over SSH — a display to open a Ghostty window in doesn't
  exist there, so "auto" checks for that first (via the standard
  SSH_TTY/SSH_CONNECTION/SSH_CLIENT env vars) and picks "tmux" instead
  if already inside a tmux session, or "current" otherwise. Everywhere
  else — Linux, or a Mac without Ghostty — "auto" is just "current".

Presets:
  brew-launcher --preset <name>  Launch every command listed in
                                  ~/.config/brew-launcher/presets/<name>
                                  together, one per tmux pane. Unlike
                                  BREW_LAUNCHER_TERMINAL=tmux above,
                                  this always starts (or reattaches to)
                                  a tmux session — invoking --preset is
                                  itself the opt-in.

  In the launcher: F4 → Actions → Create Preset picks the tools and
  writes the file for you — no hand-editing required. Tab marks a
  tool and shows a number badge for the order it'll launch in (top
  to bottom in the file); Tab again on a marked tool unmarks it and
  renumbers the rest down. F9 launches an existing one without
  leaving the picker; its own details pane (always on, no toggle
  needed) previews what's actually in the highlighted preset — every
  command, numbered and with its description, in launch order rather
  than alphabetical. Ctrl-E rearranges an existing preset — the same
  Tab-to-mark screen, seeded with its current members already badged
  in order instead of starting blank, so unmarking then remarking a
  tool moves it without having to rebuild the whole thing (you can
  add or drop tools there too, not just reorder). Ctrl-R renames the
  highlighted preset (just a file rename, same name your presets
  directory already uses); Ctrl-D deletes it instead, asking first
  and showing how many commands it holds — the one action here you
  can't undo. Both F4 and F9 stay visible even if tmux isn't
  installed — pressing either then explains what to install rather
  than being hidden outright, so the feature is still discoverable.

  Mouse mode is on for every preset session (that session only, not
  your tmux config) — click a pane to focus it, drag a border to
  resize. Editing a preset while its session is still running rebuilds
  it with the new pane count next launch, instead of reattaching to
  the stale one from before the edit.

  How a preset actually shows up on screen depends on how you're
  connected — a multi-pane preset earns its own window rather than
  swallowing whatever's already open, whenever there's somewhere to
  put one. Either way, quitting/detaching brings the launcher back
  rather than leaving a dead pane or a bare shell behind:
    - Local Mac with Ghostty: opens a brand new Ghostty window (not a
      tab) attached to the session. The launcher you ran it from
      keeps running untouched; closing that window later relaunches
      the launcher right there.
    - Over SSH (or no Ghostty), already inside a tmux session: your
      client switches to the preset's session. Detaching (prefix+d)
      later, or the preset ending, relaunches the launcher in the
      window you switched from.
    - Over SSH (or no Ghostty), not inside tmux: takes over the
      current window — there's no other screen to put it in. Says so
      first. Detaching or the preset ending relaunches the launcher
      right there too. Run brew-launcher itself inside a tmux session
      to get the switch-instead-of-takeover behavior above.

Theme:
  BREW_LAUNCHER_THEME=catppuccin       Default
  BREW_LAUNCHER_THEME=gruvbox
  BREW_LAUNCHER_THEME=tokyonight
  BREW_LAUNCHER_THEME=nord
  BREW_LAUNCHER_THEME=dracula
  BREW_LAUNCHER_THEME=green            Green-phosphor CRT
  BREW_LAUNCHER_THEME=amber            Amber-phosphor CRT
  BREW_LAUNCHER_THEME=solarized-dark   Full color-wheel spread
  BREW_LAUNCHER_THEME=solarized-light  Same, on a cream background
  BREW_LAUNCHER_THEME=red-sands        Deep brick-red background
  BREW_LAUNCHER_THEME=custom           Your own palette — needs a
                                        CUSTOM_COLORS= config line too,
                                        see README.md

  Both settings persist without exporting them every session via
  ~/.config/brew-launcher/config (TERMINAL=..., THEME=...) — an env
  var above always wins over it for that one run. The same file also
  holds DEFAULT_CATEGORIES and DEFAULT_HIDDEN (each on|off, default
  on), toggled from Actions → Settings → Default Categories / Default
  Hidden — see "Bundled defaults" below.

  OPEN_TO_CATEGORIES=on (default off, toggled from Actions → Settings
  → Open to Categories) opens straight to the view picker on launch
  instead of All — worth turning on once your categories are actually
  populated (bundled, manual, or both), since an empty category list
  has nothing useful to open to. Esc from that first screen falls back
  to All, same as pressing it from F2 any other time.

  ALT_KEYBINDS=off (default on, toggled from Actions → Settings → Alt
  Keybinds) stops the footer from ever showing a key's ⌥ alias (e.g.
  F2/⌥V), even where there'd be room — on leaves that decision to
  whatever fits the terminal width, same as before this toggle
  existed. The F-keys themselves always work either way; this only
  changes what the footer prints.

  DETAILS_POSITION=top (default bottom, toggled from Actions →
  Settings → Details Position) opens the details/preview pane above
  the list instead of below it. Applies everywhere one shows up — the
  main list, F2, F9, and Actions/Settings' own always-on panes.

  COMPACT_VIEW=on (default off, toggled from Actions → Settings →
  Compact View) drops the version and size columns, and the +/#/*
  markers (and the footer legend explaining them), leaving just the
  name and description. Applies everywhere a row shows up, not only
  the main list.

  All of these toggles (and Sort, and the details-pane toggle) flip
  with Space as well as Enter, and reopen the Settings screen
  afterward rather than exiting to the main list — useful for
  touching more than one in the same visit.

Bundled defaults:
  A curated set of well-known formula -> category mappings, and a
  short hand-reviewed list of genuinely auxiliary commands (a multi-
  command formula's minor helper scripts, not its main tool), ships
  with the launcher and applies automatically to anything you haven't
  categorized or hidden yourself.

  Your own F6 (hide) or F8 (categorize) choice on any individual entry
  always overrides the bundled data for that entry, regardless of the
  two settings above. DEFAULT_CATEGORIES=off / DEFAULT_HIDDEN=off are
  only for someone who wants none of it applied, anywhere, from the
  start.

  A category that's entirely bundled (no real file yet) still shows up
  in the view picker and gets a real F8 press like any other — F8
  "remove" on a bundled-only membership excludes just that command from
  the bundled category rather than creating a redundant file entry.

Keyboard shortcuts:

  F1 / ⌥?   Help — the same reference shown below, from inside the
            launcher (as a short topic menu there, not one long list).
            Shown in the footer too, first — Presets is what a narrow
            terminal drops first now instead.

  Shown in the footer:
  F2 / ⌥V   Switch view (All, Favorites, your categories, Most Used,
            Recently Launched, Recently Added, Hidden)
  F3 / ⌥D   Show or hide the details pane (homepage, license,
            categories, presets it's part of, dependencies, caveats).
            Shift-Up/Down scrolls it.
  F4 / ⌥M   Open the Actions menu — the actions below. Named for what
            it does to the highlighted row, like a right-click menu
            would — its border label names that row too (e.g.
            "Actions on fastfetch"), so it's never ambiguous which
            entry it's about to act on. Its own details pane, always
            on, explains what each row actually does.
  F9 / ⌥P   Launch a preset — see Presets above. Its own details pane,
            always on like F4's, previews what's actually in the
            highlighted preset. Ctrl-R renames it, Ctrl-D deletes it.

  F4 and F9 also work from inside the view picker (F2) itself, not
  just the main list — no entry needs to be highlighted for F4.

  Not in the footer, but always available directly (also in Actions):
  F5 / ⌥R   Refresh the cache without leaving the launcher — works
            from inside the view picker (F2) too

  In the Actions menu, and always available directly:
  F6 / ⌥H   Hide or unhide selected entry
  F7 / ⌥F   Toggle Favorites for selected entry
  F8 / ⌥C   Categorize selected entry (adds or removes; instant while
            viewing a category, otherwise prompts for which one)

  In the Actions menu only, right under the three above — Hide
  Multiple, Favorite Multiple, Categorize Multiple. Each opens its own
  Tab-to-mark picker over whatever's currently on screen and acts on
  every marked entry at once (or just the highlighted one, if nothing
  was marked) — same idea as Create Preset's own tool picker, just
  without an order to track, since none of these three care about it.
  Relabel to their inverse (Unhide/Unfavorite Multiple) while viewing
  Hidden/Favorites, same as F6's own per-entry label. Categorize
  Multiple prompts for a category once for the whole batch — unless
  you're already viewing a real category, in which case every marked
  entry is already a member, so it removes them instantly instead,
  same as F8's own instant per-entry toggle in that same context.

  In the Actions menu only — Create Preset (from whatever view is
  currently on screen, not always the full list), Create a macOS or
  Linux shortcut, Settings (see below), Backup. Hide/Favorite/
  Categorize, their three Multiple counterparts, Create Preset, and
  Create Shortcut are all NOT offered when Actions is opened from the
  view picker (F2) — each of them needs an actual list of tools to act
  on, which a list of categories isn't. Only Settings and Backup show
  up there. Esc from any of them returns to the Actions menu, not out
  to the main list.

  Actions → Settings holds everything that's a standing preference
  rather than a one-off action: switch color theme, the two toggles
  under "Bundled defaults" above, Open to Categories, Sort by name or
  size (each with its own ascending/descending direction — Space
  cycles through all four), toggle the details pane (same toggle as
  F3 itself, mirrored here so its state is visible before opening it),
  toggle Alt Keybinds (see above). Its own always-on details pane
  explains each one. Esc from Settings returns to Actions, not out to
  the main list.

  The ⌥ (Option) aliases work if F-keys need Fn on your keyboard.
  In stock Terminal.app, enable "Use Option as Meta Key" in the
  profile's Keyboard settings first; Ghostty supports it by default.

Views:
  F2/⌥V switches what you're looking at: All, Favorites, your
  categories, then the computed views and Hidden last. "Hidden" is an
  ordinary view — Enter still launches there, and F6 unhides. F9 also
  works here, same as the main list. F3 in the picker previews what's
  actually in the highlighted category — every command it holds, with
  its description, including ones only there via the bundled defaults
  — built-in views (All, Hidden, Most Used, Recently Launched,
  Recently Added) say there's nothing stored to preview instead.
  Ctrl-R in the picker
  renames the
  highlighted category (just a file rename —
  a category's name is its filename in
  ~/.config/brew-launcher/categories, nothing else to update); a
  category that only exists via the bundled defaults, with no real
  file of its own yet, needs one F8 first. Ctrl-D deletes the
  highlighted category outright (All, Hidden and
  Favorites can neither be renamed nor deleted; Favorites has its own
  F7 toggle). Deleting asks first and shows how many entries the
  category holds — it's the one action here you can't undo.

  Esc goes up one level at a time: the details pane (if open) -> a
  filtered view -> the view picker -> All -> a Quit/Cancel confirm
  (Esc there means Cancel too, so a second stray Esc doesn't compound
  the first).

Categories:
  F7/⌥F toggles Favorites for the selected entry, instantly. F8/⌥C is
  the same idea for every other category:

    - While viewing a specific category, it instantly adds or removes
      the selected entry from that category — no prompt, exactly like
      F6 does for Favorites.
    - Otherwise it asks which category: pick an existing one, or type
      a new name to create it. Picking one the entry is already in
      removes it.

  F7 never touches Favorites — F6 owns that exclusively — and it
  always refreshes in place rather than navigating you elsewhere.

  Uninstalling a favorited or categorized tool doesn't leave it behind
  forever — the next real cache rebuild (--refresh, F5, or the
  periodic background one) drops it from every category file it was
  in, Favorites included, once that rebuild confirms it's actually
  gone. Comments and blank lines in a category file are left alone;
  only an actual command line for something no longer installed is
  removed.

  No manual file editing needed for any of this. Categories match on
  command name (use --list to find it), not formula name.
  Row markers describe state, they aren't actions:
    "*"  suffixed on the version (e.g. "1.4.7*") — outdated, a newer
         version exists. Upgrading stays Homebrew's job.
    "+"  before the name — favorited
    "#"  before the name — in some category
  "+" and "#" can show together (e.g. "+#").

Mouse:
  Click a row to select it, double-click to launch it. Footer words
  shown in [brackets] are also clickable and do exactly what the key
  next to them does (e.g. clicking [Hide] is the same as pressing
  F2). Plain, unbracketed footer text — like the "+"/"*" legend or
  "Navigate" — isn't clickable; it's there to explain, not to act on.
  Clicking NAME or SIZE in the column header sorts by it directly,
  same as F4 → Actions → Settings → Sort — click the same one again
  to reverse direction.

Launch Flags:
  F4 → Actions → Launch Flags on a highlighted entry sets extra
  arguments to always pass it whenever it launches. Prefilled with
  whatever's already set; blank and Enter clears it (a real, different
  answer from Esc here, not the same "never mind"). Stored per
  command, the same key every other per-entry marker uses, so it
  applies wherever that command actually launches — the main list's
  own Enter, and any preset it's a member of — from one setting, not
  two.

Run With Args:
  F4 → Actions → Run With Args on a highlighted entry launches it right
  now with extra arguments, just this once — nothing is saved.
  Prefilled with its Launch Flags, if any, as a starting point, but
  blank and Enter here just runs it plain (there's nothing stored to
  clear the way there is in Launch Flags). Esc cancels without
  launching. Still counted toward Most Used and Recently Launched,
  same as any other launch. F3 / ⌥D from that prompt shows the tool's
  own --help output, on demand only — not automatically, since some
  installed tools (games, animations) may not recognize --help and
  would otherwise launch straight into their own full-screen mode. A
  tool like that is killed after a second instead of left running.

Update All:
  Actions → Update All runs 'brew upgrade' for everything outdated, in
  a real terminal so you see its actual output — the same
  current-terminal/tmux/Ghostty paths a normal tool launch already
  goes through. Shows how many formulae are outdated (the same count
  the * marker and F3 details pane already read) and asks first, since
  this can take a while. Relaunches afterward same as any other
  launch; F5 picks up the new versions right away.

Update:
  Actions → Update on a highlighted entry runs 'brew upgrade' for just
  that one formula, same real-terminal behavior as Update All. No
  confirm — already up to date just says so and does nothing. Shows
  the new version in its own row, if one's available.

Backup:
  Actions → Backup writes one file, ~/brew-launcher-backup.tar.gz
  (always that path, overwritten on every run — point a synced folder
  at it once and forget about it), containing:

    - A Brewfile from 'brew bundle dump': every installed formula,
      cask and tap, including the tap this launcher itself came from.
    - brew-launcher-config/: a copy of ~/.config/brew-launcher —
      categories, presets, hidden entries, favorites, theme, terminal
      backend. Everything above doesn't know this launcher exists;
      this is the other half.

  Restoring on a fresh machine is two manual steps, not a launcher
  action of its own: untar the archive, run
  'brew bundle install --file=Brewfile', then copy
  brew-launcher-config back to ~/.config/brew-launcher.

Behavior:
  • Applications are discovered automatically from Homebrew.
  • The launcher maintains a local cache for fast startup.
  • On macOS, 'auto' prefers Ghostty when available.
  • On Linux, 'auto' uses the current terminal.
  • Over SSH, 'auto' never reaches for Ghostty (no display to open a
    window in) — tmux if you're already inside a tmux session,
    otherwise the current terminal.
  • Quitting a launched tool relaunches the picker (in place, or in
    that same tab/window) rather than dropping to a plain shell —
    after a "press any key to continue" pause, so a one-shot command's
    output (fastfetch, eza, jq, ...) stays on screen until you're
    ready, instead of the picker painting over it immediately.
EOF
    exit 0
fi

# ------------------------------------------------------------
# --diagnose
#
# Deliberately placed here, alongside --help/--version, rather than
# down with --refresh/--list/--preset below: those all go through the
# hard "brew/fzf/python3 required" exit further down, but a diagnostic
# command's whole purpose is to still run and explain *what's* missing
# when one of those isn't installed. It also needs to run before that
# block for the same reason --help does — it shouldn't require a
# working Homebrew/fzf install just to report that one is missing.
# ------------------------------------------------------------

if [[ "$1" == "--diagnose" ]]; then

    diagnose_issues=0

    diagnose_ok()   { printf '  [ok]   %s\n' "$1"; }
    diagnose_warn() { printf '  [warn] %s\n' "$1"; }
    diagnose_fail() { printf '  [FAIL] %s\n' "$1"; diagnose_issues=$((diagnose_issues + 1)); }

    echo "brew-launcher $VERSION — diagnostics"

    echo
    echo "System"
    diagnose_ok "$(uname -s) $(uname -r)"
    diagnose_ok "zsh $ZSH_VERSION"

    echo
    echo "Required"
    for dependency in brew fzf python3; do
        if command -v "$dependency" >/dev/null 2>&1; then
            diagnose_ok "$dependency — $(command -v "$dependency")"
        else
            diagnose_fail "$dependency — not found (brew-launcher cannot start without this)"
        fi
    done

    echo
    echo "Optional"
    if command -v tmux >/dev/null 2>&1; then
        diagnose_ok "tmux — $(command -v tmux) (tmux terminal backend and Presets available)"
    else
        diagnose_warn "tmux — not found ('brew install tmux' enables the tmux terminal backend and Presets)"
    fi

    if [[ "$(uname -s)" == "Darwin" ]]; then
        if [[ -d "/Applications/Ghostty.app" ]]; then
            diagnose_ok "Ghostty.app — found"
        else
            diagnose_warn "Ghostty.app — not found ('auto' terminal backend falls back to 'current')"
        fi
        if command -v osascript >/dev/null 2>&1; then
            diagnose_ok "osascript — $(command -v osascript)"
        else
            diagnose_warn "osascript — not found (Ghostty terminal backend unavailable)"
        fi
    fi

    echo
    echo "Terminal backend"
    if is_ssh_session; then
        diagnose_ok "SSH session detected"
    else
        diagnose_ok "local session (not over SSH)"
    fi
    [[ -n "$TMUX" ]] && diagnose_ok "already inside a tmux session"

    diagnose_terminal="${BREW_LAUNCHER_TERMINAL:-${CONFIG_TERMINAL:-auto}}"
    case "$diagnose_terminal" in
        auto|current|ghostty|tmux) ;;
        *) diagnose_fail "configured terminal '$diagnose_terminal' is not one of auto/current/ghostty/tmux" ;;
    esac
    if [[ "$diagnose_terminal" == "auto" ]]; then
        diagnose_ok "resolves to: $(resolve_auto_terminal) (via auto)"
    else
        diagnose_ok "resolves to: $diagnose_terminal"
    fi

    echo
    echo "Config — $CONFIG_DIR"
    if [[ ! -d "$CONFIG_DIR" ]]; then
        diagnose_warn "not created yet (created on first use)"
    elif [[ ! -w "$CONFIG_DIR" ]]; then
        diagnose_fail "not writable"
    else
        diagnose_ok "writable"
        if [[ -f "$CONFIG_FILE" ]]; then
            diagnose_ok "config file present"
        else
            diagnose_ok "no config file yet (using defaults)"
        fi
        diagnose_categories="$(find "$CATEGORIES_DIR" -type f 2>/dev/null | wc -l | tr -d ' ')"
        diagnose_presets="$(find "$PRESETS_DIR" -type f 2>/dev/null | wc -l | tr -d ' ')"
        diagnose_ok "$diagnose_categories categories, $diagnose_presets presets"
    fi

    echo
    echo "Cache — $CACHE_DIR"
    if [[ ! -d "$CACHE_DIR" ]]; then
        diagnose_warn "not created yet — run brew-launcher once to build it"
    elif [[ ! -w "$CACHE_DIR" ]]; then
        diagnose_fail "not writable"
    else
        diagnose_ok "writable"

        if [[ -f "$STATE_FILE" ]]; then
            diagnose_cached_format="$(sed -n '1p' "$STATE_FILE")"
            if [[ "$diagnose_cached_format" == "$CACHE_FORMAT_VERSION" ]]; then
                diagnose_ok "cache format v$diagnose_cached_format (current)"
            else
                diagnose_warn "cache format v$diagnose_cached_format, expected v$CACHE_FORMAT_VERSION — will rebuild on next launch"
            fi

            diagnose_state_mtime="$(file_mtime "$STATE_FILE")"
            if [[ -n "$diagnose_state_mtime" ]]; then
                diagnose_age=$(( $(date +%s) - diagnose_state_mtime ))
                if (( diagnose_age < STATE_TTL )); then
                    diagnose_ok "verified against Homebrew ${diagnose_age}s ago (within the ${STATE_TTL}s TTL)"
                else
                    diagnose_ok "verified against Homebrew ${diagnose_age}s ago — past the ${STATE_TTL}s TTL, will re-check on next launch"
                fi
            fi
        else
            diagnose_warn "no cache yet — run brew-launcher once to build it"
        fi

        if [[ -f "$CACHE_FILE" ]]; then
            diagnose_ok "$(wc -l < "$CACHE_FILE" | tr -d ' ') cached entries"
        fi
    fi

    if [[ -f "$BACKUP_FILE" ]]; then
        echo
        echo "Backup"
        diagnose_backup_mtime="$(file_mtime "$BACKUP_FILE")"
        if [[ -n "$diagnose_backup_mtime" ]]; then
            diagnose_ok "$BACKUP_FILE ($(( ( $(date +%s) - diagnose_backup_mtime ) / 86400 ))d old)"
        else
            diagnose_ok "$BACKUP_FILE"
        fi
    fi

    echo
    if (( diagnose_issues > 0 )); then
        echo "$diagnose_issues problem(s) found."
        exit 1
    else
        echo "No problems found."
        exit 0
    fi
fi

# ------------------------------------------------------------
# Footer mouse-click handler (internal use only)
#
# Invoked by run_fzf()'s click-footer bind as a fresh subprocess of
# this same script — not by a user. fzf sets FZF_CLICK_FOOTER_WORD
# (and _LINE) in that subprocess's environment for the duration of
# the click; there's no way to hand that back to the *original*
# fzf-invoking process directly, so this writes it to a small file
# (FOOTER_CLICK_FILE) that the main loop reads after fzf exits.
#
# Placed this early specifically so it skips all the normal startup
# work (dependency checks, cache validation) — a mouse click needs to
# feel instant, not pay the cost of a full launch.
#
# Recognized words fall into two groups:
#   - print "accept": same as pressing Enter on the highlighted item,
#     but first records which word was clicked so the main loop can
#     override $action to match (e.g. "Hide" behaves like F2).
#   - print "abort": same as pressing Esc — for words whose meaning
#     is "go back", where there's nothing to record.
# Anything else (decorative words like "Navigate" or the "+"/"*"
# legend) prints "ignore" — the click does nothing, deliberately, so
# an unrecognized or purely-informational click can't accidentally
# launch whatever happens to be highlighted.
# ------------------------------------------------------------

if [[ "$1" == "--internal-footer-click" ]]; then

    case "$FZF_CLICK_FOOTER_WORD" in
        '[Hide]'|Hide|'[Unhide]'|Unhide|F6/⌥H|F6| \
        '[Views]'|Views|F2/⌥V|F2| \
        '[Details]'|Details|F3/⌥D|F3| \
        '[Presets]'|Presets|F9/⌥P|F9| \
        '[Favorite]'|Favorite|F7/⌥F|F7| \
        '[Categorize]'|Categorize|F8/⌥C|F8| \
        '[Actions]'|Actions|F4/⌥M|F4| \
        '[Help]'|Help|F1/⌥\?|F1| \
        '[Choose]'|Choose| \
        '[Quit]'|Quit|'[Close]'|Close|Enter|'[Launch]'|Launch| \
        '[View]'|View|'[Delete]'|Delete)
            mkdir -p "$CACHE_DIR"
            printf '%s\n%s\n' "$FZF_CLICK_FOOTER_WORD" "$FZF_CLICK_FOOTER_LINE" > "$FOOTER_CLICK_FILE"
            printf 'accept'
            ;;
        '[Back]'|Back|'[Cancel]'|Cancel)
            printf 'abort'
            ;;
        *)
            printf 'ignore'
            ;;
    esac

    exit 0
fi

# ------------------------------------------------------------
# Header mouse-click handler (internal use only)
#
# Same idea as --internal-footer-click above — invoked by run_fzf()'s
# own click-header bind as a fresh subprocess, writing to a
# side-channel file (HEADER_CLICK_FILE) the main loop reads after fzf
# exits. Column math against FZF_HEADER (exported once it's built),
# not FZF_CLICK_HEADER_WORD's own word detection — confirmed live that
# --delimiter=$'\t' (needed for the list's own real/display split)
# makes fzf stop splitting the header into words at all, reporting the
# entire header line as one "word" instead. FZF_CLICK_HEADER_COLUMN
# still works correctly in that situation and is all this needs.
#
# Each column's own clickable range runs from where its label starts
# to right before the next label — the whole padded field, not just
# the bare word's own 4 letters, so build_fzf_header()'s own sort
# arrow (" ↑"/" ↓", appended right after the word) falls inside the
# same range and is just as clickable as the word itself, without this
# handler needing to know an arrow is even there.
#
# Only NAME and SIZE are recognized — the two columns Actions -> Sort
# already understands (see toggle_sort). VERSION, DESCRIPTION and the
# blank space between columns fall through to "ignore" — there's no
# third column to sort by. In Compact View the header has no "SIZE"
# substring at all (build_fzf_header() drops that column entirely), so
# a click there can only ever match NAME — no separate guard needed.
#
# Unlike the footer's row of distinct actions, NAME and SIZE both mean
# the same kind of thing (pick this column as the active sort) — the
# main loop below picks the actual column, then flips direction if
# it's the one already active rather than switching columns, matching
# a spreadsheet's own "click again to reverse" convention.
# ------------------------------------------------------------

if [[ "$1" == "--internal-header-click" ]]; then

    clicked_column=""

    # Each column's clickable range runs from where its own label
    # starts to right before the next column's label — the whole
    # padded field, arrow indicator included, not just the bare word's
    # own 4 letters. A build_fzf_header() sort arrow (" ↑"/" ↓") sits
    # right after the word, inside this same range, so clicking the
    # arrow itself works exactly like clicking the word.
    name_prefix="${FZF_HEADER%%NAME*}"
    if [[ "$name_prefix" != "$FZF_HEADER" ]]; then
        name_start=$(( ${#name_prefix} + 1 ))
        after_name="${FZF_HEADER#*NAME}"

        # NAME's next neighbor is VERSION in the normal layout, or
        # DESCRIPTION directly in Compact View (no VERSION/SIZE at
        # all) — checked in that order since VERSION only exists in
        # the layout where it'd actually appear after NAME.
        version_prefix="${after_name%%VERSION*}"
        if [[ "$version_prefix" != "$after_name" ]]; then
            name_end=$(( name_start + 3 + ${#version_prefix} ))
        else
            description_prefix="${after_name%%DESCRIPTION*}"
            name_end=$(( name_start + 3 + ${#description_prefix} ))
        fi

        (( FZF_CLICK_HEADER_COLUMN >= name_start && FZF_CLICK_HEADER_COLUMN <= name_end )) &&
            clicked_column="NAME"
    fi

    if [[ -z "$clicked_column" ]]; then
        size_prefix="${FZF_HEADER%%SIZE*}"
        if [[ "$size_prefix" != "$FZF_HEADER" ]]; then
            size_start=$(( ${#size_prefix} + 1 ))

            # SIZE only ever appears in the layout where DESCRIPTION
            # follows it directly — no Compact-View equivalent to
            # branch on, unlike NAME above.
            after_size="${FZF_HEADER#*SIZE}"
            description_prefix="${after_size%%DESCRIPTION*}"
            size_end=$(( size_start + 3 + ${#description_prefix} ))

            (( FZF_CLICK_HEADER_COLUMN >= size_start && FZF_CLICK_HEADER_COLUMN <= size_end )) &&
                clicked_column="SIZE"
        fi
    fi

    if [[ -n "$clicked_column" ]]; then
        mkdir -p "$CACHE_DIR"
        printf '%s\n' "$clicked_column" > "$HEADER_CLICK_FILE"
        printf 'accept'
    else
        printf 'ignore'
    fi

    exit 0
fi

# ------------------------------------------------------------
# Details-pane renderer (internal use only)
#
# Invoked by run_fzf()'s --preview as a fresh subprocess, once per
# highlighted row. Almost all of the text was precomputed during the
# last cache rebuild (see PREVIEW_DIR), because `brew info` costs
# ~0.64s and this runs on every cursor move.
#
# What's left to do here is substitute the live category list into the
# slot the cached file reserved for it. That slot sits inside the
# metadata block rather than at the end of the file, so it stays on
# screen without scrolling even when a formula carries long dependency
# or caveat sections.
#
# Placed this early for the same reason as the click handler above: it
# must skip all the normal startup work to feel instant.
# ------------------------------------------------------------

if [[ "$1" == "--internal-preview" ]]; then

    preview_command="$2"
    preview_file="$PREVIEW_DIR/$3"

    if [[ ! -f "$preview_file" ]]; then
        print -r -- "  no details cached — press F5 to refresh"
        exit 0
    fi

    # Matches on the command name, not the formula: one formula can
    # provide several commands and they can be filed separately.
    # The glob is expanded first because grep with no file operands
    # would read stdin and hang.
    preview_categories=()
    preview_category_files=("$CATEGORIES_DIR"/*(N))

    if (( ${#preview_category_files} )) && [[ -n "$preview_command" ]]; then
        preview_matches="$(grep -lxF -- "$preview_command" "${preview_category_files[@]}" 2>/dev/null)"

        # Split on newlines explicitly. An unquoted ${(f)$(...)} does not
        # split here, which silently collapses a multi-category result
        # into one glued string — :t then reports only the last name.
        if [[ -n "$preview_matches" ]]; then
            preview_categories=("${(@f)preview_matches}")
            preview_categories=("${preview_categories[@]:t}")
        fi
    fi

    # Nothing manual on this command — fall back to the bundled default
    # category (see "Bundled defaults"), same on/off and exclusion
    # rules the main list itself applies. A single grep against the
    # already-cached entries line is cheap enough for a per-keystroke
    # preview; no need to duplicate the category into every preview
    # file just to avoid it.
    preview_default_category=""

    if (( ${#preview_categories} == 0 )) &&
       [[ "$CONFIG_DEFAULT_CATEGORIES" != off && -n "$preview_command" ]] &&
       ! grep -Fqx "$preview_command" "$CATEGORY_EXCLUDE_FILE" 2>/dev/null; then

        preview_default_category="$(
            awk -F'\t' -v cmd="$preview_command" \
                '$1 == cmd { print $10; exit }' "$CACHE_FILE" 2>/dev/null
        )"

        # "-" is the cache's own placeholder for "no bundled category"
        # (see rebuild_cache) — treat it the same as empty here.
        [[ "$preview_default_category" == "-" ]] && preview_default_category=""
    fi

    # Same idea and same grep -lxF trick as the category lookup above,
    # against PRESETS_DIR instead of CATEGORIES_DIR — a preset file is
    # just a plain list of command names too.
    preview_presets=()
    preview_preset_files=("$PRESETS_DIR"/*(N))

    if (( ${#preview_preset_files} )) && [[ -n "$preview_command" ]]; then
        preview_preset_matches="$(grep -lxF -- "$preview_command" "${preview_preset_files[@]}" 2>/dev/null)"

        if [[ -n "$preview_preset_matches" ]]; then
            preview_presets=("${(@f)preview_preset_matches}")
            preview_presets=("${preview_presets[@]:t}")
        fi
    fi

    while IFS= read -r preview_line; do
        if [[ "$preview_line" == "$PREVIEW_CATEGORY_MARKER" ]]; then
            if (( ${#preview_categories} )); then
                printf '  %-18s%s\n' 'Categories' "${(j:, :)preview_categories}"
            elif [[ -n "$preview_default_category" ]]; then
                printf '  %-18s%s (default)\n' 'Categories' "$preview_default_category"
            fi
        elif [[ "$preview_line" == "$PREVIEW_PRESET_MARKER" ]]; then
            (( ${#preview_presets} )) &&
                printf '  %-18s%s\n' 'Presets' "${(j:, :)preview_presets}"
        else
            print -r -- "$preview_line"
        fi
    done < "$preview_file"

    exit 0
fi

# ------------------------------------------------------------
# F3 details preview for the view picker (F2): what's actually inside
# the highlighted category, at a glance.
#
# First shipped scoped to real category files only, refusing
# a bundled-only category (see load_bundled_categories) with an
# explanation instead of showing its tools — widened to show the
# union of both now: real file membership, plus every command whose
# cached default_category (field 10, the same one --internal-preview
# already reads for its own "(default)" note) matches this category
# name, minus anything CATEGORY_EXCLUDE_FILE says was explicitly taken
# back out — the exact membership load_category_members() computes for
# the real picker, just without needing that function's own globals
# (default_category_commands isn't populated this early — see it for
# why), reading straight from the cache instead.
# ------------------------------------------------------------

if [[ "$1" == "--internal-preview-category" ]]; then

    preview_view_name="$2"

    if [[ "$preview_view_name" == "All" || "$preview_view_name" == "Hidden" \
          || "$preview_view_name" == "Most Used" || "$preview_view_name" == "Recently Added" \
          || "$preview_view_name" == "Recently Launched" ]]; then
        print -r -- "  Not a stored category — nothing to preview."
        exit 0
    fi

    preview_category_file="$CATEGORIES_DIR/$preview_view_name"

    # Hidden-status check, inlined rather than calling
    # load_hidden_commands() — that (and the two loaders it calls in
    # turn) isn't defined yet this early. Same combining rule it uses:
    # explicitly hidden (IGNORE_FILE) OR bundled-hidden (CACHE_FILE
    # field 11) without an explicit F6 override (SHOWN_FILE). Raised
    # live after this preview shipped without it: the category's own
    # count (compute_category_counts(), which does exclude hidden
    # entries) and this preview visibly disagreed on how many tools a
    # category actually held — confirmed live against a real category
    # with two hidden members, count said 3, preview said 5.
    typeset -A preview_ignore_set preview_shown_set preview_bundled_hidden_set

    if [[ -f "$IGNORE_FILE" ]]; then
        while IFS= read -r preview_ignore_line; do
            preview_ignore_line="${preview_ignore_line#"${preview_ignore_line%%[![:space:]]*}"}"
            preview_ignore_line="${preview_ignore_line%"${preview_ignore_line##*[![:space:]]}"}"
            [[ -z "$preview_ignore_line" ]] && continue
            [[ "$preview_ignore_line" == \#* ]] && continue
            preview_ignore_set[$preview_ignore_line]=1
        done < "$IGNORE_FILE"
    fi

    if [[ -f "$SHOWN_FILE" ]]; then
        while IFS= read -r preview_shown_line; do
            [[ -n "$preview_shown_line" ]] && preview_shown_set[$preview_shown_line]=1
        done < "$SHOWN_FILE"
    fi

    # Field 11 (default_hidden) via awk, not a zsh `read` loop with
    # placeholder variables for the fields in between — see the field
    # 10 comment further down for why that combination silently
    # misreads a cache row.
    if [[ -f "$CACHE_FILE" ]]; then
        while IFS= read -r preview_bh_command; do
            [[ -n "$preview_bh_command" ]] && preview_bundled_hidden_set[$preview_bh_command]=1
        done < <(awk -F'\t' '$11 == "1" { print $1 }' "$CACHE_FILE")
    fi

    preview_is_hidden() {
        [[ -n "${preview_ignore_set[$1]-}" ]] && return 0
        [[ -n "${preview_bundled_hidden_set[$1]-}" && -z "${preview_shown_set[$1]-}" ]] && return 0
        return 1
    }

    typeset -A preview_category_seen
    preview_category_commands=()

    if [[ -f "$preview_category_file" ]]; then
        while IFS= read -r preview_member; do
            preview_member="${preview_member#"${preview_member%%[![:space:]]*}"}"
            preview_member="${preview_member%"${preview_member##*[![:space:]]}"}"
            [[ -z "$preview_member" ]] && continue
            [[ "$preview_member" == \#* ]] && continue
            [[ -n "${preview_category_seen[$preview_member]-}" ]] && continue
            preview_category_seen[$preview_member]=1
            preview_is_hidden "$preview_member" && continue
            preview_category_commands+=("$preview_member")
        done < "$preview_category_file"
    fi

    # Bundled contributions are skipped outright when Default
    # Categories is off (Actions -> Default Categories) — same guard
    # load_bundled_categories() itself opens with. Confirmed live: a
    # category with no real members of its own (an empty real file,
    # left over from before Default Categories was turned off) still
    # showed 3 bundled tools in the preview even though the count
    # correctly showed 0 — the preview had no idea the setting existed.
    #
    # Also skips a command that's already filed into some *other* real
    # category by hand — same as load_bundled_categories()'s own
    # manually_categorized_commands check, so a tool doesn't appear to
    # double-belong here and wherever it was actually filed.
    if [[ "$CONFIG_DEFAULT_CATEGORIES" != off && -f "$CACHE_FILE" ]]; then

        typeset -A preview_manually_categorized
        local preview_other_file preview_other_member

        for preview_other_file in "$CATEGORIES_DIR"/*(N); do
            [[ -f "$preview_other_file" ]] || continue
            [[ "${preview_other_file:t}" == "Favorites" ]] && continue

            while IFS= read -r preview_other_member; do
                preview_other_member="${preview_other_member#"${preview_other_member%%[![:space:]]*}"}"
                preview_other_member="${preview_other_member%"${preview_other_member##*[![:space:]]}"}"
                [[ -z "$preview_other_member" ]] && continue
                [[ "$preview_other_member" == \#* ]] && continue
                preview_manually_categorized[$preview_other_member]=1
            done < "$preview_other_file"
        done

        # Reads field 10 via awk, not a zsh `read` loop with
        # placeholder variables for the fields in between — confirmed
        # live that `IFS=$'\t' read` collapses a genuinely empty field
        # (field 6, "outdated", empty for anything not outdated)
        # together with its neighboring tab, silently shifting every
        # field after it left by one. awk's explicit -F'\t' doesn't
        # have that problem, which is exactly why --internal-preview's
        # own default-category lookup above already uses awk instead
        # of read for the same field.
        while IFS= read -r preview_bundled_command; do
            [[ -z "$preview_bundled_command" ]] && continue
            [[ -n "${preview_category_seen[$preview_bundled_command]-}" ]] && continue
            preview_category_seen[$preview_bundled_command]=1
            preview_is_hidden "$preview_bundled_command" && continue
            [[ -n "${preview_manually_categorized[$preview_bundled_command]-}" ]] && continue
            grep -Fqx -- "$preview_bundled_command" "$CATEGORY_EXCLUDE_FILE" 2>/dev/null && continue
            preview_category_commands+=("$preview_bundled_command")
        done < <(awk -F'\t' -v cat="$preview_view_name" '$10 == cat { print $1 }' "$CACHE_FILE")
    fi

    if (( ${#preview_category_commands[@]} == 0 )); then
        print -r -- "  Empty."
        exit 0
    fi

    # Alphabetical, unlike the preset preview below — a category has no
    # inherent order of its own the way a preset's launch order does.
    preview_category_commands=("${(@o)preview_category_commands}")

    for preview_member in "${preview_category_commands[@]}"; do
        preview_member_desc="$(awk -F'\t' -v cmd="$preview_member" '$1 == cmd { print $2; exit }' "$CACHE_FILE" 2>/dev/null)"
        if [[ -n "$preview_member_desc" ]]; then
            printf '  %-20s%s\n' "$preview_member" "$preview_member_desc"
        else
            printf '  %s\n' "$preview_member"
        fi
    done

    exit 0
fi

# ------------------------------------------------------------
# Details preview for the preset picker (F9): what's actually in the
# highlighted preset, at a glance. Same motivation as the category
# preview above; a preset is always a real file (no bundled-only case
# to worry about), so this is the simpler of the two. Always shown in
# F9 itself, not gated behind F3 — see launch_preset()'s own comment.
# ------------------------------------------------------------

if [[ "$1" == "--internal-preview-preset" ]]; then

    preview_preset_name="$2"
    preview_preset_file="$PRESETS_DIR/$preview_preset_name"

    if [[ ! -f "$preview_preset_file" ]]; then
        print -r -- "  Preset not found."
        exit 0
    fi

    preview_preset_commands=()

    while IFS= read -r preview_member; do
        preview_member="${preview_member#"${preview_member%%[![:space:]]*}"}"
        preview_member="${preview_member%"${preview_member##*[![:space:]]}"}"
        [[ -z "$preview_member" ]] && continue
        [[ "$preview_member" == \#* ]] && continue
        preview_preset_commands+=("$preview_member")
    done < "$preview_preset_file"

    if (( ${#preview_preset_commands[@]} == 0 )); then
        print -r -- "  Empty."
        exit 0
    fi

    # File order, not alphabetical — this is also the launch order
    # (top to bottom, left to right in the tmux layout), which is
    # worth showing as-is rather than obscuring it by sorting. Numbered
    # explicitly rather than left implicit: position in the list already
    # implied the order, but only if you counted rows yourself; a
    # number makes it explicit the way
    # Create Preset's own tab-to-add badges already do.
    preview_preset_num=0
    for preview_member in "${preview_preset_commands[@]}"; do
        (( preview_preset_num++ ))
        preview_member_desc="$(awk -F'\t' -v cmd="$preview_member" '$1 == cmd { print $2; exit }' "$CACHE_FILE" 2>/dev/null)"
        if [[ -n "$preview_member_desc" ]]; then
            printf '  %2d. %-20s%s\n' "$preview_preset_num" "$preview_member" "$preview_member_desc"
        else
            printf '  %2d. %s\n' "$preview_preset_num" "$preview_member"
        fi
    done

    exit 0
fi

# ------------------------------------------------------------
# F4 Actions menu's own F3 details pane (internal use only), on by
# default, describing what each row/toggle means.
#
# Actions mixes plain commands (Hide, Create Preset) with settings whose current state is
# already shown in the row itself but whose *effect* isn't obvious
# from a one-line label alone (Default Categories, Sort, Alt
# Keybinds...). Same idiom as --internal-preview-category/-preset: a
# plain CLI subcommand fed the highlighted row's id (field 1 of
# pick_more_action()'s own rows), no fzf/interactivity of its own.
# ------------------------------------------------------------

if [[ "$1" == "--internal-preview-action" ]]; then

    preview_action_id="$2"

    case "$preview_action_id" in
        f6)
            printf 'Hide\n\nHide the highlighted entry from every view except Hidden.\nPress again from Hidden (or F6 there) to bring it back.\nNothing is uninstalled — this only changes what the picker\nshows.\n'
            ;;
        f7)
            printf 'Favorite\n\nAdd or remove the highlighted entry from Favorites — a\ncategory like any other, just pinned first in the view\npicker. Marked with a + in every list.\n'
            ;;
        f8)
            printf 'Categorize\n\nFile the highlighted entry into a category, typed or\npicked from existing ones. Picking a category it is\nalready in removes it instead — same key adds and removes.\nMarked with a # in every list.\n'
            ;;
        theme)
            printf 'Theme\n\nSwitch the color theme used throughout the picker. 10 to\nchoose from here — a custom one of your own is also\npossible, via a CUSTOM_COLORS line in the config file (see\nREADME.md), but isn'"'"'t offered as a row here since there'"'"'s no\nfixed palette to describe.\n'
            ;;
        toggle_default_categories)
            printf 'Default Categories\n\nOn: uncategorized formulae are auto-filed into bundled\ncategories (Reading & Reference, System Info, and so on),\nso the view picker has useful groupings from the start.\nOff: only categories you have filed something into by hand\n(F8) exist — a blank slate. Either way, your own F8 choice\non any one entry always wins over the bundled default.\n'
            ;;
        toggle_default_hidden)
            printf 'Default Hidden\n\nOn: a bundled list of minor/auxiliary commands (support\ntools bundled alongside something else, not meant to be\nlaunched on their own) starts hidden automatically. Off:\nnothing starts hidden unless you hide it yourself with F6.\nAn entry you have explicitly shown or hidden yourself\nalways overrides this.\n'
            ;;
        toggle_open_to_categories)
            printf 'Open to Categories\n\nOn: brew-launcher opens straight to the view picker (F2)\ninstead of All. Off (default): starts on All, the familiar\nfull list. Worth turning on once you actually have\ncategories to jump between.\n'
            ;;
        toggle_sort)
            printf 'Sort\n\nCycles Name ↑ -> Name ↓ -> Size ↑ -> Size ↓. Name ↑ is the\ndefault — alphabetical, same order the cache is already\nwritten in. Size ↓ is largest install first. Doesn'"'"'t affect\nMost Used, Recently Launched, or Recently Added, which\nalready have their own meaningful order.\n\nClicking NAME or SIZE in the main list'"'"'s own header does the\nsame thing directly: picks that column, and clicking it again\nflips the direction — without opening Settings.\n'
            ;;
        toggle_compact_view)
            printf 'Compact View\n\nOff (default): every row shows its version, size, and\n+/#/* markers. On: drops all of that, leaving just the\nname and description. Applies everywhere a row shows up\n— the main list, category/preset pickers, and so on.\n'
            ;;
        toggle_details)
            printf 'Details\n\nShow or hide the F3 preview pane — on the main list and\nthe view picker (F2). Toggling it here makes it a standing\nchoice (it stays on until you turn it off again, here or\nwith F3); pressing F3 directly instead is just a quick\npeek, and Esc there closes it first before doing anything\nelse. The preset picker (F9) has its own details pane that'"'"'s\nalways on, no toggle needed.\n'
            ;;
        toggle_details_position)
            printf 'Details Position\n\nBottom (default): the details/preview pane opens below the\nlist. Top: it opens above instead. Applies everywhere one\nshows up — the main list, F2, F9, and Actions/Settings'"'"'\nown always-on panes — not just wherever you toggle it from.\n'
            ;;
        toggle_alt_keybinds)
            printf 'Alt Keybinds\n\nOn: the footer also lists each action'"'"'s ⌥ (Option)\nalternative, e.g. F2/⌥V, wherever it fits. Off: the footer\nshows plain F-keys only. The F-keys and their direct presses\nalways work regardless of this setting — it only changes\nwhat the footer prints.\n'
            ;;
        refresh)
            printf 'Refresh\n\nRebuild the cache without leaving the launcher — the same\nthing F5 / ⌥R already do directly, everywhere they work\n(including the view picker). This row exists so the action\nstays discoverable without permanently spending a footer\nslot on it.\n'
            ;;
        update_all)
            printf 'Update All\n\nRun brew upgrade for everything outdated, in a real\nterminal so you see its actual output. Asks first — this\ncan take a while. Press F5 afterward to see the new\nversions right away, same as after any other change.\n'
            ;;
        create_preset)
            printf 'Create Preset\n\nBuild a new preset: pick which entries belong in it and\nwhat order they launch in, then name it. Needs tmux.\n'
            ;;
        shortcut)
            printf 'Create Shortcut\n\nCreate a double-clickable launcher for the highlighted\nentry (macOS: an Automator app; Linux: a .desktop file).\n'
            ;;
        launch_flags)
            printf 'Launch Flags\n\nExtra arguments to always pass when launching the\nhighlighted entry. Applies everywhere it launches from,\nincluding presets it'"'"'s part of. Blank clears it.\n'
            ;;
        run_with_args)
            printf 'Run With Args\n\nLaunch the highlighted entry right now with extra\narguments, just this once — nothing is saved. Prefilled\nwith its Launch Flags, if any, as a starting point. Blank\nruns it plain, same as Enter. F3 / ⌥D there previews its\nown --help, on demand.\n'
            ;;
        update_tool)
            printf 'Update\n\nRun brew upgrade for just the highlighted entry, in a\nreal terminal so you see its actual output. No confirm —\nalready up to date just says so and does nothing.\n'
            ;;
        backup)
            printf 'Backup\n\nExport your categories, presets, favorites, hidden entries\nand settings to a single file, for safekeeping or moving to\nanother machine.\n'
            ;;
        *)
            printf 'No description available.\n'
            ;;
    esac

    exit 0
fi

# ------------------------------------------------------------
# Run With Args' own usage preview (internal use only)
#
# Invoked by run_with_args()'s F3/⌥D bind, on demand only — never
# automatically when the prompt opens. The honest risk is
# this install list is full of games and animations (cmatrix,
# asciiquarium, moon-buggy...) that may not recognize --help at all
# and would launch straight into their own full-screen mode instead of
# printing usage and exiting — automatic would mean every one of those
# flashes on screen the moment the prompt opened. On-demand means nothing
# runs unless asked, and a short, portable kill-if-it-doesn't-exit
# safety net (no `timeout`/`gtimeout` on stock macOS, so this is done
# by hand with a background watcher) keeps a hit like that brief.
# ------------------------------------------------------------

if [[ "$1" == "--internal-preview-usage" ]]; then

    usage_path="$2"

    if [[ -z "$usage_path" || ! -x "$usage_path" ]]; then
        printf 'No usage information available.\n'
        exit 0
    fi

    mkdir -p "$CACHE_DIR"
    usage_output_file="$(mktemp "$CACHE_DIR/usage-preview.XXXXXX")"
    "$usage_path" --help > "$usage_output_file" 2>&1 &
    usage_pid=$!

    ( sleep 1; kill -9 "$usage_pid" ) 2>/dev/null &
    watcher_pid=$!

    wait "$usage_pid" 2>/dev/null
    kill "$watcher_pid" 2>/dev/null
    wait "$watcher_pid" 2>/dev/null

    if [[ -s "$usage_output_file" ]]; then
        cat "$usage_output_file"
    else
        printf 'No usage information available.\n'
    fi
    rm -f "$usage_output_file"

    exit 0
fi

# ------------------------------------------------------------
# Create Preset's Tab handler (internal use only)
#
# Invoked by create_preset()'s fzf as a fresh subprocess every time
# Tab is pressed, via a transform bind — same mechanism and the same
# "must feel instant" reason as the click handler above.
#
# fzf's own --multi marking has no concept of *order*, only "is this
# marked" — so instead of --multi, create_preset() keeps its own small
# ordered list on the side (PRESET_ORDER_STATE_FILE, one command per
# line, in the order marked) and this toggles it: already in the list
# → removed (and everything after it renumbers down); not in it yet →
# appended at the end. $2 is the currently-highlighted command ({1}
# from create_preset()'s own --delimiter/--nth setup, inherited via the
# exported PRESET_ORDER_* paths since this runs as a real subprocess,
# not a function call). An empty $2 means "just regenerate, don't
# toggle anything" — used once up front to render the initial
# all-blank list through this same code path rather than duplicating
# the badge format in two places.
#
# Prints a transform result reloading the regenerated list and moving
# the cursor down a row — fzf's own default toggle+down convenience
# for --multi doesn't come along for free once Tab is rebound to a
# custom transform, verified live, so this asks for +down explicitly.
# ------------------------------------------------------------

if [[ "$1" == "--internal-preset-tab" ]]; then

    preset_tab_highlighted="$2"
    preset_tab_order=()
    [[ -s "$PRESET_ORDER_STATE_FILE" ]] && preset_tab_order=("${(@f)$(<"$PRESET_ORDER_STATE_FILE")}")

    if [[ -n "$preset_tab_highlighted" ]]; then

        preset_tab_new_order=()
        preset_tab_found=false

        for preset_tab_o in "${preset_tab_order[@]}"; do
            [[ -z "$preset_tab_o" ]] && continue
            if [[ "$preset_tab_o" == "$preset_tab_highlighted" ]]; then
                preset_tab_found=true
                continue
            fi
            preset_tab_new_order+=("$preset_tab_o")
        done

        [[ "$preset_tab_found" == false ]] && preset_tab_new_order+=("$preset_tab_highlighted")
        preset_tab_order=("${preset_tab_new_order[@]}")

        printf '%s\n' "${preset_tab_order[@]}" > "$PRESET_ORDER_STATE_FILE"
    fi

    : > "${PRESET_ORDER_LIST_FILE}.new"

    while IFS=$'\t' read -r preset_tab_cmd preset_tab_rest; do
        [[ -z "$preset_tab_cmd" ]] && continue

        preset_tab_badge="   "
        preset_tab_idx=0
        preset_tab_found_idx=0

        for preset_tab_o in "${preset_tab_order[@]}"; do
            preset_tab_idx=$(( preset_tab_idx + 1 ))
            if [[ "$preset_tab_o" == "$preset_tab_cmd" ]]; then
                preset_tab_found_idx=$preset_tab_idx
                break
            fi
        done

        (( preset_tab_found_idx > 0 )) && preset_tab_badge="$(printf '%2d ' "$preset_tab_found_idx")"

        printf '%s\t%s%s\n' "$preset_tab_cmd" "$preset_tab_badge" "$preset_tab_rest" >> "${PRESET_ORDER_LIST_FILE}.new"

    done < "$PRESET_ORDER_BASE_FILE"

    mv "${PRESET_ORDER_LIST_FILE}.new" "$PRESET_ORDER_LIST_FILE"

    [[ -n "$preset_tab_highlighted" ]] && printf 'reload(cat %q)+down' "$PRESET_ORDER_LIST_FILE"

    exit 0
fi

# Reached only by the launcher itself — the click handler above exits
# before this line, which matters: if the handler installed this trap
# too, it would delete the click file it just wrote on its own exit.
trap 'rm -f "$FOOTER_CLICK_FILE" "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"' EXIT

FORCE_REFRESH=false
LIST_MODE=false
PRESET_MODE=false
PRESET_NAME=""

if [[ "$1" == "--refresh" || "$1" == "-r" ]]; then
    FORCE_REFRESH=true
elif [[ "$1" == "--list" || "$1" == "-l" ]]; then
    LIST_MODE=true
elif [[ "$1" == "--preset" ]]; then
    if [[ -z "$2" ]]; then
        echo "Error: --preset requires a name."
        echo "Run 'brew-launcher --help' for usage."
        exit 1
    fi
    PRESET_MODE=true
    PRESET_NAME="$2"
elif [[ -n "$1" ]]; then
    echo "Error: unrecognized argument '$1'."
    echo "Run 'brew-launcher --help' for usage."
    exit 1
fi

# ------------------------------------------------------------
# Requirements
# ------------------------------------------------------------

for dependency in brew fzf python3; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        echo "Error: '$dependency' is required."
        exit 1
    fi
done

# ------------------------------------------------------------
# Shows a preset's tmux session to the user — the one place that
# decides *how*, since a preset with several TUIs at once deserves its
# own window rather than always replacing whatever's already on
# screen. Launching a preset used to always exec away
# outright, so the picker was gone, not just backgrounded — surprising
# and avoidable whenever a real GUI is actually available to open a
# genuinely separate window in instead.
#
# Three outcomes, tried in order — every one of them, once the tmux
# side of things ends (you detach, or the preset session itself is
# killed), falls through to relaunching the launcher rather than
# leaving a dead pane or a bare shell behind, extending the
# launch-a-tool version of this same fix to presets too.
#
# Verified live with a real attached client that this genuinely
# mattered for (2) below, not just a nice-to-have: switch-client's own
# process exits the instant it's done its job (near-instantly,
# regardless of success), and a pane whose foreground process exits is
# closed by tmux *by default* — so the picker's original pane, and if
# it was the only one, its whole session, was actually being destroyed
# the moment switch-client succeeded. An earlier version of this
# comment claimed that session survived in the background, switchable
# back to with prefix+s — that was wrong, caught only by testing with
# a real attached client rather than trusting the reasoning.
#
# The relaunch is chained with && below, not ;, on purpose — caught by
# the test suite hanging, not reasoning: with no real terminal to
# attach to (exactly what --preset looks like in a test/CI run, or any
# non-interactive invocation), attach-session/switch-client fails
# immediately, and a bare `;` would still run the relaunch straight
# into a brand new fzf session with that same broken stdin, hanging
# instead of failing fast the way the surrounding code (and its own
# tests) already expect. && only relaunches after a *successful*
# attach that later ended cleanly — a real failure still fails
# straight through, same as before this whole feature existed.
#
#   1. A local Mac with Ghostty, not over SSH — opens a brand new
#      Ghostty WINDOW (never a tab, unlike single-tool launches: a
#      multi-pane preset earns its own window, not a corner of
#      whatever's already open) attached to the session, and returns
#      normally. Nothing here touches the calling process, so the
#      picker keeps running exactly as it was — detaching later just
#      relaunches the picker in that same window.
#
#   2. Already inside tmux (true over SSH too, once brew-launcher
#      itself is run inside a tmux session — see the README) —
#      switch-client, then relaunch the picker in this same pane once
#      it returns. Detaching later (or the preset ending) switches you
#      back to this window, which is by then already sitting there
#      with a fresh picker ready — the relaunch happens in the
#      background the moment you switch away, not when you come back.
#
#   3. Neither — same idea via attach-session instead of switch-client,
#      since there's no separate session to switch within. Detaching
#      relaunches the picker right here, in the same window, rather
#      than genuinely taking it over as it used to.
# ------------------------------------------------------------

preset_show_session() {

    local session="$1"

    if ! is_ssh_session &&
       [[ "$(uname -s)" == "Darwin" ]] &&
       command -v osascript >/dev/null 2>&1 &&
       [[ -d "/Applications/Ghostty.app" ]]; then

        # Checked, not assumed: this can genuinely fail (confirmed
        # live — Ghostty's own AppleScript bridge can refuse to hand
        # back "focused terminal" for a window it just created, in a
        # context without real window-server focus available). Success
        # is treated as "handled, nothing more to do"; failure falls
        # through to the tmux paths below instead of silently
        # returning as if it had worked — a swallowed failure here
        # would look exactly like the original "nothing happened" bug
        # this whole thing exists to fix.
        if osascript - "$session" "$SCRIPT_PATH" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
    set sessionName to item 1 of argv
    set launcherPath to item 2 of argv
    tell application "Ghostty"
        activate
        set newWindow to new window
        set newTerminal to focused terminal of newWindow
        input text ("exec zsh -c 'tmux attach-session -t \"$1\" && exec \"$2\"' -- " & quoted form of sessionName & " " & quoted form of launcherPath) to newTerminal
        send key "enter" to newTerminal
    end tell
end run
APPLESCRIPT
        then
            return 0
        fi

        printf '\n'
        printf 'Could not open a new Ghostty window — falling back.\n'
        sleep 1
    fi

    if [[ -n "$TMUX" ]]; then
        exec zsh -c 'tmux switch-client -t "$1" && exec "$2"' -- "$session" "$SCRIPT_PATH"
    fi

    printf '\n'
    printf 'Not running inside tmux — this preset will take over this window\n'
    printf 'until you detach (prefix+d) or the preset ends, then the launcher\n'
    printf 'comes back here on its own.\n'
    sleep 2

    exec zsh -c 'tmux attach-session -t "$1" && exec "$2"' -- "$session" "$SCRIPT_PATH"
}

# See LAUNCH_FLAGS_FILE's own comment above. Defined and loaded here,
# well before the ordinary interactive-picker setup further down —
# run_preset() below needs it (and resolve_launch_path() right after
# it), and the top-level --preset <name> CLI flag calls run_preset()
# and exits before ever reaching that later setup. Same reasoning
# is_ssh_session() above gives for its own early placement: zsh
# doesn't hoist function definitions, so anything reachable from an
# early top-level call must already be defined by that point, not
# just eventually defined somewhere in the file.
typeset -A launch_flags

load_launch_flags() {

    launch_flags=()

    [[ -f "$LAUNCH_FLAGS_FILE" ]] || return

    local lf_command lf_flags

    while IFS=$'\t' read -r lf_command lf_flags; do
        [[ -z "$lf_command" ]] && continue
        launch_flags[$lf_command]="$lf_flags"
    done < "$LAUNCH_FLAGS_FILE"
}

load_launch_flags

# ------------------------------------------------------------
# Turns a resolved binary path into whatever should actually be
# launched — itself, unchanged, if $command has no custom launch flags
# configured (the overwhelming common case), or a throwaway
# self-deleting wrapper script that runs it with those flags if it
# does. See LAUNCH_FLAGS_FILE's own comment for why this is one shared
# lookup rather than two separate features.
#
# Same self-deleting-wrapper idiom as update_all(), and for the same
# reason: launch_in_current_terminal/tmux/ghostty (and run_preset()'s
# own tmux pane command, right below) are all built around "one
# already-resolved binary, no arguments" — generalizing four call
# sites to accept an argument list wasn't worth touching that much
# carefully-tuned, security-reviewed code for one feature. Every
# launch site funnels its resolved path through this first instead, so
# Launch Flags apply wherever a command is actually launched — the
# main list's own Enter, and every preset pane — from one config, not
# two.
#
# The flags string is written into the wrapper as plain, unquoted
# shell text on purpose: this is a value the user typed specifically
# to control how a command launches (the same trust level as their own
# shell aliases), not untrusted data from a formula description or a
# network response, so it's meant to be interpreted with full shell
# syntax (quoting, "=", etc.) rather than treated as an opaque string.
# ------------------------------------------------------------

resolve_launch_path() {

    local command="$1" resolved_path="$2"
    local flags="${launch_flags[$command]-}"

    if [[ -z "$flags" ]]; then
        printf '%s' "$resolved_path"
        return 0
    fi

    local wrapper
    wrapper="$(mktemp "$CACHE_DIR/launch-flags-run.XXXXXX")" || {
        printf '%s' "$resolved_path"
        return 0
    }

    cat > "$wrapper" <<EOF
#!/bin/zsh
${(q)resolved_path} $flags
rm -f -- "\$0"
EOF

    chmod +x "$wrapper"

    printf '%s' "$wrapper"
}

# ------------------------------------------------------------
# Launch a preset by name — read its command list and start (or
# reattach to) one tmux session with a pane per command.
#
# Shared by both ways to reach a preset: the top-level --preset <name>
# CLI flag below, and the in-app F9 / Launch Preset action further
# down — one implementation of "what launching a preset actually
# does" instead of two. Ends one of three ways, via preset_show_session()
# above: a new window opened and a normal return (0), an exec that
# never returns, or a real failure explained on screen and returned as
# 1 — the CLI entry point below turns the latter into a real exit
# itself; the in-app action instead falls back to the picker, the same
# way a failed single-tool launch already does.
# ------------------------------------------------------------

run_preset() {

    local name="$1"
    local preset_file="$PRESETS_DIR/$name"
    local -a preset_commands=()
    local -a preset_warnings=()
    local preset_line preset_session preset_cmd preset_resolved
    local preset_started=false preset_running_count preset_no_room_count=0
    local preset_hash preset_stored_hash

    if ! command -v tmux >/dev/null 2>&1; then
        printf '\n'
        printf 'Error: tmux is required to use presets.\n'
        sleep 2
        return 1
    fi

    if [[ ! -f "$preset_file" ]]; then
        printf '\n'
        printf 'Error: preset "%s" not found.\n' "$name"
        printf 'Expected a file at %s — one command per line.\n' "$preset_file"
        sleep 2
        return 1
    fi

    while IFS= read -r preset_line; do

        preset_line="${preset_line#"${preset_line%%[![:space:]]*}"}"
        preset_line="${preset_line%"${preset_line##*[![:space:]]}"}"

        [[ -z "$preset_line" ]] && continue
        [[ "$preset_line" == \#* ]] && continue

        preset_commands+=("$preset_line")

    done < "$preset_file"

    if (( ${#preset_commands[@]} == 0 )); then
        printf '\n'
        printf 'Error: preset "%s" has no commands in it.\n' "$name"
        printf 'Add one command per line to %s\n' "$preset_file"
        sleep 2
        return 1
    fi

    # Namespaced session name so this can't collide with an unrelated
    # tmux session you already happen to have running under the same
    # plain name. Re-running the same preset while its session is
    # still alive reattaches (or, from inside another tmux session,
    # switches the client) instead of spawning a duplicate — the same
    # check a person would run by hand with `tmux has-session`.
    preset_session="blpreset-$name"

    # Fingerprint of the command list, stashed on the session itself so
    # a later run can tell whether the preset was edited since this
    # session was built. Without this, editing a preset (say, from 4
    # tools down to 3 via Create Preset's "replace it") while its old
    # session was still running would just reattach to that stale
    # session unchanged — still 4 panes, not the 3 the file says now.
    # cksum, not a real hash: this only needs to detect "did the list
    # change", not resist tampering, and it ships on macOS and Linux
    # already, no new dependency.
    preset_hash="$(printf '%s\n' "${preset_commands[@]}" | cksum)"

    if tmux has-session -t "$preset_session" 2>/dev/null; then

        preset_stored_hash="$(tmux show-environment -t "$preset_session" BL_PRESET_HASH 2>/dev/null)"
        preset_stored_hash="${preset_stored_hash#BL_PRESET_HASH=}"

        if [[ "$preset_stored_hash" == "$preset_hash" ]]; then
            preset_show_session "$preset_session"
            return 0
        fi

        # Command list no longer matches (or this session predates the
        # fingerprint) — rebuild fresh below instead of reattaching to
        # a pane count that no longer matches the file.
        tmux kill-session -t "$preset_session" 2>/dev/null
    fi

    # First live command becomes the session's initial pane; every one
    # after that splits a new pane into the same window. Not resolved
    # through the picker's cache — a preset can run before any picker
    # session has ever built one, so this does its own plain
    # `command -v` lookup per line instead of depending on that being
    # warm. A command not found on PATH is skipped with a warning
    # rather than aborting the whole preset over one bad line.
    for preset_cmd in "${preset_commands[@]}"; do

        preset_resolved="$(command -v "$preset_cmd" 2>/dev/null)"

        # Same Launch Flags lookup the main list's own Enter-launch
        # goes through (see resolve_launch_path()'s own comment) — one
        # config answers both "run a TUI with specific flags" and "run
        # a preset member with specific flags", since a preset launches
        # the exact same commands by name.
        [[ -n "$preset_resolved" ]] &&
            preset_resolved="$(resolve_launch_path "$preset_cmd" "$preset_resolved")"

        if [[ -z "$preset_resolved" ]]; then
            # Collected rather than printed here — printing immediately
            # would just get overwritten the instant this function execs
            # into tmux a few lines down, on a preset with any working
            # commands left. Skipping a tool silently can look exactly
            # like nothing happened: with only one tool left after a
            # skip, the single resulting pane is a plain shell prompt
            # with no visible sign anything launched at all.
            preset_warnings+=("Warning: \"$preset_cmd\" not found on PATH, skipping.")
            continue
        fi

        # Same one-shot-CLI fix as the interactive launch paths: run
        # the command, then fall through to a fresh interactive shell
        # in the pane, rather than exec-ing straight into it. The
        # printf in between exits alternate-screen mode and shows the
        # cursor — a no-op if the tool already cleaned up, a real fix
        # if it crashed or got killed mid-TUI and left the pane stuck
        # thinking it's still in alternate-screen mode (confirmed live
        # via tmux's own #{alternate_on}) — see launch_in_current_terminal
        # for the same fix and fuller explanation.
        if [[ "$preset_started" == false ]]; then
            tmux new-session -d -s "$preset_session" -n "$name" \
                "exec zsh -c '\"\$1\"; printf \"\033[?1049l\033[?25h\" 2>/dev/null; exec zsh' -- ${(q)preset_resolved}"
            preset_started=true
        else
            if ! tmux split-window -t "$preset_session" \
                "exec zsh -c '\"\$1\"; printf \"\033[?1049l\033[?25h\" 2>/dev/null; exec zsh' -- ${(q)preset_resolved}" 2>/dev/null; then

                # Real, reproducible failure mode found live: tmux's
                # default split just keeps halving whichever pane it's
                # given, not filling the window grid-aware, so a plain
                # 80x24 terminal ran out of room after only 4 panes —
                # the 5th and 6th split silently failed ("no space for
                # a new pane") and those tools were dropped with no
                # sign anything had gone wrong. Retiling after every
                # split below prevents this in all but genuinely
                # oversized presets; this still catches the true floor
                # (a terminal too small, or a preset with dozens of
                # tools, easy to end up with now that Create Preset can
                # mark that many in one go) and reports it instead of
                # failing silently. Counted rather than one warning
                # line per tool — hitting this at all usually means
                # hitting it many times in a row, and a wall of
                # identical lines is its own readability problem.
                preset_no_room_count=$(( preset_no_room_count + 1 ))
                continue
            fi
        fi

        # Reflow into a grid after every pane, not just once at the end
        # — keeps each split working with the most space tmux can give
        # it, which is what actually avoids the failure above rather
        # than just detecting it after the fact. tiled from 3 panes up;
        # exactly 2 gets even-horizontal instead, since tiled picks a
        # grid based on the terminal's character-cell shape rather than
        # its pixel aspect ratio — cells are taller than they are wide,
        # so tiled stacks a pair top/bottom even on a wide monitor
        # (confirmed directly: two 200-column panes at 200x24 and
        # 200x25, one above the other) — even-horizontal's side-by-side
        # split is the better default at exactly 2.
        preset_running_count="$(tmux list-panes -t "$preset_session" 2>/dev/null | wc -l)"

        if (( preset_running_count == 2 )); then
            tmux select-layout -t "$preset_session" even-horizontal 2>/dev/null
        elif (( preset_running_count > 2 )); then
            tmux select-layout -t "$preset_session" tiled 2>/dev/null
        fi

    done

    if (( preset_no_room_count == 1 )); then
        preset_warnings+=("Warning: no room for 1 tool — terminal too small for this many panes, skipping it.")
    elif (( preset_no_room_count > 1 )); then
        preset_warnings+=("Warning: no room for $preset_no_room_count tools — terminal too small for this many panes, skipping them.")
    fi

    if [[ "$preset_started" == false ]]; then
        printf '\n'
        printf 'Error: none of the commands in preset "%s" were found on PATH.\n' "$name"
        sleep 2
        return 1
    fi

    # Session-scoped, not global (-g) — this turns mouse support on for
    # just this preset's panes (click to switch focus, drag a border to
    # resize) without silently changing mouse behavior in the rest of
    # your tmux, if you use it for other things and have it off there.
    tmux set-option -t "$preset_session" mouse on

    # Same reasoning, same scoping: a preset session is otherwise
    # visually identical to a plain shell whenever it only ends up with
    # one pane (a skipped tool, or a one-tool preset) — it can look
    # exactly like nothing launched at all, when it actually had; there
    # was just nothing on screen saying otherwise. Forcing the status
    # bar on guarantees the session name is always visible, regardless
    # of what your own tmux config does elsewhere.
    tmux set-option -t "$preset_session" status on

    # Stashed so the next run of this same preset can tell whether the
    # command list changed since — see the fingerprint comment above.
    tmux set-environment -t "$preset_session" BL_PRESET_HASH "$preset_hash"

    # Printed and paused on now, rather than at the point each one was
    # found — see the comment above where these are collected. This is
    # the last moment before preset_show_session() below hands off to
    # tmux (or a whole separate window), so it's the only point a
    # warning is actually readable either way.
    if (( ${#preset_warnings[@]} > 0 )); then
        printf '\n'
        printf '%s\n' "${preset_warnings[@]}"
        sleep 2
    fi

    preset_show_session "$preset_session"
    return 0
}

# ------------------------------------------------------------
# --preset <name> — exit early, before any of the terminal/theme/
# cache machinery below, since it needs none of it.
#
# Explicitly exits on both outcomes now, not just failure — since
# preset_show_session() can open a new window and return normally
# (success), falling through here would otherwise start the ordinary
# interactive picker right after, which --preset was never asking for.
# ------------------------------------------------------------

if [[ "$PRESET_MODE" == true ]]; then
    run_preset "$PRESET_NAME"
    exit $?
fi

# ------------------------------------------------------------
# Terminal configuration
# ------------------------------------------------------------

TERMINAL="${BREW_LAUNCHER_TERMINAL:-${CONFIG_TERMINAL:-auto}}"

case "$TERMINAL" in
    auto|current|ghostty|tmux)
        ;;
    *)
        echo "Error: unsupported terminal '$TERMINAL'."
        echo "Supported values: auto, current, ghostty, tmux."
        exit 1
        ;;
esac

# is_ssh_session() and resolve_auto_terminal() are defined up near the
# top of the file (before Help/version), not here next to their call
# site — --diagnose needs to call resolve_auto_terminal() from a
# dispatch block that runs well before this point, and zsh has no
# function hoisting.
[[ "$TERMINAL" == "auto" ]] && TERMINAL="$(resolve_auto_terminal)"

if [[ "$TERMINAL" == "ghostty" ]] &&
   ! command -v osascript >/dev/null 2>&1; then
    echo "Error: osascript is required when using Ghostty."
    exit 1
fi

# "auto" otherwise never chooses tmux just because it happens to be
# installed — it would be a genuinely surprising thing for "auto" to
# do to someone: wrapping their launcher (or worse, silently changing
# behavior) based on an incidental machine fact, whether or not they
# use tmux day to day, is exactly the kind of behavior-that-differs-
# by-what's-on-your-machine this project has otherwise avoided
# throughout. The SSH case above is a different signal, not an
# exception to this: $TMUX being set there means the user already,
# deliberately, ran `tmux` themselves before this launcher — detecting
# a session someone is already sitting in isn't the same as starting
# one on their behalf just because the binary exists.
if [[ "$TERMINAL" == "tmux" ]] &&
   ! command -v tmux >/dev/null 2>&1; then
    echo "Error: tmux is required when using BREW_LAUNCHER_TERMINAL=tmux."
    exit 1
fi

# Computed once so every screen that offers a preset-related action can
# just check this instead of shelling out to `command -v tmux` again.
# Presets always need tmux regardless of $TERMINAL, so this is a
# separate check from the one just above (which only fires for the
# tmux terminal backend specifically). Same reasoning as Create
# Shortcut already being hidden on unsupported platforms rather than
# offered and then failing: an action that can only ever error isn't
# offered in the first place.
if command -v tmux >/dev/null 2>&1; then
    TMUX_AVAILABLE=true
else
    TMUX_AVAILABLE=false
fi

# ------------------------------------------------------------
# fzf colors
#
# THEME_NAME resolves the same way TERMINAL does: an env var for one
# run, then the config file's persisted choice, then a hardcoded
# default. Unlike TERMINAL, there's no "auto" — a theme is either
# picked or it's the default, there's nothing to detect.
#
# Five of these are the ones actually popular right now, not a guess:
# Catppuccin (the existing default), Gruvbox, Tokyo Night, Nord and
# Dracula, checked against real terminal/editor-theme popularity data
# rather than picked from memory. Hex values are each theme's own
# published palette, not approximated.
#
# Green and Amber are real too, just older — the actual hex values
# cathode-ray green- and amber-phosphor terminals displayed (verified,
# not guessed at). Monochrome on purpose: that hardware could only
# show one hue at varying brightness, so unlike the five above these
# never reach for an off-hue accent color.
#
# Solarized Dark/Light use Ethan Schoonover's own published hex
# values (ethanschoonover.com/solarized) — the same 16-color palette
# and accent set (blue/red/green/orange) in both, only the base tones
# swap which end is background vs foreground, exactly as the original
# spec does. Added because every theme above leans blue/purple with
# no full warm range and no light background option — Solarized's
# whole design is a curated spread across the color wheel, and it's
# one of the only well-known palettes that ships an official light
# variant sharing the same accents as its dark one.
#
# Red Sands rounds it out with a genuinely red theme rather than a
# theme that merely uses red as one accent among several — see its
# own case block below for detail. 10 total.
#
# THEME=custom is the 11th value this case accepts, but it's config-
# file-only on purpose — not in pick_theme()'s own list, so it never
# shows up as a scrollable row, and count math like
# theme_position_label() correctly treats it as not one of the named
# 10. It reads its actual colors from a separate CUSTOM_COLORS= config
# line instead of a hardcoded palette here, in the same comma-
# separated fzf --color format shown in each case above (a copy-paste
# template of catppuccin's own string is in the README). Fails fast,
# same convention as an unrecognized theme name below, if THEME=custom
# is set but CUSTOM_COLORS is empty — there's no sensible default to
# silently fall back to for a palette that's supposed to be yours.
# ------------------------------------------------------------

THEME_NAME="${BREW_LAUNCHER_THEME:-${CONFIG_THEME:-catppuccin}}"

# Resolved the same way as THEME_NAME above, minus an env var — this
# is a plain Actions-menu toggle (see the three under "Bundled
# defaults"), not something with enough variety to justify its own
# BREW_LAUNCHER_* knob. "name" (the cache's own alphabetical order,
# free) or "size" (raw bytes, largest first — see size_sort_key()).
# Doesn't touch Most Used, Recently Launched, or Recently Added, which
# already have their own meaningful order regardless of this setting.
SORT_ORDER="${CONFIG_SORT:-name}"

# Same idea as SORT_ORDER above — "bottom" (the pane sits below the
# list, fzf's "down" position) is the long-standing default; "top"
# flips it above. Read by details_preview_window() below, wherever a screen
# builds its own --preview-window value.
DETAILS_POSITION="${CONFIG_DETAILS_POSITION:-bottom}"

# Opt-in (default off, same reasoning as OPEN_TO_CATEGORIES above).
# Controls the main list's own VERSION/SIZE columns specifically:
# off (default)
# shows everything build_entries() already computes; on drops those
# two columns, leaving just the marker, name, and description. Read
# by build_entries() and the column-header build further down, the
# only two places that lay out a row's columns.
COMPACT_VIEW="${CONFIG_COMPACT_VIEW:-off}"

case "$THEME_NAME" in
    catppuccin)
        FZF_COLORS='
fg:#cdd6f4,
bg:#1e1e2e,
fg+:#f5e0e6,
bg+:#313244,
hl:#89b4fa,
hl+:#89b4fa,
info:#a6adc8,
prompt:#89b4fa,
pointer:#f38ba8,
marker:#a6e3a1,
spinner:#f5c2e7,
header:#a6adc8,
border:#45475a,
label:#89b4fa,
query:#f5e0e6
'
        ;;
    gruvbox)
        FZF_COLORS='
fg:#ebdbb2,
bg:#282828,
fg+:#ebdbb2,
bg+:#3c3836,
hl:#83a598,
hl+:#83a598,
info:#928374,
prompt:#83a598,
pointer:#fb4934,
marker:#b8bb26,
spinner:#fe8019,
header:#928374,
border:#504945,
