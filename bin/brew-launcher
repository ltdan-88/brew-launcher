query:#ebdbb2
'
        ;;
    tokyonight)
        FZF_COLORS='
fg:#c0caf5,
bg:#24283b,
fg+:#c0caf5,
bg+:#292e42,
hl:#7aa2f7,
hl+:#7aa2f7,
