# Builds the --preview-window value shared by every screen with a
# details/preview pane, honoring DETAILS_POSITION (top = fzf's "up",
# bottom/default = "down"). The single border stays on the side facing the
# list either way (border-top when the pane is below it, border-bottom
# when it's above), so the divider is always between the two panes
# rather than at the outer screen edge. $1, when passed, is the same
# DETAILS_VISIBLE-style flag the main list and F2 already condition
# their preview on; omitted (or true) for the three screens whose pane
# is always on (Actions, Settings, F9) and has no such toggle.
details_preview_window() {

    local visible="${1:-true}"
    local pos='down' border='border-top'

    if [[ "$DETAILS_POSITION" == top ]]; then
        pos='up'
        border='border-bottom'
    fi

    local out="${pos},35%,${border},wrap"
    [[ "$visible" == false ]] && out+=",hidden"

    printf '%s' "$out"
}

pick_more_action() {

    local hide_label="$1"
    # Entry-scoped rows (Hide/Favorite/Categorize/Create Shortcut all
    # act on whatever row was highlighted) only make sense when there
    # is a highlighted row to act on — false when Actions is reached
    # from a screen with no entry of its own, like the view picker.
    # Defaults true so every existing call site (all from the main
    # list) is unaffected without having to pass it explicitly.
    local has_entry="${2:-true}"
    # Named in the border label below when present — a real point of
    # confusion for anyone used to a GUI right-click
    # menu: "Actions" alone doesn't say *which* row it's about to act
    # on, unlike a context menu that opens already anchored to
    # whatever you clicked. Empty when has_entry is false (nothing to
    # name), or for a caller that hasn't been updated to pass it.
    local entry_name="${3:-}"
    # The formula behind entry_name, when they differ (e.g.
    # midnight-commander -> mc) — needed to key outdated_formulas[]
    # below, which is keyed by formula, not command. See this
    # function's own call sites for where it comes from.
    local entry_formula="${4:-}"
    local -a rows=()
    local result chosen clicked_word more_label='Actions'

    # has_entry is false only when Actions is opened from the view
    # picker (F2) — see this param's own comment. Everything in this
    # block needs $entries to actually mean something (a real,
    # currently-displayed list of tools), which the view picker has no
    # equivalent of — it lists categories, not tools, so Hide/Favorite/
    # Categorize Multiple would show 0 entries and be unusable there.
    # Create Preset moved in here too, for
    # the same reason — see its own comment for why it no longer forces
    # CURRENT_VIEW to "All" regardless of context.
    if [[ "$has_entry" == true ]]; then
        rows+=("f6"$'\t'"$(printf '%-20s%s' "$hide_label" 'F6 / ⌥H')")
        rows+=("f7"$'\t'"$(printf '%-20s%s' 'Favorite' 'F7 / ⌥F')")
        rows+=("f8"$'\t'"$(printf '%-20s%s' 'Categorize' 'F8 / ⌥C')")

        # Bulk counterparts of the three above, bringing the same
        # Tab-to-mark idea Create Preset uses to these three actions.
        # Each opens its own
        # mark-then-act picker (see pick_multiple_entries()) over
        # $entries rather than acting on the highlighted row directly.
        # Grouped right under their single-entry counterpart rather
        # than off with Create Preset/Create Shortcut below, since
        # they're the same action, just batched. Relabel to their
        # inverse while viewing Hidden/Favorites, same idea as F6's
        # own hide_label — every entry on screen there is already
        # hidden/favorited, so acting on a marked batch removes rather
        # than adds. Categorize doesn't relabel: F8's own single-key
        # row doesn't either, even though it's instant-remove in the
        # exact same situation.
        local bulk_hide_label='Hide Multiple'
        [[ "$CURRENT_VIEW" == "Hidden" ]] && bulk_hide_label='Unhide Multiple'
        rows+=("bulk_hide"$'\t'"$(printf '%-20s%s' "$bulk_hide_label" '')")

        local bulk_favorite_label='Favorite Multiple'
        [[ "$CURRENT_VIEW" == "Favorites" ]] && bulk_favorite_label='Unfavorite Multiple'
        rows+=("bulk_favorite"$'\t'"$(printf '%-20s%s' "$bulk_favorite_label" '')")

        rows+=("bulk_categorize"$'\t'"$(printf '%-20s%s' 'Categorize Multiple' '')")

        local create_preset_hint=''
        [[ "$TMUX_AVAILABLE" == false ]] && create_preset_hint='needs tmux'
        rows+=("create_preset"$'\t'"$(printf '%-20s%s' 'Create Preset' "$create_preset_hint")")

        # Create Shortcut is entry-scoped too (a shortcut is made *for*
        # the highlighted row) and macOS/Linux-only, so it isn't
        # offered elsewhere rather than being offered and apologising.
        if [[ "$(uname -s)" == "Darwin" || "$(uname -s)" == "Linux" ]]; then
            rows+=("shortcut"$'\t'"$(printf '%-20s%s' 'Create Shortcut' '')")
        fi

        # Extra arguments to always pass this command — entry-scoped
        # too, same reasoning as Create
        # Shortcut above. $entry_name is the real command (see this
        # function's own call sites), the same key LAUNCH_FLAGS_FILE
        # and launch_flags[] use throughout. The hint shows the current
        # flags, if any, so it's visible without opening the prompt.
        local launch_flags_hint="${launch_flags[$entry_name]-}"
        rows+=("launch_flags"$'\t'"$(printf '%-20s%s' 'Launch Flags' "$launch_flags_hint")")

        # A one-off
        # sibling of Launch Flags right above it, not a variant — see
        # run_with_args()'s own comment for why they're kept separate.
        rows+=("run_with_args"$'\t'"$(printf '%-20s%s' 'Run With Args' '')")

        # Update — Actions -> Update All's own per-entry sibling. Hint
        # shows the new version when one's actually available, same
        # style as Launch Flags showing its own current value; blank
        # otherwise. Shown regardless of outdated status, same as
        # every other row here — update_tool() itself explains when
        # there's nothing to do, rather than the row disappearing.
        local update_hint=''
        [[ -n "${outdated_formulas[$entry_formula]-}" ]] &&
            update_hint="(${outdated_formulas[$entry_formula]})"
        rows+=("update_tool"$'\t'"$(printf '%-20s%s' 'Update' "$update_hint")")
    fi

    # Refresh, not gated on has_entry — rebuilding the cache doesn't
    # depend on there being a highlighted row or even a real list on
    # screen, so it works the same from here and from the view picker.
    # Moved out of the main footer itself. F5/⌥R still
    # work as a direct keypress everywhere they always did (same as
    # F6/F7/F8, which are also listed here despite having their own
    # key); this row exists so the action stays discoverable without
    # permanently spending a footer slot on something reached for only
    # occasionally.
    rows+=("refresh"$'\t'"$(printf '%-20s%s' 'Refresh' 'F5 / ⌥R')")

    # Not gated on has_entry, same reasoning as Refresh right above.
    # The count in parens is the same outdated_formulas
    # data the * marker and F3 details pane already read, so it's
    # never a second source of truth about what's actually outdated.
    local update_all_hint=''
    (( ${#outdated_formulas} > 0 )) && update_all_hint="(${#outdated_formulas})"
    rows+=("update_all"$'\t'"$(printf '%-20s%s' 'Update All' "$update_all_hint")")

    # Everything settings-related now lives one level down, in its own
    # screen, so Actions doesn't mix actual actions and standing
    # preferences together. This row is the only settings-shaped
    # thing left here; Theme, the bundled-defaults toggles, Open to
    # Categories, Sort, Details, and Alt Keybinds all moved into
    # pick_settings_action()/open_settings_menu(). No F-key of its own
    # — every F1-F9 is already spoken for, and settings as a whole are
    # reached for far less often than Hide/Favorite/Categorize above.
    rows+=("settings"$'\t'"$(printf '%-20s%s' 'Settings' '(9)')")

    # Last, not part of anything above — this isn't "organize a row" or
    # "adjust a setting," it's "export everything," which reads more
    # like a closing action than a peer of either group. Not gated on
    # has_entry: nothing about it concerns one row.
    rows+=("backup"$'\t'"$(printf '%-20s%s' 'Backup' '')")

    [[ "$has_entry" == true && -n "$entry_name" ]] && more_label="Actions on $entry_name"

    rm -f "$FOOTER_CLICK_FILE"

    # Details pane, always on by default, describing what each toggle
    # means. Unlike DETAILS_VISIBLE elsewhere (a shared
    # on/off the user controls, off by default), there's nothing here
    # for a user to have deliberately hidden yet, and the whole point
    # is explaining rows whose one-line label doesn't say what they
    # actually do — so it just always shows, no toggle to remember.
    result="$(
        printf '%s\n' "${rows[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label "$more_label")" \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --delimiter=$'\t' \
            --with-nth=2 \
            --preview "${(q)SCRIPT_PATH} --internal-preview-action {1}" \
            --preview-window="$(details_preview_window)" \
            --footer='  ↑ ↓  Navigate    Type  Search    Enter/Space  [Choose]    Esc  [Back]' \
            --bind 'space:accept' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$result" ]] && return 1

    printf '%s' "${result%%$'\t'*}"
}

# ------------------------------------------------------------
# Runs the Actions menu to completion — loops on pick_more_action() so
# Create Preset, Settings, and Backup (none of which need a highlighted
# row) run or open in place and reopen Actions right after, rather than
# dropping back to whatever screen called this. Reused from both the
# main list (with an entry) and the view picker (without one), so this
# behavior can't drift apart between the two.
#
# Returns 1 if Esc was pressed with nothing left to do — the caller
# just redraws whatever it was already showing. Returns 2 only when
# has_entry is true and one of the entry-scoped rows (Hide/Favorite/
# Categorize/Create Shortcut/Launch Flags/Run With Args/Update) was
# picked; MORE_MENU_FALLTHROUGH_ACTION
# holds which one, since only the caller has the entry context (the
# selected command/formula) needed to actually run it. With
# has_entry=false those rows are never offered in the first place, so
# this case can't happen — callers without an entry never need to
# check for it.
# ------------------------------------------------------------

MORE_MENU_FALLTHROUGH_ACTION=""

open_more_menu() {

    local hide_label="$1" has_entry="$2" entry_name="$3" entry_formula="${4:-}"
    local chosen_action

    while true; do

        chosen_action="$(pick_more_action "$hide_label" "$has_entry" "$entry_name" "$entry_formula")"

        [[ -z "$chosen_action" ]] && return 1

        case "$chosen_action" in
            bulk_hide)
                bulk_hide
                continue
                ;;
            bulk_favorite)
                bulk_favorite
                continue
                ;;
            bulk_categorize)
                bulk_categorize
                continue
                ;;
            refresh)
                refresh_cache_and_state
                continue
                ;;
            update_all)
                update_all
                continue
                ;;
            settings)
                open_settings_menu
                continue
                ;;
            create_preset)
                create_preset
                continue
                ;;
            backup)
                create_backup
                continue
                ;;
        esac

        # Only reachable when has_entry=true: f6/f7/f8/shortcut.
        MORE_MENU_FALLTHROUGH_ACTION="$chosen_action"
        return 2
    done
}

# ------------------------------------------------------------
# The Settings screen — Actions -> Settings.
#
# Actions had grown to mix two different kinds of
# row: things you DO to the highlighted entry or to build something
# new (Hide, Favorite, Categorize, Create Preset, Create Shortcut,
# Backup), and standing preferences that change ongoing behavior
# (Theme, the bundled-defaults toggles, Open to Categories, Sort,
# Details, Alt Keybinds). Splitting them mirrors how most apps
# separate "things to do" from "Preferences" — reached one level down
# via a single "Settings" row rather than a new key, since every F1-F9
# is already spoken for and settings are visited far less often than
# Hide/Favorite/Categorize.
#
# Same shape as pick_more_action()/open_more_menu() — no has_entry
# split needed here, since none of these rows are entry-scoped.
# ------------------------------------------------------------

pick_settings_action() {

    local -a rows=()
    local result

    # The count belongs on the Settings row itself, not just inside the
    # Theme screen. The position-among-
    # ten indicator inside the Theme screen itself (pick_theme()'s own
    # header, via theme_position_label()) answers a different
    # question — "where is the one I'm on now" — this one just says
    # how many there are to pick from, same as Settings' own row
    # counts its own items. Hardcoded, same convention as that "(9)":
    # bump it if a theme is ever added to pick_theme()'s own list.
    rows+=("theme"$'\t'"$(printf '%-20s%s' 'Themes' '(10)')")

    # Global overrides for the bundled curated defaults (categories and
    # pre-hidden commands). Off means "don't apply the bundled data to
    # anything I haven't touched myself" — a user's own F3/F8 choice on
    # any individual entry always wins regardless of this setting, so
    # this is only an escape hatch for someone who wants a blank slate
    # from the start, not the everyday way to override one entry.
    local categories_state='On'
    [[ "$CONFIG_DEFAULT_CATEGORIES" == off ]] && categories_state='Off'
    rows+=("toggle_default_categories"$'\t'"$(printf '%-20s%s' 'Default Categories' "$categories_state")")

    local hidden_state='On'
    [[ "$CONFIG_DEFAULT_HIDDEN" == off ]] && hidden_state='Off'
    rows+=("toggle_default_hidden"$'\t'"$(printf '%-20s%s' 'Default Hidden' "$hidden_state")")

    # Opt-in, unlike the two above — this changes the very first thing
    # you see on launch, so it defaults to the familiar "All" list
    # rather than switching everyone's startup screen out from under
    # them. Only worth turning on once categories are actually
    # populated (bundled, manual, or both); an empty category list
    # would just show a picker with nothing useful in it.
    local open_to_categories_state='Off'
    [[ "$CONFIG_OPEN_TO_CATEGORIES" == on ]] && open_to_categories_state='On'
    rows+=("toggle_open_to_categories"$'\t'"$(printf '%-20s%s' 'Open to Categories' "$open_to_categories_state")")

    # A four-way cycle rather than a plain on/off toggle, unlike the
    # three above — Name and Size each have their own ascending/
    # descending direction now too. "Name ↑" is just what every view
    # already shows for free (the cache is written alphabetically);
    # the other three all reorder it. Doesn't affect Most Used,
    # Recently Launched, or Recently Added, which already have their
    # own meaningful order regardless of this setting.
    local sort_state='Name ↑'
    case "$SORT_ORDER" in
        name-desc) sort_state='Name ↓' ;;
        size-asc)  sort_state='Size ↑' ;;
        size)      sort_state='Size ↓' ;;
    esac
    rows+=("toggle_sort"$'\t'"$(printf '%-20s%s' 'Sort' "$sort_state")")

    # Controls the main list's VERSION/SIZE columns specifically.
    # Opt-in (default off), same reasoning as Open to Categories above — this changes
    # what every row looks like, so it defaults to the familiar full
    # layout rather than switching it out from under anyone. Read by
    # build_entries() and the column header, the only two places that
    # lay a row's columns out.
    local compact_view_state='Off'
    [[ "$COMPACT_VIEW" == on ]] && compact_view_state='On'
    rows+=("toggle_compact_view"$'\t'"$(printf '%-20s%s' 'Compact View' "$compact_view_state")")

    # Same DETAILS_VISIBLE flag F3 itself toggles — on
    # every screen with an F3 details/preview pane (main list, F2
    # alike, see DETAILS_VISIBLE's own comment) — just also reachable
    # (and its current state visible) from here, for anyone who
    # reaches for Settings before remembering F3 exists.
    local details_state='Off'
    [[ "$DETAILS_VISIBLE" == true ]] && details_state='On'
    rows+=("toggle_details"$'\t'"$(printf '%-20s%s' 'Details' "$details_state")")

    # Persisted (unlike Details above, which is a per-session peek) —
    # where the pane sits is a standing layout preference, same as
    # Sort or Alt Keybinds. Read by details_preview_window(), which
    # every screen with a details/preview pane builds its
    # --preview-window value through.
    local details_position_state='Bottom'
    [[ "$DETAILS_POSITION" == top ]] && details_position_state='Top'
    rows+=("toggle_details_position"$'\t'"$(printf '%-20s%s' 'Details Position' "$details_position_state")")

    # The footer was inconsistent about this — All showed both Fn keys
    # and their ⌥ alternatives, F2/F9 never did.
    # Before this, whether ⌥ aliases showed was decided automatically,
    # purely by whether they happened to fit the terminal width — never
    # a real user choice, and F2/F9's own footer never even tried. Now
    # a persisted preference: On tries to show the ⌥ alias next to
    # every F-key wherever there's room (main list, F2, F9 alike — see
    # build_footer()/build_picker_footer()), Off never does. The F-keys
    # themselves always work either way; this only changes the footer.
    local alt_keybinds_state='On'
    [[ "$CONFIG_ALT_KEYBINDS" == off ]] && alt_keybinds_state='Off'
    rows+=("toggle_alt_keybinds"$'\t'"$(printf '%-20s%s' 'Alt Keybinds' "$alt_keybinds_state")")

    rm -f "$FOOTER_CLICK_FILE"

    # Same always-on details pane as Actions itself — the rows here
    # are exactly the ones that moved out of pick_more_action(), so
    # --internal-preview-action already has an entry for every one of
    # them (keyed by row id, not by which menu shows it).
    result="$(
        printf '%s\n' "${rows[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Settings')" \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --delimiter=$'\t' \
            --with-nth=2 \
            --preview "${(q)SCRIPT_PATH} --internal-preview-action {1}" \
            --preview-window="$(details_preview_window)" \
            --footer='  ↑ ↓  Navigate    Type  Search    Enter/Space  [Choose]    Esc  [Back]' \
            --bind 'space:accept' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$result" ]] && return 1

    printf '%s' "${result%%$'\t'*}"
}

# Runs the Settings screen to completion — same loop-until-Esc idea as
# open_more_menu(), so every toggle here flips in place and reopens
# Settings right after instead of dropping back out to Actions.
open_settings_menu() {

    local chosen_action new_value

    while true; do

        chosen_action="$(pick_settings_action)"

        [[ -z "$chosen_action" ]] && return 1

        case "$chosen_action" in
            toggle_default_categories)
                new_value='off'
                [[ "$CONFIG_DEFAULT_CATEGORIES" == off ]] && new_value='on'
                set_config_value DEFAULT_CATEGORIES "$new_value"
                CONFIG_DEFAULT_CATEGORIES="$new_value"
                continue
                ;;
            toggle_default_hidden)
                new_value='off'
                [[ "$CONFIG_DEFAULT_HIDDEN" == off ]] && new_value='on'
                set_config_value DEFAULT_HIDDEN "$new_value"
                CONFIG_DEFAULT_HIDDEN="$new_value"
                continue
                ;;
            toggle_open_to_categories)
                # Opt-in (default off), so the flip direction here is
                # the reverse of the two toggles above — starts by
                # turning on, not off.
                new_value='on'
                [[ "$CONFIG_OPEN_TO_CATEGORIES" == on ]] && new_value='off'
                set_config_value OPEN_TO_CATEGORIES "$new_value"
                CONFIG_OPEN_TO_CATEGORIES="$new_value"
                continue
                ;;
            toggle_sort)
                # Name ↑ -> Name ↓ -> Size ↑ -> Size ↓ -> back to Name ↑.
                case "$SORT_ORDER" in
                    name)      new_value='name-desc' ;;
                    name-desc) new_value='size-asc' ;;
                    size-asc)  new_value='size' ;;
                    *)         new_value='name' ;;
                esac
                set_config_value SORT "$new_value"
                SORT_ORDER="$new_value"

                # Rebuilt here rather than left for whatever the next
                # incidental trigger happens to be (F5, switching view,
                # F6/F7/F8) — the whole point of toggling this is to
                # see the reordered list right away, so leaving the
                # stale order on screen until something else refreshes
                # it would look exactly like the toggle did nothing.
                # build_fzf_header() too, so the main list's own sort
                # arrow (see build_fzf_header()'s own comment) reflects
                # whichever column/direction Settings just picked.
                build_fzf_header
                build_entries
                continue
                ;;
            toggle_compact_view)
                new_value='on'
                [[ "$COMPACT_VIEW" == on ]] && new_value='off'
                set_config_value COMPACT_VIEW "$new_value"
                COMPACT_VIEW="$new_value"

                # Same reasoning as Sort right above — this changes
                # every row's own display string, so it needs a
                # rebuild to actually show up rather than waiting on
                # the next incidental one. The column header names
                # need the same recompute, or they'd keep advertising
                # VERSION/SIZE columns over rows that no longer have
                # them — confirmed live before this line was added.
                build_entries
                build_fzf_header
                continue
                ;;
            toggle_details)
                # Not persisted like the toggles above — same as F3
                # itself, this is a per-session view preference, not a
                # setting. No rebuild needed either: unlike Sort, this
                # only changes whether the preview window shows, not
                # the data in it, so the main loop's own next fzf
                # redraw already picks it up.
                [[ "$DETAILS_VISIBLE" == true ]] && DETAILS_VISIBLE=false || DETAILS_VISIBLE=true

                # DETAILS_PINNED tracks *this* path specifically — see
                # its own comment for why. Set to match the new state:
                # true (a standing "always on" choice) if Details just
                # turned on this way, false if it just turned off.
                DETAILS_PINNED="$DETAILS_VISIBLE"
                continue
                ;;
            toggle_details_position)
                new_value='bottom'
                [[ "$DETAILS_POSITION" == bottom ]] && new_value='top'
                set_config_value DETAILS_POSITION "$new_value"
                DETAILS_POSITION="$new_value"
                continue
                ;;
            toggle_alt_keybinds)
                new_value='off'
                [[ "$CONFIG_ALT_KEYBINDS" == off ]] && new_value='on'
                set_config_value ALT_KEYBINDS "$new_value"
                CONFIG_ALT_KEYBINDS="$new_value"
                continue
                ;;
            theme)
                pick_theme
                continue
                ;;
        esac

    done
}

# Finds $1 (a theme name) among the "name<TAB>display" rows in $2... and
# prints "N of TOTAL" (1-based) on match, or nothing (exit 1) if it
# isn't in there at all. Split out of pick_theme() so the count math is
# testable without driving fzf.
theme_position_label() {

    local target="$1"
    shift
    local -a choices=("$@")
    local total=${#choices[@]}
    local i=0 index=0 choice

    for choice in "${choices[@]}"; do
        (( i++ ))
        [[ "${choice%%$'\t'*}" == "$target" ]] && index=$i
    done

    (( index == 0 )) && return 1

    printf '%s of %s' "$index" "$total"
}

# ------------------------------------------------------------
# The Theme screen, reached from Actions -> Settings.
#
# Doesn't need a selected entry (nothing here is about any one row),
# so its main-loop dispatch sits with F1/Help rather than falling
# through to an entry-specific handler the way F6/F7/F8/F9 do.
# ------------------------------------------------------------

pick_theme() {

    # Real name in field 1 (what gets written and compared), a short
    # description in field 2 — same tab-delimited real/display split
    # every other picker screen here already uses, via --with-nth=2.
    local -a choices=(
        "catppuccin"$'\t'"$(printf '%-17s%s' catppuccin 'Soft pastel colors on a dark purple-blue base')"
        "gruvbox"$'\t'"$(printf '%-17s%s' gruvbox 'Warm, low-contrast — brown background, retro accents')"
        "tokyonight"$'\t'"$(printf '%-17s%s' tokyonight 'Cool blues and purples, inspired by Tokyo at night')"
        "nord"$'\t'"$(printf '%-17s%s' nord 'Muted arctic blues and grays, minimal and cool')"
        "dracula"$'\t'"$(printf '%-17s%s' dracula 'Vibrant purple and pink on dark gray')"
        "green"$'\t'"$(printf '%-17s%s' green 'Green-phosphor CRT — black background, bright green text')"
        "amber"$'\t'"$(printf '%-17s%s' amber 'Amber-phosphor CRT — black background, warm amber text')"
        "solarized-dark"$'\t'"$(printf '%-17s%s' solarized-dark 'Full color-wheel spread — teal background, warm accents')"
        "solarized-light"$'\t'"$(printf '%-17s%s' solarized-light 'Same accents as Solarized Dark, on a warm cream background')"
        "red-sands"$'\t'"$(printf '%-17s%s' red-sands 'Deep brick-red background, warm cream text')"
    )
    local result picked
    local theme_header="Current: $THEME_NAME"
    local theme_position

    # With 10 themes to scroll through and no visible count anywhere,
    # there was no way to tell how many more there were below the
    # fold. Silently omitted (rather than guessing) if THEME_NAME
    # somehow isn't one of the choices above, which shouldn't happen.
    if theme_position="$(theme_position_label "$THEME_NAME" "${choices[@]}")"; then
        theme_header+="  ($theme_position)"
    fi

    rm -f "$FOOTER_CLICK_FILE"

    result="$(
        printf '%s\n' "${choices[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Theme')" \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --delimiter=$'\t' \
            --with-nth=2 \
            --header="$theme_header"$'\n'"Takes effect after a relaunch, not live."$'\n'"Want your own colors? See CUSTOM_COLORS in README.md — config-file only." \
            --footer='  ↑ ↓  Navigate    Type  Search    Enter  [Choose]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$result" ]] && return 1

    picked="${result%%$'\t'*}"

    # Picking the theme you're already on writes the same value back
    # (harmless) but shouldn't then offer to "relaunch to apply" —
    # there's nothing to apply.
    [[ "$picked" == "$THEME_NAME" ]] && return 0

    set_config_value THEME "$picked"

    if confirm_relaunch "Theme set to \"$picked\"."; then
        exec "$SCRIPT_PATH"
    fi
}

# Populates category_counts with exactly what each category's filtered
# view will actually show — not just "how many lines mention this
# category". A plain `grep -c` on the real file over-counts blank/
# comment lines and entries that are hidden or no longer installed, and
# a bundled tally on its own can't know a bundled member is hidden
# either. Both matter: several bundled-hidden commands (age-inspect,
# calcurse-caldav/-upgrade/-vdir) share a formula with a bundled
# category (Security, Productivity), so without this check those
# categories always showed a higher count than they actually displayed
# — the real bug report that led to this function existing.
typeset -A category_counts

compute_category_counts() {

    category_counts=()

    local name count_file count_member bundled_command known_command
    typeset -A known_commands

    while IFS=$'\t' read -r known_command _; do
        [[ -n "$known_command" ]] && known_commands[$known_command]=1
    done < "$CACHE_FILE"

    for name in "${CATEGORY_NAMES[@]}"; do

        count_file="$CATEGORIES_DIR/$name"

        [[ -f "$count_file" ]] || continue

        while IFS= read -r count_member; do

            count_member="${count_member#"${count_member%%[![:space:]]*}"}"
            count_member="${count_member%"${count_member##*[![:space:]]}"}"

            [[ -z "$count_member" ]] && continue
            [[ "$count_member" == \#* ]] && continue
            [[ -z "${known_commands[$count_member]-}" ]] && continue
            [[ -n "${hidden_commands[$count_member]-}" ]] && continue

            (( category_counts[$name]++ ))

        done < "$count_file"
    done

    for bundled_command in "${(k)default_category_commands[@]}"; do
        [[ -n "${hidden_commands[$bundled_command]-}" ]] && continue
        (( category_counts[${default_category_commands[$bundled_command]}]++ ))
    done
}

pick_view() {

    local choices result result_lines pick_action picked clicked_word
    local name count total_count

    # Refreshed here rather than trusted from the caller — the counts
    # this builds need them, and pick_view() is reached from more than
    # one place, not all of which are guaranteed to have loaded them
    # first. A launch just before opening this picker should already
    # be reflected in Most Used's own count.
    load_hidden_commands
    load_launch_counts

    # Two columns per row: the real name (what gets used and stored),
    # and a display form that marks categories you made yourself with
    # "· " — everything else here (All, Hidden, Favorites) is built
    # in, not something you created, so it stays unmarked. Reusing the
    # main list's own "#"/"*" markers here was considered and rejected
    # — they already mean something specific there (categorized /
    # outdated), and reusing them for a different meaning on this
    # screen would confuse more than it clarifies.
    #
    # Every row gets a count, including "All" — it used to be left out
    # on the theory that fzf's own inline counter repeats it once
    # you're actually in that view, but from this screen every other
    # row has a number and All didn't, which reads as something
    # missing rather than intentional. "All" excludes hidden entries,
    # same as the real view does — it was never literally everything
    # installed, just everything you haven't hidden.
    total_count="$(grep -c '' "$CACHE_FILE" 2>/dev/null)"
    count=$(( ${total_count:-0} - ${#hidden_commands[@]} ))
    (( count < 0 )) && count=0
    choices=("All"$'\t'"All ($count)")

    compute_category_counts

    for name in "${CATEGORY_NAMES[@]}"; do

        count="${category_counts[$name]:-0}"

        if [[ "$name" == "Favorites" ]]; then
            choices+=("$name"$'\t'"$name ($count)")
        else
            choices+=("$name"$'\t'"· $name ($count)")
        fi
    done

    # Most Used, Recently Launched, and Recently Added are all
    # computed, not saved category files — unmarked, like the other
    # built-ins above. Their counts reflect what will actually appear
    # (capped at COMPUTED_VIEW_LIMIT), not the true total, so the
    # number here never promises more than the view itself will show.
    count="${#launch_counts[@]}"
    (( count > COMPUTED_VIEW_LIMIT )) && count=$COMPUTED_VIEW_LIMIT
    choices+=("Most Used"$'\t'"Most Used ($count)")

    # Same launch-history data as Most Used just above, ordered by
    # recency instead of frequency — a different question ("what did I
    # just run" vs "what do I run a lot"). Grouped right next to Most Used since both come
    # from the same underlying log; Recently Added (install date) is a
    # third, unrelated axis.
    count="${#last_launched_order[@]}"
    (( count > COMPUTED_VIEW_LIMIT )) && count=$COMPUTED_VIEW_LIMIT
    choices+=("Recently Launched"$'\t'"Recently Launched ($count)")

    # Same total-minus-hidden figure the "All" row above already
    # computed — recomputing it here would just repeat the same grep.
    count=$(( ${total_count:-0} - ${#hidden_commands[@]} ))
    (( count < 0 )) && count=0
    (( count > COMPUTED_VIEW_LIMIT )) && count=$COMPUTED_VIEW_LIMIT
    choices+=("Recently Added"$'\t'"Recently Added ($count)")

    choices+=("Hidden"$'\t'"Hidden (${#hidden_commands[@]})")

    rm -f "$FOOTER_CLICK_FILE"

    # Width-aware, same idea as the main list's own footer. This screen
    # alone had grown to 7
    # actions plus nav/search, more than a single static footer string
    # can safely promise; fzf was truncating it mid-word instead of
    # degrading gracefully. See build_picker_footer() for how.
    local view_footer
    view_footer="$(
        build_picker_footer \
            '  ↑ ↓  Navigate    Type  Search    Enter  [View]    Esc  [Back]' \
            '  ↑ ↓  Navigate    Enter  [View]    Esc  [Back]' \
            $'F3\tD\t[Details]' $'F4\tM\t[Actions]' $'F9\tP\t[Presets]' \
            $'Ctrl-R\t\t[Rename]' $'Ctrl-D\t\t[Delete]'
    )"

    result="$(
        printf '%s\n' "${choices[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'View')" \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --delimiter=$'\t' \
            --with-nth=2 \
            --preview "${(q)SCRIPT_PATH} --internal-preview-category {1}" \
            --preview-window="$(details_preview_window "$DETAILS_VISIBLE")" \
            --footer="$view_footer" \
            --expect=enter,ctrl-d,ctrl-r,f3,f4,f5,f9 \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    if [[ -z "$result" ]]; then
        CURRENT_VIEW="All"
        load_category_members
        return 1
    fi

    result_lines=("${(@f)result}")
    pick_action="${result_lines[1]}"
    # The selected row still carries both tab-delimited columns even
    # though only the display one was shown — take the real name.
    picked="${result_lines[2]%%$'\t'*}"

    if [[ -f "$FOOTER_CLICK_FILE" ]]; then
        clicked_word="$(sed -n '1p' "$FOOTER_CLICK_FILE")"
        rm -f "$FOOTER_CLICK_FILE"

        case "$clicked_word" in
            '[Delete]'|Delete) pick_action="ctrl-d" ;;
            '[Rename]'|Rename) pick_action="ctrl-r" ;;
            '[Details]'|Details) pick_action="f3" ;;
            '[Presets]'|Presets|F9/⌥P|F9) pick_action="f9" ;;
            '[View]'|View) pick_action="enter" ;;
            '[Actions]'|Actions|F4/⌥M|F4) pick_action="f4" ;;
        esac
    fi

    # Neither needs a picked row — Actions and Refresh both work the
    # same regardless of which view is highlighted when you press them,
    # so this checks before the "nothing picked" guard below (which
    # would otherwise treat highlighting nothing yet as a reason to
    # bail). Redraws by calling back into this same function, exactly
    # like the Ctrl-D delete flow below already does — the view picker
    # really is the hub it's described as elsewhere, so Actions and
    # Refresh need to work here the same as they do on the main list.
    if [[ "$pick_action" == "f4" ]]; then
        open_more_menu "" false
        pick_view
        return $?
    fi

    if [[ "$pick_action" == "f5" ]]; then
        refresh_cache_and_state
        pick_view
        return $?
    fi

    # F9 — Launch Preset, reachable from here too now. F4/F5 already
    # worked from this screen; F9 not doing the same read as an
    # inconsistency once someone actually looked for it. Same
    # not-installed message as the main list's own F9 handling, not a
    # duplicate — TMUX_AVAILABLE is a global, checked the same way here.
    if [[ "$pick_action" == "f9" ]]; then
        if [[ "$TMUX_AVAILABLE" == false ]]; then
            printf '\n'
            printf 'Presets need tmux: brew install tmux\n'
            sleep 2
        else
            launch_preset
        fi
        pick_view
        return $?
    fi

    # F3 — toggle the "what's inside this category" preview. Same
    # dispatch-and-redraw shape as F4/F5 above rather than fzf's own
    # native toggle-preview bind, for the same reason DETAILS_VISIBLE
    # uses one on the main list: so Esc could eventually learn to close
    # this first too, the way it already does there.
    if [[ "$pick_action" == "f3" ]]; then
        [[ "$DETAILS_VISIBLE" == true ]] && DETAILS_VISIBLE=false || DETAILS_VISIBLE=true
        # F3 is always a peek, never a standing choice — see
        # DETAILS_PINNED's own comment.
        DETAILS_PINNED=false
        pick_view
        return $?
    fi

    [[ -z "$picked" ]] && return 1

    if [[ "$pick_action" == "ctrl-r" ]]; then

        # Same not-a-real-category guard as Ctrl-D above, minus the
        # bundled-only case: deleting a bundled category converts
        # cleanly to "exclude everything in it," but renaming one has
        # no equally clean equivalent (there'd need to be a brand new
        # real file taking over a global default's members) — simpler
        # and more honest to ask for one F8 first, which already turns
        # a bundled category into a real file the normal way.
        if [[ "$picked" == "All" || "$picked" == "Hidden" || "$picked" == "Favorites" \
              || "$picked" == "Most Used" || "$picked" == "Recently Added" \
              || "$picked" == "Recently Launched" ]]; then
            printf '\n'
            printf '"%s" can'"'"'t be renamed.\n' "$picked"
            sleep 1

        elif [[ ! -f "$CATEGORIES_DIR/$picked" ]]; then
            printf '\n'
            printf '"%s" is a bundled default category, not one of yours yet.\n' "$picked"
            printf 'Categorize one entry into it with F8 first, then it can be renamed.\n'
            sleep 2

        else
            local renamed_category
            if renamed_category="$(rename_category "$picked")" && [[ -n "$renamed_category" ]]; then
                refresh_category_state
                [[ "$CURRENT_VIEW" == "$picked" ]] && CURRENT_VIEW="$renamed_category"
            fi
        fi

        # Same reasoning as Ctrl-D below: stay in the picker rather
        # than dropping back to "All".
        pick_view
        return $?
    fi

    if [[ "$pick_action" == "ctrl-d" ]]; then

        # "All" and "Hidden" aren't category files, "Favorites" is
        # protected because F6 owns it (deleting it out from under
        # that would leave F6 unable to get it back into this list),
        # and "Most Used"/"Recently Added"/"Recently Launched" are computed rather than a
        # category file at all — there's nothing under CATEGORIES_DIR
        # for any of these to delete.
        #
        # Explicit message on refusal, not a silent no-op: otherwise
        # this falls through to rebuilding with whatever view was
        # active before, which looks like the refused delete
        # "navigated" somewhere on its own.
        if [[ "$picked" == "All" || "$picked" == "Hidden" || "$picked" == "Favorites" \
              || "$picked" == "Most Used" || "$picked" == "Recently Added" \
              || "$picked" == "Recently Launched" ]]; then
            printf '\n'
            printf '"%s" can'"'"'t be deleted.\n' "$picked"
            sleep 1

        elif confirm_delete_category "$picked"; then

            rm -f "$CATEGORIES_DIR/$picked"

            # A bundled-only category (see load_bundled_categories) has
            # no real file to remove — deleting it here means excluding
            # every command it currently contributes, or it would just
            # reappear unchanged on the very next refresh.
            local exclude_command
            mkdir -p "$CONFIG_DIR"
            for exclude_command in "${(k)default_category_commands[@]}"; do
                if [[ "${default_category_commands[$exclude_command]}" == "$picked" ]] &&
                   ! grep -Fqx "$exclude_command" "$CATEGORY_EXCLUDE_FILE" 2>/dev/null; then
                    printf '%s\n' "$exclude_command" >> "$CATEGORY_EXCLUDE_FILE"
                fi
            done

            refresh_category_state

            # If the deleted category was the active view, that view no
            # longer exists.
            [[ "$CURRENT_VIEW" == "$picked" ]] && CURRENT_VIEW="All"
        fi

        # Stay in the picker rather than dropping back to "All" —
        # deleting a category is a "still managing categories" action,
        # not a "done, take me back to the list" one.
        pick_view
        return $?
    fi

    CURRENT_VIEW="$picked"

    load_category_members
}

# Separate from category_members above: this tracks Favorites
# membership regardless of which category is currently active, since
# the favorite marker (see FAVORITE_MARKER_TEXT) needs to show in
# every view, not just while filtered to Favorites.
typeset -A favorite_commands

load_favorite_commands() {

    favorite_commands=()

    local favorites_file="$CATEGORIES_DIR/Favorites"
    local member

    [[ -f "$favorites_file" ]] || return

    while IFS= read -r member; do
        [[ -z "$member" ]] && continue
        favorite_commands[$member]=1
    done < "$favorites_file"
}

load_favorite_commands

# Union of every REAL category file's membership except Favorites
# (which has its own tracking above) — the "manually categorized" set
# that decides whether a bundled default category (see below) still
# applies to a given command. Globs CATEGORIES_DIR directly rather
# than looping CATEGORY_NAMES, so it has no ordering dependency on
# that list being built first — load_bundled_categories() below needs
# this result before CATEGORY_NAMES can even be finalized, since a
# bundled-only category name has to be added to that list too.
#
# Also powers the "#" marker, but not alone — load_bundled_categories()
# adds to this same array for bundled-only assignments too, so the
# marker shows for those as well. Only *this* array's membership (the
# real-file scan) is what counts as "manually categorized" elsewhere;
# see default_category_commands below for that distinction.
typeset -A categorized_commands
typeset -A manually_categorized_commands

load_categorized_commands() {

    categorized_commands=()
    manually_categorized_commands=()

    local file name member

    [[ -d "$CATEGORIES_DIR" ]] || return

    for file in "$CATEGORIES_DIR"/*; do

        [[ -f "$file" ]] || continue

        name="${file:t}"
        [[ "$name" == "Favorites" ]] && continue

        while IFS= read -r member; do
            [[ -z "$member" ]] && continue
            categorized_commands[$member]=1
            manually_categorized_commands[$member]=1
        done < "$file"
    done
}

# Commands explicitly excluded from every bundled category assignment
# — written when F8 "removes" an entry whose only membership in the
# category being viewed was the bundled default, not a real file line
# (see toggle_category_direct/toggle_category).
typeset -A category_excluded_commands

load_category_excluded_commands() {

    category_excluded_commands=()

    [[ -f "$CATEGORY_EXCLUDE_FILE" ]] || return

    local member

    while IFS= read -r member; do
        [[ -z "$member" ]] && continue
        category_excluded_commands[$member]=1
    done < "$CATEGORY_EXCLUDE_FILE"
}

# The bundled curated category for every installed command that isn't
# already manually categorized (see "Bundled defaults") — read from
# the cache's default_category field (field 10), which rebuild_cache()
# stamps on every entry regardless of the DEFAULT_CATEGORIES config
# setting; that switch, and the exclude list above, are both applied
# here instead, so toggling either takes effect without a rebuild.
#
# Also adds its members to categorized_commands (the "#" marker set) —
# a beginner is meant to feel pre-organized, so the marker shouldn't
# distinguish "the app filed this for you" from "you filed this
# yourself." manually_categorized_commands is what still tells them
# apart internally, for the eligibility check below.
typeset -A default_category_commands

load_bundled_categories() {

    default_category_commands=()

    [[ -f "$CACHE_FILE" ]] || return
    [[ "$CONFIG_DEFAULT_CATEGORIES" == off ]] && return

    local raw_command raw_category
    local _f2 _f3 _f4 _f5 _f6 _f7 _f8 _f9 _f11

    while IFS=$'\t' read -r raw_command _f2 _f3 _f4 _f5 _f6 _f7 _f8 _f9 raw_category _f11; do

        [[ -z "$raw_category" || "$raw_category" == "-" ]] && continue
        [[ -n "${manually_categorized_commands[$raw_command]-}" ]] && continue
        [[ -n "${category_excluded_commands[$raw_command]-}" ]] && continue

        default_category_commands[$raw_command]="$raw_category"
        categorized_commands[$raw_command]=1

    done < "$CACHE_FILE"
}

# Runs the four loads above in the only order that actually works:
# manual membership and the exclude list have to be known before the
# bundled pass can decide what's still eligible, and CATEGORY_NAMES
# has to come last since a bundled-only category needs to be added to
# it too. Every call site that used to call load_categorized_commands
# (alone, or paired with load_category_names) now calls this instead.
refresh_category_state() {
    load_categorized_commands
    load_category_excluded_commands
    load_bundled_categories
    load_category_names
}

refresh_category_state

# ------------------------------------------------------------
# --list: plain tab-separated output, no fzf.
#
# Fields: command, formula, version, size, outdated (0/1), description
#
# For scripting/shell-completion use, not for humans — the padded,
# aligned columns fzf shows are built further below and only used
# for the interactive picker.
# ------------------------------------------------------------

if [[ "$LIST_MODE" == true ]]; then

    while IFS=$'\t' read -r command description formula version size outdated full_name resolved_path install_time; do

        if [[ -n "${hidden_commands[$command]-}" ]]; then
            continue
        fi

        outdated_flag="0"

        if [[ -n "${outdated_formulas[$formula]-}" || -n "${outdated_formulas[$full_name]-}" ]]; then
            outdated_flag="1"
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$command" "$formula" "$version" "$size" "$outdated_flag" "$description"

    done < "$CACHE_FILE"

    exit 0
fi

# ------------------------------------------------------------
# Calculate column widths.
# ------------------------------------------------------------

# Update indicator is a suffix directly on the version number itself
# (e.g. "1.4.7*") rather than a separate column — a trailing asterisk
# is a familiar "there's a footnote on this" convention (price tags,
# citations), and ties it visually to exactly what it's flagging.
#
# Favorite ("+") and "in some category" ("#") markers share one slot
# at the very start of the line, before the name — both are about the
# tool's organizational identity, not its version, so they sit apart
# from the version-attached update indicator. "#" means "belongs to
# at least one category other than Favorites" — Favorites membership
# already has its own "+", so repeating that as "#" too would just
# be re-showing the same fact. Plain ASCII throughout rather than
# fancier glyphs like "★" or an arrow — "★" didn't render distinctly
# from "*" in testing (font fallback), and "↑" would collide in
# meaning with the footer's own "↑ ↓ Navigate" hint. What each symbol
# means is spelled out in the footer instead. Both markers are shown
# in every view, not just their own filtered one, since toggling from
# the "All" view otherwise gives no visible feedback at all.
# The footer legend names these in the past participle — "Favorited",
# "Categorized", "Outdated" — for two reasons. Semantically they
# describe a *state* a row is in, whereas every bracketed footer item
# is an *action* you can take; "Update" read as a verb and implied the
# launcher would update something, which it never does (that's
# Homebrew's job). Practically, the participles also can't collide
# with the click handler's action words: a bare "Favorite" in the
# legend would be clickable and fire F6.
UPDATE_INDICATOR_TEXT="*"
FAVORITE_MARKER_TEXT="+"
CATEGORIZED_MARKER_TEXT="#"
LEFT_MARKER_WIDTH=$(( ${#FAVORITE_MARKER_TEXT} + ${#CATEGORIZED_MARKER_TEXT} + 2 ))

max_name=4
max_version=7
max_size=4

while IFS=$'\t' read -r command description formula version size outdated full_name resolved_path install_time; do

    display_name="$formula"

    if [[ "$formula" != "$command" ]]; then
        display_name="$formula ($command)"
    fi

    if (( ${#display_name} > max_name )); then
        max_name=${#display_name}
    fi

    if (( ${#version} > max_version )); then
        max_version=${#version}
    fi

    if (( ${#size} > max_size )); then
        max_size=${#size}
    fi

done < "$CACHE_FILE"

max_name=$((max_name + 3))
# +2 gap, +1 more so the update-indicator suffix (e.g. "1.4.7*") on
# the single longest version string still leaves a full gap, not a
# squeezed one, before the next column.
max_version=$((max_version + 2 + ${#UPDATE_INDICATOR_TEXT}))
max_size=$((max_size + 2))

# ------------------------------------------------------------
# Build fzf display entries.
#
# Field 1 = actual executable
# Field 2 = display text
# Field 3 = formula
# Field 4 = description
#
# Callable again after hiding/restoring an entry. Column widths
# (computed once above) are reused rather than recalculated.
# ------------------------------------------------------------

build_entries() {

    # These MUST be local. The read loop below assigns to `command`
    # and `formula`, which are also the names the launcher loop uses
    # for the currently selected entry — and this function reads with
    # a plain redirect, so it runs in the current shell. Without
    # `local`, finishing the loop leaves both empty, so anything the
    # caller does with "$command" *after* calling build_entries gets
    # an empty string. That silently broke the cursor-restore on F6
    # and F7 (find_entry_position "" never matches, so no position was
    # ever passed to fzf and the cursor snapped back to the top).
    local command description formula version size outdated full_name
    local resolved_path install_time
    local display_name name_fmt version_text version_fmt size_fmt
    local left_marker left_marker_fmt display
    local -a sort_prep
    local sort_entry sort_cmd sort_key sort_index

    entries=()

    while IFS=$'\t' read -r command description formula version size outdated full_name resolved_path install_time; do

        # Recorded for every row regardless of view — Recently Added
        # needs it as a lookup once the loop below has moved past this
        # row, and it's cheap enough not to bother gating.
        install_times[$command]="$install_time"
        entry_sizes[$command]="$size"

        # View filter. "Hidden" is the only view that shows hidden
        # entries, and it shows nothing else — which is what lets it
        # be an ordinary view instead of a separate screen. Most Used,
        # Recently Launched, and Recently Added get their own branches
        # rather than falling through to the category-file check
        # below: none of them is backed by a file under
        # CATEGORIES_DIR, so category_members would just be empty for
        # them and exclude everything.
        if [[ "$CURRENT_VIEW" == "Hidden" ]]; then

            [[ -z "${hidden_commands[$command]-}" ]] && continue

        elif [[ "$CURRENT_VIEW" == "Most Used" ]]; then

            [[ -n "${hidden_commands[$command]-}" ]] && continue
            [[ -z "${launch_counts[$command]-}" ]] && continue

        elif [[ "$CURRENT_VIEW" == "Recently Launched" ]]; then

            [[ -n "${hidden_commands[$command]-}" ]] && continue
            [[ -z "${last_launched_order[$command]-}" ]] && continue

        elif [[ "$CURRENT_VIEW" == "Recently Added" ]]; then

            [[ -n "${hidden_commands[$command]-}" ]] && continue

        else

            [[ -n "${hidden_commands[$command]-}" ]] && continue

            if [[ "$CURRENT_VIEW" != "All" && -z "${category_members[$command]-}" ]]; then
                continue
            fi
        fi

        display_name="$formula"

        if [[ "$formula" != "$command" ]]; then
            display_name="$formula ($command)"
        fi

        left_marker=" "

        if [[ -n "${favorite_commands[$command]-}" ]]; then
            left_marker="$FAVORITE_MARKER_TEXT"
        fi

        if [[ -n "${categorized_commands[$command]-}" ]]; then
            left_marker="${left_marker}${CATEGORIZED_MARKER_TEXT}"
        fi

        left_marker_fmt="$(printf "%-${LEFT_MARKER_WIDTH}s" "$left_marker")"

        name_fmt="$(printf "%-${max_name}s" "$display_name")"

        version_text="$version"

        if [[ -n "${outdated_formulas[$formula]-}" || -n "${outdated_formulas[$full_name]-}" ]]; then
            version_text="${version}${UPDATE_INDICATOR_TEXT}"
        fi

        version_fmt="$(printf "%-${max_version}s" "$version_text")"
        size_fmt="$(printf "%-${max_size}s" "$size")"

        # Compact View (Settings) drops the VERSION/SIZE columns
        # entirely rather than just leaving them blank, and hides the
        # leading marker column
        # too (the "*" outdated marker needs no separate handling: it
        # lives inside version_text above, which is already gone).
        # Everything else about a row (the command/formula/description
        # fields entries[] itself carries, the outdated check above)
        # stays the same either way; this only changes what's actually
        # rendered.
        if [[ "$COMPACT_VIEW" == on ]]; then
            display="$name_fmt$description"
        else
            display="$left_marker_fmt$name_fmt$version_fmt$size_fmt$description"
        fi

        entries+=(
            "$command"$'\t'"$display"$'\t'"$formula"$'\t'"$description"$'\t'"$resolved_path"
        )

    done < "$CACHE_FILE"

    # Most Used, Recently Launched, and Recently Added each show their
    # own ranking, not alphabetical order (which is what the read loop
    # above naturally produces, since CACHE_FILE is written sorted by
    # name). Sorted here rather than by changing what CACHE_FILE itself
    # contains — every other view still wants alphabetical order by
    # default, so the rank only matters for these three, applied after
    # the fact and only to whatever already survived the filter above.
    #
    # SORT_ORDER=size/size-asc (Actions → Sort, or a SIZE header click)
    # rides the same mechanism — name is just the alphabetical order
    # already there for free (see the name-desc branch below for its
    # own, simpler handling), so the only real work here is size,
    # largest or smallest first depending on direction. Doesn't apply
    # to Most Used/Recently Launched/Recently Added, though — each
    # already has a more meaningful order of its own that Sort
    # shouldn't override; they always sort descending (most first),
    # not affected by SORT_ORDER's own direction at all.
    #
    # The sort key is zero-padded to a fixed width and placed ahead of
    # a real tab-delimited entry, sorted as one string, then stripped
    # back off — sidesteps any doubt about exactly how zsh's numeric
    # sort flag treats a key embedded partway through a longer string,
    # since a zero-padded prefix sorts correctly as plain text too.
    if [[ "$CURRENT_VIEW" == "Most Used" || "$CURRENT_VIEW" == "Recently Launched" \
          || "$CURRENT_VIEW" == "Recently Added" \
          || "${SORT_ORDER:-name}" == "size" || "${SORT_ORDER:-name}" == "size-asc" ]]; then

        sort_prep=()

        for sort_entry in "${entries[@]}"; do

            sort_cmd="${sort_entry%%$'\t'*}"

            if [[ "$CURRENT_VIEW" == "Most Used" ]]; then
                sort_key="${launch_counts[$sort_cmd]:-0}"
            elif [[ "$CURRENT_VIEW" == "Recently Launched" ]]; then
                sort_key="${last_launched_order[$sort_cmd]:-0}"
            elif [[ "$CURRENT_VIEW" == "Recently Added" ]]; then
                sort_key="${install_times[$sort_cmd]:-0}"
            else
                sort_key="$(size_sort_key "${entry_sizes[$sort_cmd]:-0}")"
            fi

            sort_prep+=("$(printf '%020d' "$sort_key")"$'\t'"$sort_entry")
        done

        # Deliberately unquoted: quoting this expansion collapses the
        # sorted result into one glued-together string instead of a
        # proper array — every element after the first silently
        # vanishes. Caught by an isolated test that showed 3 array
        # elements shrink to 1 after sorting; confirmed the unquoted
        # form is what actually produces a real 3-element array.
        #
        # (On) = descending (largest/most-recent/highest-count first),
        # the only direction Most Used/Recently Launched/Recently
        # Added ever want. SORT_ORDER=size-asc is the one case that
        # wants the other way — smallest first — hence (on) there
        # instead; everything else keeps the existing (On).
        if [[ "${SORT_ORDER:-name}" == "size-asc" && "$CURRENT_VIEW" != "Most Used" \
              && "$CURRENT_VIEW" != "Recently Launched" && "$CURRENT_VIEW" != "Recently Added" ]]; then
            sort_prep=(${(on)sort_prep})
        else
            sort_prep=(${(On)sort_prep})
        fi

        entries=()
        sort_index=0

        for sort_entry in "${sort_prep[@]}"; do
            # Only the launch-history-backed views cap themselves —
            # sorting an ordinary view by size still shows everything
            # it normally would, just reordered, not trimmed to the
            # same 15-item limit that keeps these short on purpose.
            if [[ "$CURRENT_VIEW" == "Most Used" || "$CURRENT_VIEW" == "Recently Launched" \
                  || "$CURRENT_VIEW" == "Recently Added" ]]; then
                (( sort_index >= COMPUTED_VIEW_LIMIT )) && break
            fi
            entries+=("${sort_entry#*$'\t'}")
            (( sort_index++ ))
        done

    elif [[ "${SORT_ORDER:-name}" == "name-desc" ]]; then

        # No sort_prep/key needed here, unlike size above — entries is
        # already in alphabetical order for free (see the big comment
        # above), so descending is just that same order reversed.
        # (Oa) reverses element order outright rather than re-sorting
        # by some default string comparison, which could subtly
        # disagree with the cache's own existing alphabetical order
        # (case-folding, punctuation) if used instead.
        entries=(${(Oa)entries})
    fi
}

# ------------------------------------------------------------
# F5's actual work, pulled out so both the main list and the view
# picker can trigger a real refresh without duplicating this sequence.
# Doesn't need a selected entry. Returns 0 on success (entries/state
# reloaded, ready to redraw) or 1 on failure (already reported to the
# terminal, caller should just redraw with the existing state).
# ------------------------------------------------------------

refresh_cache_and_state() {

    printf '\n'
    printf 'Refreshing…\n'

    # Clear the memoised state so rebuild_cache re-reads Homebrew
    # rather than reusing whatever was captured at startup, which may
    # be minutes old. Re-reading is the point of pressing F5.
    CURRENT_STATE=""

    # rebuild_cache always rebuilds — it doesn't consult FORCE_REFRESH
    # — and it refreshes the outdated snapshot as a side effect, so
    # there's nothing else to force here.
    if rebuild_cache; then
        load_outdated_formulas
        load_hidden_commands
        refresh_category_state
        load_favorite_commands
        load_category_members
        build_entries
        return 0
    fi

    printf 'Refresh failed — keeping the existing list.\n'
    sleep 2
    return 1
}

# ------------------------------------------------------------
# Find an entry's 1-based line number in the current entries array,
# so an action that doesn't remove the highlighted item (favoriting,
# assigning a category, creating a shortcut) can restore the cursor
# to it via run_fzf's initial_position, instead of always jumping
# back to the top of the list on every fzf restart.
# ------------------------------------------------------------

find_entry_position() {

    local target="$1"
    local i entry_command

    for (( i = 1; i <= ${#entries[@]}; i++ )); do
        entry_command="${entries[$i]%%$'\t'*}"

        if [[ "$entry_command" == "$target" ]]; then
            echo "$i"
            return 0
        fi
    done

    return 1
}

# ------------------------------------------------------------
# Column header
#
# A function, not a one-time constant, specifically so toggling
# Compact View can recompute it in place — the column names need to
# match the row data build_entries() is about to rebuild the same way,
# not stay stuck showing VERSION/SIZE headers over rows that no longer
# have them.
# ------------------------------------------------------------

build_fzf_header() {

    # Which column is the active sort, and which way — shown as an
    # arrow right on its label, doubling as both a "here's the current
    # order" indicator and a hint that NAME/SIZE are themselves
    # clickable (see --internal-header-click below). Silently omitted
    # if SORT_ORDER names a column this header doesn't currently show
    # at all (a size-based sort while Compact View is on, which has no
    # SIZE column to attach an arrow to) — same "don't guess" precedent
    # theme_position_label() already sets elsewhere.
    local name_label="NAME" size_label="SIZE"
    case "${SORT_ORDER:-name}" in
        name)      name_label="NAME ↑" ;;
        name-desc) name_label="NAME ↓" ;;
        size)      size_label="SIZE ↓" ;;
        size-asc)  size_label="SIZE ↑" ;;
    esac

    if [[ "$COMPACT_VIEW" == on ]]; then
        # No leading LEFT_MARKER_WIDTH field here — the row data has
        # no marker column to align under either now (see
        # build_entries()'s own comment), so reserving that space
        # would just push NAME out of alignment with it.
        FZF_HEADER="$(
            printf "%-${max_name}s%s" \
                "$name_label" \
                "DESCRIPTION"
        )"
    else
        FZF_HEADER="$(
            printf "%-${LEFT_MARKER_WIDTH}s%-${max_name}s%-${max_version}s%-${max_size}s%s" \
                "" \
                "$name_label" \
                "VERSION" \
                "$size_label" \
                "DESCRIPTION"
        )"
    fi
}

build_fzf_header

# Exported so --internal-header-click's own fresh subprocess (see
# above) can read the exact same header string this process is
# currently showing, without redoing the cache walk that computed
# max_name/max_version/max_size in the first place — a plain scalar
# export, so it stays exported through every later reassignment
# build_fzf_header() makes too (e.g. Compact View's own toggle).
export FZF_HEADER

# ------------------------------------------------------------
# Launch application in the current terminal
# ------------------------------------------------------------

launch_in_current_terminal() {
    local command_path="$1"

    # exec replaces this process, so the EXIT trap never runs — clean
    # the click file up by hand before handing the terminal over.
    rm -f "$FOOTER_CLICK_FILE"

    # Was a bare `exec "$command_path"`, which replaces this process
    # outright. That works for a TUI that takes over the screen until
    # you quit it, but a one-shot CLI (eza, jq, bat, ...) prints and
    # exits in under a second — there's then no process left in the
    # terminal at all, so the tab looks broken or dies, even though
    # the command ran fine.
    #
    # Running it in a sub-shell that falls through to a fresh instance
    # of the launcher itself afterwards (rather than a plain shell)
    # fixes the one-shot-CLI case above and matches what a *launcher*
    # should feel like: pick a tool, use it, quit, and you're back
    # picking another one. Someone who wants a plain
    # shell after a tool can already open a new tab or window for that
    # themselves — the launcher reappearing is the more useful default
    # for the case it's actually for. Both paths are passed as
    # positional args to the inner `zsh -c` rather than interpolated
    # into its script text, so either one containing spaces or shell
    # metacharacters is still passed through as a single argument.
    #
    # The printf between the command and the relaunch exits
    # alternate-screen mode and shows the cursor again — no-ops if the
    # command already cleaned up after itself, but a real fix for one
    # that crashed or got killed mid-TUI without doing so. Confirmed
    # live: a TUI that enters the alternate screen and then dies
    # leaves tmux's own #{alternate_on} stuck at 1 even though a
    # perfectly ordinary shell is now running underneath — the terminal
    # can look frozen or blank until something else forces a redraw.
    #
    # The same printf *before* the command runs turned out to matter
    # just as much, for a different reason: fzf's own picker UI runs
    # inside the alternate screen too (confirmed live — `--height=100%`
    # still opens with a genuine `?1049h`, `--no-clear` only skips
    # fzf's own erase-on-exit, it doesn't mean "stay off the alt
    # screen"). A one-shot CLI (fastfetch, eza, jq, ...) that never
    # touches screen modes itself just inherits whatever's already
    # active and ends up drawing onto that same alternate buffer —
    # which the *after* printf then switches away from once the
    # command's done, discarding output that had nowhere else to go.
    # This meant a fast one-shot CLI could still look like it exited
    # instantly even after the
    # press-any-key pause landed: the pause was working, but by the
    # time it appeared the output was already gone, switched out from
    # under it. Confirmed with a real tmux pane and pipe-pane capture
    # of the raw byte stream — fastfetch's output was genuinely being
    # written in full, just onto a buffer this exact printf then hid.
    # Exiting alternate-screen mode *before* the command runs as well
    # means a plain one-shot CLI now lands on the real, persistent
    # screen from the start; a TUI is still free to enter its own
    # alternate screen fresh when it starts, and the *after* printf
    # still recovers that if it crashes without exiting cleanly.
    #
    # The "press any key" pause right before the relaunch matters for
    # the same reason: a one-shot CLI prints and exits in under a second, and
    # without this the relaunch landed so fast it painted the picker's
    # full-screen UI over that output before there was any real chance
    # to read it — looked exactly like the command had silently
    # failed, when it had actually run fine. `read` with no real
    # terminal attached (a test, a pipe) returns immediately on EOF
    # rather than hanging, so this doesn't need a timeout to stay
    # test-safe.
    exec zsh -c 'printf "\033[?1049l\033[?25h" 2>/dev/null; "$1"; printf "\033[?1049l\033[?25h" 2>/dev/null; printf "\n\033[2mPress any key to return to brew-launcher...\033[0m"; read -k 1 -s 2>/dev/null; exec "$2"' -- "$command_path" "$SCRIPT_PATH"
}

# ------------------------------------------------------------
# Launch application in tmux
#
# Only gives the "picker survives, tool opens alongside it" benefit
# when you're already inside a tmux session ($TMUX set) — the same
# idea as launch_in_ghostty's new tab, just terminal-agnostic instead
# of tied to one app. Outside of a session, this deliberately falls
# back to the plain current-terminal behavior rather than starting one
# for you: bootstrapping brew-launcher into its own tmux session
# behind your back is exactly the kind of surprising, install-
# dependent behavior this project has avoided everywhere else, and
# would be genuinely disruptive to anyone already running their own
# tmux elsewhere, or not using tmux at all.
# ------------------------------------------------------------

launch_in_tmux() {

    local command_path="$1"

    if [[ -z "$TMUX" ]]; then
        launch_in_current_terminal "$command_path"
        return $?
    fi

    # Same fresh-launcher-instead-of-plain-shell fix as the other two
    # launch paths: run the command, then fall through to a fresh
    # instance of the launcher in the new window, rather than exec-ing
    # straight into it or leaving a bare shell behind. tmux runs this
    # string through a shell itself, so both paths are quoted with
    # zsh's own (q) flag — the same tool already used to build the
    # details pane's --preview command — rather than interpolated raw,
    # so either one containing spaces still arrives as one argument.
    # The printfs around the command exit alternate-screen mode and
    # show the cursor, and the read pauses for a keypress before the
    # relaunch — see launch_in_current_terminal for why all three
    # matter. The *before* one is a no-op here specifically: a brand
    # new tmux window never inherited the picker's own alternate-screen
    # state to begin with (each window is its own independent grid),
    # unlike reusing the current pane — kept anyway so all three launch
    # paths stay identical and this doesn't quietly rot if that ever
    # changes.
    tmux new-window "exec zsh -c 'printf \"\033[?1049l\033[?25h\" 2>/dev/null; \"\$1\"; printf \"\033[?1049l\033[?25h\" 2>/dev/null; printf \"\n\033[2mPress any key to return to brew-launcher...\033[0m\"; read -k 1 -s 2>/dev/null; exec \"\$2\"' -- ${(q)command_path} ${(q)SCRIPT_PATH}"
}

# ------------------------------------------------------------
# Launch application in Ghostty
# ------------------------------------------------------------

launch_in_ghostty() {

    local command_path="$1"

    osascript - "$command_path" "$SCRIPT_PATH" <<'APPLESCRIPT'
on run argv

    set commandPath to item 1 of argv
    set launcherPath to item 2 of argv

    tell application "Ghostty"

        activate

        if (count of windows) = 0 then

            set newWindow to new window
            set newTerminal to focused terminal of newWindow

        else

            set newTab to new tab in front window
            set newTerminal to focused terminal of newTab

        end if

        -- Same reasoning as launch_in_current_terminal: run the
        -- command, then fall through to a fresh instance of the
        -- launcher in the same tab, rather than exec-ing straight
        -- into it or leaving a bare shell behind. A one-shot CLI
        -- (eza, jq, bat, ...) prints and exits in under a second;
        -- exec-ing into it left the tab with no process to show for
        -- it, so it looked broken. The printfs around the command
        -- exit alternate-screen mode and show the cursor again — see
        -- launch_in_current_terminal for why both matter (the
        -- *before* one is a no-op here specifically, since a brand
        -- new tab/window never inherited the picker's own alternate
        -- screen, but kept for the same reason as launch_in_tmux:
        -- so all three launch paths stay identical).
        --
        -- \\033, not \033: AppleScript has no numeric escape of its
        -- own (confirmed live — \033 alone is a genuine syntax error
        -- here, "Expected quote but found unknown token"), so this
        -- needs its own literal-backslash escape first to produce the
        -- four real characters \, 0, 3, 3 that the shell on the other
        -- end is the one actually interpreting as an escape code.
        --
        -- The read pauses for a keypress before the relaunch, same as
        -- the other two launch paths — see launch_in_current_terminal
        -- for why (a one-shot CLI's output was getting painted over
        -- before there was any chance to read it).
        input text ("exec zsh -c 'printf \"\\033[?1049l\\033[?25h\" 2>/dev/null; \"$1\"; printf \"\\033[?1049l\\033[?25h\" 2>/dev/null; printf \"\\n\\033[2mPress any key to return to brew-launcher...\\033[0m\"; read -k 1 -s 2>/dev/null; exec \"$2\"' -- " & quoted form of commandPath & " " & quoted form of launcherPath) to newTerminal

        send key "enter" to newTerminal

    end tell

end run
APPLESCRIPT

    return $?
}

# ------------------------------------------------------------
# Backup — one archive with everything needed to rebuild this exact
# setup on a fresh machine.
#
# `brew bundle
# dump` already covers "what's installed" (formulae, casks, taps —
# including the tap this launcher itself came from, so a restore pulls
# it back in too); it has no idea this launcher exists, so it can't
# capture categories, presets, hidden entries, favorites, or theme.
# Those all live under one place, $CONFIG_DIR, entirely as plain files
# (see CATEGORIES_DIR/PRESETS_DIR/SHOWN_FILE/CATEGORY_EXCLUDE_FILE/
# CONFIG_FILE above) — so backing up "everything this launcher
# remembers" is just copying that whole directory wholesale, no need
# to enumerate its contents by hand or keep this in sync as more state
# files get added later. $CACHE_DIR is deliberately left out: it's
# derived, rebuilt automatically, and would only bloat the archive.
#
# Restore is left as a manual two-step rather than a launcher action
# of its own, deliberately out of scope for now:
# untar this file, then `brew bundle install --file=Brewfile` plus
# copying brew-launcher-config back to $CONFIG_DIR. Restoring only
# ever happens once per fresh machine, so it doesn't need to be one
# keypress, and it's inherently higher-stakes (it can overwrite
# current config) than creating a backup ever is.
# ------------------------------------------------------------

create_backup() {

    if ! command -v brew >/dev/null 2>&1; then
        printf '\n'
        printf 'Homebrew not found — nothing to back up.\n'
        sleep 2
        return 1
    fi

    local staging
    staging="$(mktemp -d)" || return 1

    # Everything that actually goes in the archive lives under its own
    # payload/ subdirectory, one level below $staging itself — so the
    # tar step below (which archives that subdirectory's contents, not
    # $staging's) never picks up the two log files sitting alongside
    # it, only what's meant to be backed up.
    local payload="$staging/payload"
    mkdir -p "$payload"

    printf '\n'
    printf 'Backing up...\n'

    if ! brew bundle dump --file="$payload/Brewfile" --force \
         >"$staging/bundle-output.txt" 2>&1; then
        printf '\n'
        printf 'brew bundle dump failed:\n'
        cat "$staging/bundle-output.txt" 2>/dev/null
        rm -rf "$staging"
        sleep 2
        return 1
    fi

    [[ -d "$CONFIG_DIR" ]] && cp -R "$CONFIG_DIR" "$payload/brew-launcher-config"

    if ! tar -czf "$BACKUP_FILE" -C "$payload" . 2>"$staging/tar-error.txt"; then
        printf '\n'
        printf 'Could not write backup archive:\n'
        cat "$staging/tar-error.txt" 2>/dev/null
        rm -rf "$staging"
        sleep 2
        return 1
    fi

    rm -rf "$staging"

    local backup_size
    backup_size="$(du -h "$BACKUP_FILE" 2>/dev/null | awk '{print $1}')"

    printf '\n'
    printf 'Backup saved: %s (%s)\n' "$BACKUP_FILE" "${backup_size:-?}"
    printf 'Contains a Brewfile (formulae, casks, taps) and\n'
    printf 'brew-launcher'\''s own config (categories, presets, hidden\n'
    printf 'entries, theme).\n'
    printf '\n'
    printf 'To restore on a fresh machine: untar it, run\n'
    printf '  brew bundle install --file=Brewfile\n'
    printf 'then copy brew-launcher-config back to\n'
    printf '  %s\n' "$CONFIG_DIR"
    sleep 2
}

# ------------------------------------------------------------
# Create macOS .command shortcut
# ------------------------------------------------------------

create_shortcut() {

    local command="$1"
    local formula="$2"

    case "$(uname -s)" in
        Darwin) create_macos_shortcut "$command" "$formula" ;;
        Linux)  create_linux_shortcut "$command" "$formula" ;;
        *)
            printf '\n'
            printf 'Shortcuts are only supported on macOS and Linux.\n'
            sleep 1
            return 1
            ;;
    esac
}

create_macos_shortcut() {

    local command="$1"
    local formula="$2"

    local shortcut_dir="/Applications/TUIs"

    if ! mkdir -p "$shortcut_dir" 2>/dev/null; then
        printf '\n'
        printf 'Unable to create shortcut directory:\n'
        printf '%s\n' "$shortcut_dir"
        printf 'Check that you have permission to write to /Applications.\n'
        sleep 2
        return 1
    fi

    local filename

    if [[ "$formula" == "$command" ]]; then
        filename="${formula}.command"
    else
        filename="${formula}-${command}.command"
    fi

    local shortcut_path="${shortcut_dir}/${filename}"

    if [[ -e "$shortcut_path" ]]; then
        printf '\n'
        printf 'Shortcut already exists:\n'
        printf '%s\n' "$shortcut_path"
        sleep 2
        return 0
    fi

    local command_path
    command_path="$(command -v "$command" 2>/dev/null)"

    if [[ -z "$command_path" ]]; then
        printf '\n'
        printf 'Unable to find command: %s\n' "$command"
        sleep 2
        return 1
    fi

    # Same fix as launch_in_current_terminal / launch_in_ghostty
    # (0.8.0): run the command, then fall through to a fresh
    # interactive shell, rather than exec-ing straight into it. A
    # one-shot CLI shortcut would otherwise print its output and close
    # the Terminal.app window before you could read it. The printf
    # before that fresh shell exits alternate-screen mode and shows
    # the cursor again — see launch_in_current_terminal for why.
    if ! cat > "$shortcut_path" <<EOF
#!/bin/zsh
exec zsh -c '"\$1"; printf "\033[?1049l\033[?25h" 2>/dev/null; exec zsh' -- "$command_path"
EOF
    then
        printf '\n'
        printf 'Unable to create shortcut:\n'
        printf '%s\n' "$shortcut_path"
        sleep 2
        return 1
    fi

    if ! chmod +x "$shortcut_path"; then
        rm -f "$shortcut_path"

        printf '\n'
        printf 'Unable to make shortcut executable:\n'
        printf '%s\n' "$shortcut_path"
        sleep 2
        return 1
    fi

    printf '\n'
    printf 'Created shortcut:\n'
    printf '%s\n' "$shortcut_path"
    sleep 2
}

create_linux_shortcut() {

    local command="$1"
    local formula="$2"

    # ~/.local/share/applications is the XDG-conventional location for
    # user-installed .desktop entries — every major desktop environment
    # (GNOME, KDE, XFCE, ...) already watches it and lists what's there
    # in its application menu with no further setup, matching what
    # /Applications/TUIs gives on macOS.
    local apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

    # The wrapper script lives separately from the .desktop file itself
    # (same idea as the macOS .command file) rather than embedding the
    # launch command directly in the .desktop's Exec= line. Exec= isn't
    # run through a shell by the spec, and its quoting rules are a
    # genuine source of bugs across desktop environments — a bare path
    # to a real, self-contained script sidesteps that entirely.
    local scripts_dir="${XDG_DATA_HOME:-$HOME/.local/share}/brew-launcher/shortcuts"

    if ! mkdir -p "$apps_dir" "$scripts_dir" 2>/dev/null; then
        printf '\n'
        printf 'Unable to create shortcut directories:\n'
        printf '%s\n' "$apps_dir"
        printf '%s\n' "$scripts_dir"
        sleep 2
        return 1
    fi

    local basename

    if [[ "$formula" == "$command" ]]; then
        basename="$formula"
    else
        basename="${formula}-${command}"
    fi

    local desktop_path="${apps_dir}/brew-launcher-${basename}.desktop"
    local script_path="${scripts_dir}/${basename}.sh"

    if [[ -e "$desktop_path" ]]; then
        printf '\n'
        printf 'Shortcut already exists:\n'
        printf '%s\n' "$desktop_path"
        sleep 2
        return 0
    fi

    local command_path
    command_path="$(command -v "$command" 2>/dev/null)"

    if [[ -z "$command_path" ]]; then
        printf '\n'
        printf 'Unable to find command: %s\n' "$command"
        sleep 2
        return 1
    fi

    local display_name="$formula"
    [[ "$formula" != "$command" ]] && display_name="$formula ($command)"

    # Same fix as create_macos_shortcut and both launch_in_* functions
    # (0.8.0): run the command, then fall through to a fresh
    # interactive shell in the same terminal window, rather than
    # exec-ing straight into it — otherwise a one-shot CLI prints its
    # output and the window closes before there's anything to read.
    # The printf before that fresh shell exits alternate-screen mode
    # and shows the cursor again — see launch_in_current_terminal.
    if ! cat > "$script_path" <<EOF
#!/usr/bin/env zsh
exec zsh -c '"\$1"; printf "\033[?1049l\033[?25h" 2>/dev/null; exec zsh' -- "$command_path"
EOF
    then
        printf '\n'
        printf 'Unable to create shortcut:\n'
        printf '%s\n' "$script_path"
        sleep 2
        return 1
    fi

    if ! chmod +x "$script_path"; then
        rm -f "$script_path"

        printf '\n'
        printf 'Unable to make shortcut executable:\n'
        printf '%s\n' "$script_path"
        sleep 2
        return 1
    fi

    # Terminal=true is what tells the desktop environment to open this
    # inside its configured terminal emulator rather than trying to run
    # a windowless process — without it, a TUI or CLI launched from the
    # applications menu would have nowhere to show its output at all.
    # Icon is a generic, near-universally-present freedesktop icon name
    # rather than nothing; a missing icon theme entry fails silently,
    # it doesn't break the shortcut.
    if ! cat > "$desktop_path" <<EOF
[Desktop Entry]
Type=Application
Name=$display_name
Comment=Launch $display_name via brew-launcher
Exec=$script_path
Terminal=true
Categories=Utility;
Icon=utilities-terminal
EOF
    then
        rm -f "$script_path"

        printf '\n'
        printf 'Unable to create shortcut:\n'
        printf '%s\n' "$desktop_path"
        sleep 2
        return 1
    fi

    chmod +x "$desktop_path" 2>/dev/null

    printf '\n'
    printf 'Created shortcut:\n'
    printf '%s\n' "$desktop_path"
    sleep 2
}

# ------------------------------------------------------------
# Remove one exact line from a plain one-command-per-line file, if
# present. Shared by unhide_entry (IGNORE_FILE) and hide_entry
# (SHOWN_FILE) — same operation, just reversing whichever kind of
# hidden state is currently in play for that command.
# ------------------------------------------------------------

remove_line_from_file() {

    local file="$1" target="$2" tmp

    [[ -f "$file" ]] || return 0

    tmp="$(mktemp "$CACHE_DIR/removeline.XXXXXX")" || return 1

    python3 - "$file" "$tmp" "$target" <<'PY'
import sys

source_file = sys.argv[1]
output_file = sys.argv[2]
target = sys.argv[3]

with open(source_file, "r", encoding="utf-8") as f:
    lines = f.readlines()

with open(output_file, "w", encoding="utf-8") as f:
    for line in lines:
        if line.strip() == target:
            continue
        f.write(line)
PY

    mv "$tmp" "$file"
}

# ------------------------------------------------------------
# Hide an application entry
# ------------------------------------------------------------

hide_entry() {

    local command="$1"

    mkdir -p "$CONFIG_DIR"

    # Hidden only via the bundled default, currently overridden to show
    # (see SHOWN_FILE) — hiding it again just means dropping that
    # override and reverting to the bundled default, not also adding a
    # redundant IGNORE_FILE line for a command that's already hidden.
    if [[ -n "${bundled_hidden_commands[$command]-}" && -n "${shown_commands[$command]-}" ]]; then
        remove_line_from_file "$SHOWN_FILE" "$command"
        return 0
    fi

    # Do not add the same command more than once.
    if [[ -f "$IGNORE_FILE" ]] &&
       grep -Fqx "$command" "$IGNORE_FILE" 2>/dev/null; then
        return 0
    fi

    printf '%s\n' "$command" >> "$IGNORE_FILE"
}


# ------------------------------------------------------------
# Restore a hidden application entry
# ------------------------------------------------------------

unhide_entry() {

    local command="$1"

    if [[ -f "$IGNORE_FILE" ]] && grep -Fqx "$command" "$IGNORE_FILE" 2>/dev/null; then
        remove_line_from_file "$IGNORE_FILE" "$command"
        return 0
    fi

    # Not in IGNORE_FILE — the only other way this could be hidden is
    # the bundled default, so "unhiding" means recording an explicit
    # override instead of editing a line that was never there.
    if [[ -n "${bundled_hidden_commands[$command]-}" ]]; then
        mkdir -p "$CONFIG_DIR"
        if ! grep -Fqx "$command" "$SHOWN_FILE" 2>/dev/null; then
            printf '%s\n' "$command" >> "$SHOWN_FILE"
        fi
    fi
}

# ------------------------------------------------------------
# Set (or replace) one KEY=value line in the config file, preserving
# every other line — comments and the other setting included.
#
# Written generically (any key, any value) even though only THEME
# calls it today, so persisting a terminal choice from in-app later
# is a one-line addition, not a new function.
# ------------------------------------------------------------

set_config_value() {

    local key="$1" value="$2"
    local tmp_config line line_key found=false

    mkdir -p "$CONFIG_DIR"

    tmp_config="$(mktemp "$CACHE_DIR/config.XXXXXX")" || return 1

    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS= read -r line; do

            line_key="${line%%=*}"
            line_key="${line_key#"${line_key%%[![:space:]]*}"}"
            line_key="${line_key%"${line_key##*[![:space:]]}"}"

            if [[ "$line_key" == "$key" && "$line" != \#* ]]; then
                print -r -- "$key=$value" >> "$tmp_config"
                found=true
            else
                print -r -- "$line" >> "$tmp_config"
            fi

        done < "$CONFIG_FILE"
    fi

    [[ "$found" == false ]] && print -r -- "$key=$value" >> "$tmp_config"

    mv "$tmp_config" "$CONFIG_FILE"
}

# ------------------------------------------------------------
# Set (or clear) one command's custom launch flags — same
# find-or-append idea as set_config_value() above, keyed on the first
# tab-separated field instead of "key=". Clearing (flags == "") drops
# the line entirely rather than writing an empty value, since an empty
# string and "no custom flags at all" mean the same thing everywhere
# else this is read (launch_flags[$command] unset either way).
# ------------------------------------------------------------

set_launch_flags() {

    local command="$1" flags="$2"
    local tmp_flags line line_command found=false

    mkdir -p "$CONFIG_DIR"

    tmp_flags="$(mktemp "$CACHE_DIR/launch-flags.XXXXXX")" || return 1

    if [[ -f "$LAUNCH_FLAGS_FILE" ]]; then
        while IFS= read -r line; do

            line_command="${line%%$'\t'*}"

            if [[ "$line_command" == "$command" ]]; then
                found=true
                [[ -n "$flags" ]] && printf '%s\t%s\n' "$command" "$flags" >> "$tmp_flags"
            else
                print -r -- "$line" >> "$tmp_flags"
            fi

        done < "$LAUNCH_FLAGS_FILE"
    fi

    [[ "$found" == false && -n "$flags" ]] && printf '%s\t%s\n' "$command" "$flags" >> "$tmp_flags"

    mv "$tmp_flags" "$LAUNCH_FLAGS_FILE"

    if [[ -n "$flags" ]]; then
        launch_flags[$command]="$flags"
    else
        unset "launch_flags[$command]"
    fi
}

# ------------------------------------------------------------
# Launch Flags prompt — Actions -> Launch Flags, for the highlighted
# entry: extra arguments to always pass when it launches.
#
# Prefilled with the current flags (if any), same "type over what's
# already there" idiom as rename_category(). Unlike every other
# prompt here, though, an empty result is a genuinely different,
# valid answer from Cancel: typing nothing and pressing Enter means
# "clear the flags," not "never mind." Every existing prompt collapses
# those two (an empty typed name is always invalid, so Esc and
# empty-Enter both just mean cancel) — this one can't, so it reads the
# pressed key explicitly via --expect instead of inferring it from
# whether the result string is empty.
# ------------------------------------------------------------

pick_launch_flags() {

    local command="$1"
    local current="${launch_flags[$command]-}"
    local fzf_result typed pick_action
    local -a result_lines

    rm -f "$FOOTER_CLICK_FILE"

    fzf_result="$(
        printf '%s\n' "$current" |
        fzf \
            --print-query \
            --query="$current" \
            --expect=enter,esc \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label "Launch flags — $command")" \
            --border-label-pos=2 \
            --prompt=' Flags: ' \
            --header="Extra arguments to always pass when launching $command. Blank clears it." \
            --footer='  Type  Flags    Enter  [Save]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --pointer='▌' \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    result_lines=("${(@f)fzf_result}")
    typed="${result_lines[1]}"
    pick_action="${result_lines[2]}"

    [[ "$pick_action" != "enter" ]] && return 1
    [[ "$typed" == "$current" ]] && return 1

    # A literal tab can't normally reach here from a single-line query
    # box, but flattened defensively anyway — same reasoning
    # cache_writer.py already gives for collapsing one in a formula
    # description: LAUNCH_FLAGS_FILE is tab-separated, and an embedded
    # tab in the value would shift or split the row.
    typed="${typed//$'\t'/ }"

    set_launch_flags "$command" "$typed"

    printf '\n'
    if [[ -n "$typed" ]]; then
        printf 'Will always launch %s with: %s\n' "$command" "$typed"
    else
        printf 'Cleared custom launch flags for %s.\n' "$command"
    fi
    sleep 1
}

# ------------------------------------------------------------
# Run With Args — Actions -> Run With Args, for the highlighted entry:
# launches it right now with extra arguments, just this once.
#
# Deliberately separate from Launch Flags above, not a variant of it:
# Launch Flags is a standing choice (always these flags, every time,
# until changed); this is a one-off (these flags, just this once,
# forgotten immediately after). Prefilled with the current Launch
# Flags value, if any, as a convenient starting point — not because
# the two are the same setting, just because starting from "what I'd
# normally run" and adjusting it for one run is the common case.
#
# Same "distinguish Esc from a real empty answer" shape as
# pick_launch_flags(), except here an empty answer is a completely
# ordinary one (run it plain, same as Enter on the main list) rather
# than a special "clear" action — there's nothing stored to clear.
#
# Builds its own throwaway wrapper when args were actually typed,
# same self-deleting idiom as resolve_launch_path()/update_all(), then
# dispatches through the same current-terminal/tmux/ghostty three-way
# branch the main loop's own Enter already uses — duplicated here
# rather than factored out, same call this project already made for
# update_all()'s identical duplication: three small, independent
# copies are lower-risk than reshaping the one Enter-handling block
# every ordinary launch already goes through correctly today.
# ------------------------------------------------------------

run_with_args() {

    local command="$1" resolved_path="$2"
    local current="${launch_flags[$command]-}"
    local fzf_result typed pick_action launch_path
    local -a result_lines

    rm -f "$FOOTER_CLICK_FILE"

    fzf_result="$(
        printf '%s\n' "$current" |
        fzf \
            --print-query \
            --query="$current" \
            --expect=enter,esc \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label "Run $command with...")" \
            --border-label-pos=2 \
            --prompt=' Args: ' \
            --header="Extra arguments for this one launch of $command. Blank runs it plain. F3 / ⌥D previews its own --help." \
            --footer='  Type  Args    Enter  [Run]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --preview "${(q)SCRIPT_PATH} --internal-preview-usage ${(q)resolved_path}" \
            --preview-window='hidden,70%,border-rounded' \
            --bind 'f3,alt-d:toggle-preview' \
            --pointer='▌' \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    result_lines=("${(@f)fzf_result}")
    typed="${result_lines[1]}"
    pick_action="${result_lines[2]}"

    [[ "$pick_action" != "enter" ]] && return 1

    typed="${typed//$'\t'/ }"

    launch_path="$resolved_path"

    if [[ -n "$typed" ]]; then

        local wrapper
        wrapper="$(mktemp "$CACHE_DIR/run-with-args.XXXXXX")" || return 1

        cat > "$wrapper" <<EOF
#!/bin/zsh
${(q)resolved_path} $typed
rm -f -- "\$0"
EOF

        chmod +x "$wrapper"
        launch_path="$wrapper"
    fi

    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$command" >> "$LAUNCH_HISTORY_FILE"
    (( launch_counts[$command]++ ))
    last_launched_order[$command]=$(( ++LAST_LAUNCHED_COUNTER ))

    if [[ "$TERMINAL" == "current" ]]; then

        launch_in_current_terminal "$launch_path"

    elif [[ "$TERMINAL" == "ghostty" ]]; then

        if ! launch_in_ghostty "$launch_path"; then
            printf '\n'
            printf 'Unable to launch: %s\n' "$command"
            printf 'Make sure Ghostty is installed and macOS allows\n'
            printf 'brew-launcher to control Ghostty.\n'
            sleep 2
        fi

    elif [[ "$TERMINAL" == "tmux" ]]; then

        if ! launch_in_tmux "$launch_path"; then
            printf '\n'
            printf 'Unable to launch: %s\n' "$command"
            sleep 2
        fi

    fi
}

# ------------------------------------------------------------
# Confirm relaunching to apply a config change that's already been
# written — colors are resolved once at startup, so nothing on screen
# updates until the process restarts. Not a destructive action (only
# the current cursor position/view is lost, not any data), so unlike
# confirm_delete_category() the safe default isn't "Cancel first" —
# applying now is the expected, ordinary choice.
# ------------------------------------------------------------

confirm_relaunch() {

    local message="$1"
    local answer

    answer="$(
        printf '%s\n' "Relaunch now" "Not now" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Apply change')" \
            --border-label-pos=2 \
            --prompt='  ' \
            --pointer='▌' \
            --header="$message Takes effect on next launch." \
            `# "Enter chooses" is deliberately not bracketed/clickable:` \
            `# Enter acts on the highlighted row, so a clickable` \
            `# [Confirm] would relaunch whenever "Not now" was highlighted.` \
            --footer='  ↑ ↓  Navigate    Enter  chooses    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ "$answer" == "Relaunch now" ]]
}

# ------------------------------------------------------------
# Confirm before Esc actually quits the launcher (from "All", with no
# pinned details pane in the way — see the main loop's own Esc
# handler for exactly when this is reached).
#
# Esc is
# the single most-pressed key for "go back one level" everywhere else
# in the app (closing the details pane, backing out of a category, out
# of Actions/Settings...), so on "All" — the one screen with nowhere
# further back to go — it's an easy habitual overshoot. Cancel is
# listed first (the safe, do-nothing default) and Esc here also means
# Cancel, same convention as confirm_delete_category()/
# confirm_relaunch() above — a second stray Esc lands you back on the
# list, not out of the app.
# ------------------------------------------------------------

confirm_quit() {

    local answer

    answer="$(
        printf '%s\n' "Cancel" "Quit brew-launcher" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Quit?')" \
            --border-label-pos=2 \
            --prompt='  ' \
            --pointer='▌' \
            `# "Enter chooses" is deliberately not bracketed/clickable:` \
            `# Enter acts on the highlighted row, so a clickable` \
            `# [Confirm] would quit whenever Cancel was highlighted.` \
            --footer='  ↑ ↓  Navigate    Enter  chooses    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ "$answer" == "Quit brew-launcher" ]]
}

# Same Cancel-first convention as confirm_quit()/confirm_delete_category()
# above — Update All isn't destructive, but it's a real, not-instant
# operation (network + possibly compiling), so it gets a confirm the
# same way anything with a real consequence does here.
confirm_update_all() {

    local count="$1"
    local noun="formulae"
    local answer

    (( count == 1 )) && noun="formula"

    answer="$(
        printf '%s\n' "Cancel" "Update all $count $noun" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Update All')" \
            --border-label-pos=2 \
            --prompt='  ' \
            --pointer='▌' \
            --header="Runs brew upgrade for everything outdated — can take a while." \
            `# Same reasoning as confirm_relaunch/confirm_quit above:` \
            `# "Enter chooses" stays unbracketed/unclickable so a` \
            `# clickable [Confirm] can't fire while Cancel is highlighted.` \
            --footer='  ↑ ↓  Navigate    Enter  chooses    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ "$answer" == "Update all $count $noun" ]]
}

# ------------------------------------------------------------
# Update All — Actions -> Update All. Runs `brew upgrade` for
# everything outdated.
#
# Reuses the three existing launch paths (current terminal/tmux/
# Ghostty) a normal tool launch already goes through, via a throwaway
# self-deleting script — those functions are built around "one
# already-resolved binary, no arguments," not a full command line, and
# generalizing them to accept arguments would mean touching three
# carefully-tuned, security-reviewed functions for one caller. Writing
# `brew upgrade` to an executable temp file and handing THAT to the
# unmodified launch functions gets the exact same live-output/
# press-any-key/relaunch behavior for free.
#
# Relaunches bare afterward, same as any other tool — not straight
# into a forced --refresh. Tried that first (the script exec-ing its
# own way into `$SCRIPT_PATH --refresh` before returning), on the
# theory that "just upgraded everything" is exactly when stale
# versions/outdated markers would be most misleading — but that relies
# on `exec` inside a command run as a plain foreground step (`"$1"`
# partway through the launch functions' own script) somehow replacing
# the *caller's* process too. It doesn't: `exec` only replaces the
# child actually running the script; once that child exits normally,
# the launch function's own script keeps going right where it left
# off and relaunches bare regardless — confirmed live with a fake
# launcher recording what it was actually invoked with. The cache's
# own freshness check already bounds how stale this can get, and F5 is
# one keypress away in the meantime, so a plain relaunch — no changes
# needed to launch_in_current_terminal/tmux/ghostty at all — is both
# simpler and correct, unlike the version that looked more thorough on
# paper but didn't actually do what it claimed to.
# ------------------------------------------------------------

update_all() {

    local outdated_count=${#outdated_formulas}

    if (( outdated_count == 0 )); then
        printf '\n'
        printf 'Everything is already up to date.\n'
        sleep 1
        return 1
    fi

    confirm_update_all "$outdated_count" || return 1

    local update_script
    update_script="$(mktemp "$CACHE_DIR/update-all.XXXXXX")" || return 1

    cat > "$update_script" <<'EOF'
#!/bin/zsh
brew upgrade
printf '\nDone — press F5 (or reopen) to refresh the list with the new versions.\n'
rm -f -- "$0"
EOF

    chmod +x "$update_script"

    if [[ "$TERMINAL" == "current" ]]; then

        launch_in_current_terminal "$update_script"

    elif [[ "$TERMINAL" == "ghostty" ]]; then

        if ! launch_in_ghostty "$update_script"; then
            printf '\n'
            printf 'Unable to launch Update All.\n'
            printf 'Make sure Ghostty is installed and macOS allows\n'
            printf 'brew-launcher to control Ghostty.\n'
            rm -f "$update_script"
            sleep 2
        fi

    elif [[ "$TERMINAL" == "tmux" ]]; then

        if ! launch_in_tmux "$update_script"; then
            printf '\n'
            printf 'Unable to launch Update All.\n'
            rm -f "$update_script"
            sleep 2
        fi

    fi
}

# ------------------------------------------------------------
# Update — Actions -> Update, for the highlighted entry. Same idea as
# Update All just above, scoped to one formula instead of everything
# outdated: `brew upgrade <formula>` through the same self-deleting-
# wrapper/three-way launch-path trick (see update_all()'s own comment
# for why — generalizing the three launch functions themselves to
# accept a full command line would mean touching three carefully-
# tuned, security-reviewed functions for these two callers).
#
# No confirmation prompt, unlike Update All: scoped to one formula
# rather than everything outdated, this is a smaller, quicker action —
# instant, same as Hide/Favorite, not something worth pausing on.
# Already-up-to-date is a real, expected answer here (the row shows
# regardless of status, same as every other Actions row), not an
# error — just says so and does nothing, same shape as Update All's
# own "nothing to update" case.
# ------------------------------------------------------------

update_tool() {

    local command="$1" formula="$2"

    if [[ -z "${outdated_formulas[$formula]-}" ]]; then
        printf '\n'
        printf '%s is already up to date.\n' "$command"
        sleep 1
        return 1
    fi

    local update_script
    update_script="$(mktemp "$CACHE_DIR/update-tool.XXXXXX")" || return 1

    cat > "$update_script" <<EOF
#!/bin/zsh
brew upgrade ${(q)formula}
printf '\nDone — press F5 (or reopen) to refresh the list with the new version.\n'
rm -f -- "\$0"
EOF

    chmod +x "$update_script"

    if [[ "$TERMINAL" == "current" ]]; then

        launch_in_current_terminal "$update_script"

    elif [[ "$TERMINAL" == "ghostty" ]]; then

        if ! launch_in_ghostty "$update_script"; then
            printf '\n'
            printf 'Unable to launch Update.\n'
            printf 'Make sure Ghostty is installed and macOS allows\n'
            printf 'brew-launcher to control Ghostty.\n'
            rm -f "$update_script"
            sleep 2
        fi

    elif [[ "$TERMINAL" == "tmux" ]]; then

        if ! launch_in_tmux "$update_script"; then
            printf '\n'
            printf 'Unable to launch Update.\n'
            rm -f "$update_script"
            sleep 2
        fi

    fi
}

# ------------------------------------------------------------
# Toggle an entry's Favorites membership
#
# Favorites is an ordinary category file (see load_category_names),
# so this just edits that one file directly — no separate mechanism.
# ------------------------------------------------------------

toggle_favorite() {

    local command="$1"
    local favorites_file="$CATEGORIES_DIR/Favorites"
    local tmp_favorites

    mkdir -p "$CATEGORIES_DIR"

    if [[ -f "$favorites_file" ]] &&
       grep -Fqx "$command" "$favorites_file" 2>/dev/null; then

        # Temp file goes in CACHE_DIR, never CATEGORIES_DIR — every
        # file in the latter is treated as a category by
        # load_category_names, so an interrupted edit would leave a
        # phantom category behind.
        tmp_favorites="$(mktemp "$CACHE_DIR/Favorites.XXXXXX")" || return 1
        grep -Fvx "$command" "$favorites_file" > "$tmp_favorites" 2>/dev/null
        mv "$tmp_favorites" "$favorites_file"

    else

        printf '%s\n' "$command" >> "$favorites_file"
    fi
}

# Same shape as toggle_favorite above, generalized to an arbitrary
# named category — the instant, no-prompt toggle F7 uses when a
# specific category is already active, so it behaves exactly like F6
# does for Favorites instead of always opening the picker/prompt.
toggle_category_direct() {

    local command="$1"
    local category_name="$2"
    local category_file="$CATEGORIES_DIR/$category_name"
    local tmp_category

    mkdir -p "$CATEGORIES_DIR"

    if [[ -f "$category_file" ]] &&
       grep -Fqx "$command" "$category_file" 2>/dev/null; then

        # CACHE_DIR, not CATEGORIES_DIR — see toggle_favorite above.
        tmp_category="$(mktemp "$CACHE_DIR/category.XXXXXX")" || return 1
        grep -Fvx "$command" "$category_file" > "$tmp_category" 2>/dev/null
        mv "$tmp_category" "$category_file"

    elif [[ "${default_category_commands[$command]-}" == "$category_name" ]]; then

        # Only a member here via the bundled default (see
        # load_bundled_categories) — there's no real line to remove,
        # so "removing" it means excluding it from the bundled
        # assignment instead. Adding a real line here would just leave
        # it looking unchanged, since it was already showing up.
        mkdir -p "$CONFIG_DIR"
        if ! grep -Fqx "$command" "$CATEGORY_EXCLUDE_FILE" 2>/dev/null; then
            printf '%s\n' "$command" >> "$CATEGORY_EXCLUDE_FILE"
        fi

    else

        printf '%s\n' "$command" >> "$category_file"
    fi
}

# ------------------------------------------------------------
# Prompts for a category name — typed or picked from existing ones —
# with the validation (no "/", no leading ".", not a built-in view
# name) that used to live inline in toggle_category(). Pulled out so
# bulk_categorize() below can reuse the exact same prompt once for a
# whole marked batch, instead of toggle_category() asking once per
# entry.
#
# Uses fzf's own --print-query: if the typed text matches an existing
# category it's selected normally; if it matches nothing, Enter still
# exits and --print-query reports the typed text, which is treated as
# a brand-new category name and created on the spot.
#
# Prints the validated name on success, nothing on cancel/invalid —
# callers should treat empty as "stop, nothing to do."
# ------------------------------------------------------------

pick_category_name() {

    local category_name
    local default_query=""
    local name
    local choices=()

    # Favorites is excluded from this list entirely — F6 is the only
    # key allowed to touch Favorites membership. This prompt is only
    # ever reached while on "All" or while viewing Favorites itself
    # (see the F7 dispatch above), and in neither case is there a
    # non-Favorites category to default to, so default_query is left
    # blank rather than pointed at a category that isn't even a
    # choice anymore.
    for name in "${CATEGORY_NAMES[@]}"; do
        [[ "$name" == "Favorites" ]] && continue
        choices+=("$name")
    done

    rm -f "$FOOTER_CLICK_FILE"

    category_name="$(
        printf '%s\n' "${choices[@]}" |
        fzf \
            --print-query \
            --query="$default_query" \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Categorize')" \
            --border-label-pos=2 \
            --prompt=' New or existing: ' \
            --footer='  ↑ ↓  Navigate    Type  New name or pick one    Enter  [Categorize]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --pointer='▌' \
            --color="$FZF_COLORS" |
        tail -n1
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$category_name" ]] && return 1

    # The typed name becomes a filename directly, so reject anything
    # that would escape CATEGORIES_DIR or silently fail. A "/" is an
    # easy typo ("Games/Action") that would otherwise fail with no
    # feedback at all, which reads as the key being broken.
    if [[ "$category_name" == */* || "$category_name" == .* ]]; then
        printf '\n'
        printf 'Invalid category name: %s\n' "$category_name"
        printf 'Names cannot contain "/" or start with ".".\n'
        sleep 2
        return 1
    fi

    # These are all built-in view names, not category files. A
    # category with any of these names would show up twice in the
    # view picker, be shadowed by the built-in view (so its members
    # were unreachable), and be undeletable, since Ctrl-D refuses
    # those names. Refuse to create the trap in the first place.
    if [[ "$category_name" == "All" || "$category_name" == "Hidden" \
          || "$category_name" == "Most Used" || "$category_name" == "Recently Added" \
          || "$category_name" == "Recently Launched" ]]; then
        printf '\n'
        printf '"%s" is a built-in view name.\n' "$category_name"
        printf 'Pick a different category name.\n'
        sleep 2
        return 1
    fi

    printf '%s' "$category_name"
}

# ------------------------------------------------------------
# Toggle an entry's membership in a category by name, typed or picked
#
# Same add/remove toggle as toggle_favorite, generalized to any
# category — picking or typing a category the entry is already in
# removes it instead of being a no-op. That's how you unassign a
# category: press F8/⌥C again and pick/type the same one.
#
# Return code notes what happened: 0 = added, 2 = removed, 1 =
# cancelled (no category chosen). Not currently used by the caller —
# F7 always just refreshes in place regardless of which happened —
# kept for whoever's debugging next.
# ------------------------------------------------------------

toggle_category() {

    local command="$1"
    local category_name
    local tmp_category

    category_name="$(pick_category_name)" || return 1

    mkdir -p "$CATEGORIES_DIR"

    local category_file="$CATEGORIES_DIR/$category_name"

    if [[ -f "$category_file" ]] &&
       grep -Fqx "$command" "$category_file" 2>/dev/null; then

        # CACHE_DIR, not CATEGORIES_DIR — see toggle_favorite above.
        tmp_category="$(mktemp "$CACHE_DIR/category.XXXXXX")" || return 1
        grep -Fvx "$command" "$category_file" > "$tmp_category" 2>/dev/null
        mv "$tmp_category" "$category_file"
        return 2

    elif [[ "${default_category_commands[$command]-}" == "$category_name" ]]; then

        # Same bundled-only case as toggle_category_direct above —
        # picking the category it's already (virtually) in means
        # excluding it, not adding a redundant real line.
        mkdir -p "$CONFIG_DIR"
        if ! grep -Fqx "$command" "$CATEGORY_EXCLUDE_FILE" 2>/dev/null; then
            printf '%s\n' "$command" >> "$CATEGORY_EXCLUDE_FILE"
        fi
        return 2

    else

        printf '%s\n' "$command" >> "$category_file"
        return 0
    fi
}

# ------------------------------------------------------------
# "Ensure membership" counterparts to toggle_favorite()/
# toggle_category_direct() above — add only, never remove, a no-op if
# already a member. Used by the bulk_* actions below: a bulk action
# marks a batch and moves everything in it to the SAME end state
# (favorited / in this category), rather than toggling each one
# individually based on whatever state it happened to already be in —
# see bulk_favorite()/bulk_categorize() for why that's the right
# default for a batch you just selected together.
# ------------------------------------------------------------

add_to_favorites() {

    local command="$1"
    local favorites_file="$CATEGORIES_DIR/Favorites"

    [[ -f "$favorites_file" ]] &&
        grep -Fqx "$command" "$favorites_file" 2>/dev/null &&
        return 0

    mkdir -p "$CATEGORIES_DIR"
    printf '%s\n' "$command" >> "$favorites_file"
}

add_to_category() {

    local command="$1" category_name="$2"
    local category_file="$CATEGORIES_DIR/$category_name"

    [[ -f "$category_file" ]] &&
        grep -Fqx "$command" "$category_file" 2>/dev/null &&
        return 0

    # Already a member via the bundled default (and not excluded from
    # it) — same "virtually already there" case toggle_category_direct()
    # checks, just without the toggle: nothing to add.
    if [[ "${default_category_commands[$command]-}" == "$category_name" ]] &&
       ! grep -Fqx "$command" "$CATEGORY_EXCLUDE_FILE" 2>/dev/null; then
        return 0
    fi

    mkdir -p "$CATEGORIES_DIR"
    printf '%s\n' "$command" >> "$category_file"
}

# ------------------------------------------------------------
# Shared multi-select picker for the bulk Hide/Favorite/Categorize
# actions below, bringing the same Tab-to-mark idea Create Preset uses
# to these three actions.
#
# Deliberately NOT Create Preset's own custom ordered-badge mechanism
# (--internal-preset-tab and its side-channel state file) — that exists
# solely because a preset's *launch order* matters. None of Hide,
# Favorite, or Categorize care about order, only membership, so fzf's
# own built-in --multi does the whole job: Tab marks/unmarks, Enter
# outputs every marked line (or just the highlighted one if nothing
# was marked — the ordinary single-entry case, handled for free). No
# state file, no subprocess transform, far less code than presets
# needed for the ordering it actually requires.
#
# Operates on whatever's currently on screen ($entries, i.e. whatever
# CURRENT_VIEW already filtered to) rather than always resetting to
# "All" the way Create Preset does — a preset draws from the whole
# toolset by design, but bulk-hiding/favoriting/categorizing only what
# you're already looking at (e.g. a handful of entries in "Games")
# reads as the more useful default, and "All" is always one F2 press
# away if that's what's wanted instead.
#
# Prints each marked entry (still the full tab-delimited $entries line)
# on its own line, or nothing at all if Esc was pressed.
# ------------------------------------------------------------

pick_multiple_entries() {

    local border_label="$1" action_verb="$2"

    rm -f "$FOOTER_CLICK_FILE"

    printf '%s\n' "${entries[@]}" |
    fzf \
        --height=100% \
        --no-clear \
        --layout=reverse \
        --border=rounded \
        --border-label="$(screen_border_label "$border_label")" \
        --border-label-pos=2 \
        --prompt=' 󰣇  ' \
        --pointer='▌' \
        --delimiter=$'\t' \
        --with-nth=2 \
        --nth=1,2,3,4 \
        --multi \
        --header="Tab marks a tool. Enter acts on everything marked (or just this row, if nothing's marked)." \
        --footer="  ↑ ↓  Navigate    Tab  Mark/unmark    Enter  [${action_verb}]    Esc  [Cancel]" \
        --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
        --color="$FZF_COLORS"

    rm -f "$FOOTER_CLICK_FILE"
}

# ------------------------------------------------------------
# Bulk Hide/Unhide — mark several entries, act on all of them at once.
#
# Relabels to "Unhide multiple" while viewing Hidden, same idea as F6's
# own per-entry hide_label. hide_entry()/unhide_entry() are already
# each idempotent ("ensure hidden" / "ensure shown" regardless of
# which of the two hidden-state mechanisms — IGNORE_FILE or a bundled
# default — currently applies), so this can call either unconditionally
# on every marked entry with no extra bookkeeping: a marked entry
# that's already in the target state is just a no-op for that entry.
# ------------------------------------------------------------

bulk_hide() {

    local -a selected=()
    local line command raw_selection
    local border_label='Hide multiple' action_verb='Hide' unhiding=false

    if [[ "$CURRENT_VIEW" == "Hidden" ]]; then
        border_label='Unhide multiple'
        action_verb='Unhide'
        unhiding=true
    fi

    # Esc gives an empty string here — guarded before splitting, since
    # "${(@f)$(...)}" on an empty string yields a one-element array
    # (one empty string), not a zero-element one, in zsh. Skipping this
    # check let bulk_categorize() below fall through to its
    # pick_category_name() prompt even after Esc, opening the "new or
    # existing" naming prompt instead of actually cancelling.
    raw_selection="$(pick_multiple_entries "$border_label" "$action_verb")"
    [[ -n "$raw_selection" ]] && selected=("${(@f)raw_selection}")

    (( ${#selected[@]} == 0 )) && return 1

    for line in "${selected[@]}"; do
        [[ -z "$line" ]] && continue
        command="${line%%$'\t'*}"
        if [[ "$unhiding" == true ]]; then
            unhide_entry "$command"
        else
            hide_entry "$command"
        fi
    done

    load_hidden_commands
    build_entries
}

# ------------------------------------------------------------
# Bulk Favorite/Unfavorite — same shape as bulk_hide() above.
#
# Relabels to "Unfavorite multiple" while viewing Favorites, where
# every entry on screen is necessarily already a member — toggle_favorite()
# there is guaranteed to remove, never add, so it's safe to call
# unconditionally. Everywhere else, add_to_favorites() (ensure-added,
# not a toggle) is used instead — a mixed marked batch (some already
# favorited, some not) ends with all of them favorited, not some newly
# un-favorited by an unlucky toggle. See pick_multiple_entries()'s own
# comment for why this is a plain --multi picker, not Create Preset's
# ordered one.
# ------------------------------------------------------------

bulk_favorite() {

    local -a selected=()
    local line command raw_selection
    local border_label='Favorite multiple' action_verb='Favorite' unfavoriting=false

    if [[ "$CURRENT_VIEW" == "Favorites" ]]; then
        border_label='Unfavorite multiple'
        action_verb='Unfavorite'
        unfavoriting=true
    fi

    # See bulk_hide()'s own comment on why this is split in two steps.
    raw_selection="$(pick_multiple_entries "$border_label" "$action_verb")"
    [[ -n "$raw_selection" ]] && selected=("${(@f)raw_selection}")

    (( ${#selected[@]} == 0 )) && return 1

    for line in "${selected[@]}"; do
        [[ -z "$line" ]] && continue
        command="${line%%$'\t'*}"
        if [[ "$unfavoriting" == true ]]; then
            toggle_favorite "$command"
        else
            add_to_favorites "$command"
        fi
    done

    refresh_category_state
    load_favorite_commands
    load_category_members
    build_entries
}

# ------------------------------------------------------------
# Bulk Categorize — same shape again, but a category also needs a
# *name*, unlike a plain on/off like Hide or Favorite.
#
# While viewing a real category (not All/Hidden/Favorites), every
# entry on screen is already a member of it — same reasoning as
# bulk_favorite() in the Favorites view, this instantly removes the
# marked batch from the category being viewed, mirroring F8's own
# instant per-entry toggle in that same context, no prompt needed.
#
# Everywhere else, pick_category_name() prompts ONCE for the whole
# marked batch (not once per entry — the entire point of doing this in
# bulk), then add_to_category() (ensure-added, not a toggle) files
# every marked entry that isn't already in it. Entries already in that
# category are left alone rather than removed, same "move the whole
# batch to one end state" reasoning as bulk_favorite().
# ------------------------------------------------------------

bulk_categorize() {

    local -a selected=()
    local line command category_name raw_selection

    # See bulk_hide()'s own comment on why this is split in two steps.
    raw_selection="$(pick_multiple_entries 'Categorize multiple' 'Categorize')"
    [[ -n "$raw_selection" ]] && selected=("${(@f)raw_selection}")

    (( ${#selected[@]} == 0 )) && return 1

    if [[ "$CURRENT_VIEW" != "All" && "$CURRENT_VIEW" != "Hidden" && "$CURRENT_VIEW" != "Favorites" ]]; then

        for line in "${selected[@]}"; do
            [[ -z "$line" ]] && continue
            toggle_category_direct "${line%%$'\t'*}" "$CURRENT_VIEW"
        done

    else

        category_name="$(pick_category_name)" || return 1

        for line in "${selected[@]}"; do
            [[ -z "$line" ]] && continue
            add_to_category "${line%%$'\t'*}" "$category_name"
        done
    fi

    refresh_category_state
    load_favorite_commands
    load_category_members
    build_entries
}

# ------------------------------------------------------------
# Create a preset in-app: multi-select which tools it contains, then
# name it. Writes the same plain one-command-per-line file --preset
# already reads — this is just a friendlier way to write that file
# than doing it by hand, not a second mechanism.
# ------------------------------------------------------------

create_preset() {

    # Reachable directly from Actions even without tmux now (see
    # footer_actions() for why that's shown rather than hidden) — a
    # preset built without tmux would only ever error the moment
    # someone tried to launch it, so this is where that gets explained
    # instead, same message as the F9/Launch Preset fallback.
    if [[ "$TMUX_AVAILABLE" == false ]]; then
        printf '\n'
        printf 'Presets need tmux: brew install tmux\n'
        sleep 2
        return 1
    fi

    local -a selected_commands=()
    local fzf_result line
    local preset_name preset_file existing_count overwrite_answer
    local -a existing_presets=()
    local -a result_lines=()
    local pick_valid=false

    # 1. Pick tools from whatever's currently on screen ($entries,
    #    i.e. whatever CURRENT_VIEW already is). Used to
    #    always force CURRENT_VIEW to "All" regardless of context; that
    #    made it the one Actions row whose own picker didn't match what
    #    you were actually looking at, and — since Actions has no
    #    concept of "current entries" when opened from the view picker
    #    (F2) — meant Create Preset was offered there too, over
    #    whatever entries happened to be left over from before. Now
    #    consistent with the bulk_* actions below, and this row is
    #    gated on has_entry (see pick_more_action()) for the same
    #    reason those are: nothing to build from means it shouldn't be
    #    offered at all.
    #
    #    Not fzf's own --multi: that has no concept of order, only
    #    "is this marked", so the number a preset's tools launch in
    #    would always just be the current view's own (alphabetical-ish)
    #    order regardless of what order you pressed Tab in. Instead,
    #    --internal-preset-tab keeps a small ordered list on the side
    #    every Tab press updates, and shows it back as a number badge
    #    in place of fzf's native marker — see that handler above for
    #    the mechanics.
    export PRESET_ORDER_BASE_FILE="$CACHE_DIR/preset-order-base.$$"
    export PRESET_ORDER_LIST_FILE="$CACHE_DIR/preset-order-list.$$"
    export PRESET_ORDER_STATE_FILE="$CACHE_DIR/preset-order-state.$$"

    mkdir -p "$CACHE_DIR"
    : > "$PRESET_ORDER_STATE_FILE"
    printf '%s\n' "${entries[@]}" > "$PRESET_ORDER_BASE_FILE"

    # Seeds the initial (all-unmarked) list through the exact same code
    # path Tab itself uses to regenerate it, rather than formatting the
    # blank badge a second time here.
    "$SCRIPT_PATH" --internal-preset-tab "" >/dev/null

    while [[ "$pick_valid" == false ]]; do

        rm -f "$FOOTER_CLICK_FILE"

        fzf_result="$(
            fzf \
                --height=100% \
                --no-clear \
                --layout=reverse \
                --border=rounded \
                --border-label="$(screen_border_label 'New preset — select tools')" \
                --border-label-pos=2 \
                --prompt=' 󰣇  ' \
                --pointer='▌' \
                --delimiter=$'\t' \
                --with-nth=2 \
                --nth=1,2,3,4 \
                --header="Tab marks a tool — the number is the order it'll launch in. Tab again to unmark." \
                --footer='  ↑ ↓  Navigate    Tab  Mark/unmark    Enter  [Confirm]    Esc  [Cancel]' \
                --bind "tab:transform:$SCRIPT_PATH --internal-preset-tab {1}" \
                --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
                --expect=enter,esc \
                --color="$FZF_COLORS" \
                < "$PRESET_ORDER_LIST_FILE"
        )"

        rm -f "$FOOTER_CLICK_FILE"

        if [[ -z "$fzf_result" ]]; then
            rm -f "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"
            return 1
        fi

        result_lines=("${(@f)fzf_result}")

        if [[ "${result_lines[1]}" != "enter" ]]; then
            rm -f "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"
            return 1
        fi

        selected_commands=()
        if [[ -s "$PRESET_ORDER_STATE_FILE" ]]; then
            for line in "${(@f)$(<"$PRESET_ORDER_STATE_FILE")}"; do
                [[ -z "$line" ]] && continue
                selected_commands+=("$line")
            done
        fi

        # Enter with nothing marked used to fall back to whatever the
        # cursor happened to be sitting on, silently saving a one-tool
        # "preset" — reported as confusing, since a preset that's just
        # one tool isn't really what presets are for (you'd just launch
        # that tool directly). Now it's an explicit error, and this
        # loop just reopens the same screen rather than dropping all
        # the way back out to Actions.
        if (( ${#selected_commands[@]} == 0 )); then
            printf '\n'
            printf 'Mark at least one tool with Tab before saving a preset.\n'
            sleep 2
        else
            pick_valid=true
        fi
    done

    rm -f "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"

    # 2. Name it — type a new name, or pick an existing preset to
    #    replace. Same type-or-pick convention toggle_category() above
    #    uses for categories.
    if [[ -d "$PRESETS_DIR" ]]; then
        for line in "$PRESETS_DIR"/*; do
            [[ -f "$line" ]] || continue
            existing_presets+=("${line:t}")
        done
    fi

    rm -f "$FOOTER_CLICK_FILE"

    preset_name="$(
        printf '%s\n' "${existing_presets[@]}" |
        fzf \
            --print-query \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'New preset — name it')" \
            --border-label-pos=2 \
            --prompt=' New or existing: ' \
            --footer="  ↑ ↓  Navigate    Type  New name or pick to replace    Enter  [Save ${#selected_commands[@]}]    Esc  [Cancel]" \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --pointer='▌' \
            --color="$FZF_COLORS" |
        tail -n1
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$preset_name" ]] && return 1

    # The typed name becomes a filename directly — same guard
    # toggle_category() applies to category names, for the same reason.
    if [[ "$preset_name" == */* || "$preset_name" == .* ]]; then
        printf '\n'
        printf 'Invalid preset name: %s\n' "$preset_name"
        printf 'Names cannot contain "/" or start with ".".\n'
        sleep 2
        return 1
    fi

    preset_file="$PRESETS_DIR/$preset_name"

    if [[ -f "$preset_file" ]]; then

        existing_count="$(grep -cv '^[[:space:]]*#\|^[[:space:]]*$' "$preset_file" 2>/dev/null)"

        rm -f "$FOOTER_CLICK_FILE"

        overwrite_answer="$(
            printf '%s\n' "Replace it" "Cancel" |
            fzf \
                --height=100% \
                --no-clear \
                --layout=reverse \
                --border=rounded \
                --border-label="$(screen_border_label 'Preset already exists')" \
                --border-label-pos=2 \
                --prompt='  ' \
                --pointer='▌' \
                --header="\"$preset_name\" already has $existing_count command(s). Replace it with this new selection?" \
                --footer='  ↑ ↓  Navigate    Enter  chooses    Esc  [Cancel]' \
                --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
                --color="$FZF_COLORS"
        )"

        rm -f "$FOOTER_CLICK_FILE"

        [[ "$overwrite_answer" != "Replace it" ]] && return 1
    fi

    mkdir -p "$PRESETS_DIR"
    printf '%s\n' "${selected_commands[@]}" > "$preset_file"

    printf '\n'
    printf 'Preset "%s" saved with %d command(s).\n' "$preset_name" "${#selected_commands[@]}"
    printf 'Launch it with F9, or: brew-launcher --preset %s\n' "$preset_name"
    sleep 2

    return 0
}

# ------------------------------------------------------------
# Rearrange (or add/remove tools in) an existing preset — F9's Ctrl-E.
#
# Before
# this, the only way to change a preset's order was Create Preset
# again with the exact same name (replacing it outright) — which meant
# re-marking every tool from scratch in the new order, since Create
# Preset always starts blank. This reuses the exact same Tab-to-mark
# screen, just seeded from the preset's current members/order instead
# of starting empty — Tab still marks/unmarks (toggling one moves it to
# the end, same as building a preset the first time), so reordering
# means unmark-then-remark whichever tools need to move, in the order
# you want them to land in.
#
# Deliberately does NOT follow $entries/CURRENT_VIEW the way Create
# Preset does — that's right for *building* a preset from whatever
# you're currently browsing, but wrong here: an existing member that
# happens to be outside the current view would still be preserved (it
# lives in PRESET_ORDER_STATE_FILE independently of what's rendered)
# but wouldn't be visible to reorder, and anything not currently in
# view couldn't be added either. Builds its own list from "All"
# instead — saving and restoring CURRENT_VIEW/$entries around it so
# the caller's own view is untouched once this returns.
# ------------------------------------------------------------

edit_preset() {

    local preset_name="$1"
    local preset_file="$PRESETS_DIR/$preset_name"
    local -a selected_commands=() existing_members=()
    local fzf_result line member
    local -a result_lines=()
    local pick_valid=false

    [[ -f "$preset_file" ]] || return 1

    if [[ "$TMUX_AVAILABLE" == false ]]; then
        printf '\n'
        printf 'Presets need tmux: brew install tmux\n'
        sleep 2
        return 1
    fi

    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue
        existing_members+=("$line")
    done < "$preset_file"

    # See this function's own comment above for why "All", not
    # $entries as-is. hidden_commands is also cleared for this one
    # build — "All" still excludes hidden entries the normal way, and
    # a preset member you later hid from everyday browsing (common:
    # you'd hide exactly the sort of niche tool you only run via a
    # preset) would otherwise vanish from its own edit screen the same
    # way an uninstalled one does below — present in the file, not
    # selectable, silently eating a number in the badge sequence.
    local saved_view="$CURRENT_VIEW"
    local -a saved_entries=("${entries[@]}")
    local -A saved_hidden=("${(kv)hidden_commands[@]}")
    hidden_commands=()
    CURRENT_VIEW="All"
    build_entries
    local -a all_entries=("${entries[@]}")
    hidden_commands=("${(kv)saved_hidden[@]}")
    CURRENT_VIEW="$saved_view"
    entries=("${saved_entries[@]}")

    # Unlike hidden, an actually-uninstalled member has no row to show
    # at all — there's nothing left in the cache to build one from.
    # Dropped here, with the same "warn, don't silently lose it"
    # courtesy run_preset() already extends a stale preset member at
    # launch time, rather than left in the seeded state to cause the
    # exact same invisible-and-unselectable problem hidden entries just
    # got fixed for.
    local -a base_commands=() valid_members=() stale_members=()
    for line in "${all_entries[@]}"; do
        base_commands+=("${line%%$'\t'*}")
    done
    for member in "${existing_members[@]}"; do
        if (( ${base_commands[(Ie)$member]} )); then
            valid_members+=("$member")
        else
            stale_members+=("$member")
        fi
    done

    if (( ${#stale_members[@]} > 0 )); then
        printf '\n'
        printf 'Note: %d command(s) no longer installed will be dropped: %s\n' \
            "${#stale_members[@]}" "${stale_members[*]}"
        sleep 2
    fi

    existing_members=("${valid_members[@]}")

    export PRESET_ORDER_BASE_FILE="$CACHE_DIR/preset-order-base.$$"
    export PRESET_ORDER_LIST_FILE="$CACHE_DIR/preset-order-list.$$"
    export PRESET_ORDER_STATE_FILE="$CACHE_DIR/preset-order-state.$$"

    mkdir -p "$CACHE_DIR"

    # Not a plain printf into the file: with a genuinely empty array
    # (every member turned out to be stale, above), `printf '%s\n'
    # "${empty[@]}"` still runs once and writes a single blank line —
    # confirmed live — which --internal-preset-tab would then read as
    # one real (empty-string) entry, silently eating badge #1 the
    # exact same way a stale member being seeded unfiltered would
    # have. create_preset()'s own blank start avoids this the same
    # way, with a plain truncate instead of printf-ing nothing.
    if (( ${#existing_members[@]} > 0 )); then
        printf '%s\n' "${existing_members[@]}" > "$PRESET_ORDER_STATE_FILE"
    else
        : > "$PRESET_ORDER_STATE_FILE"
    fi

    printf '%s\n' "${all_entries[@]}" > "$PRESET_ORDER_BASE_FILE"

    # Same seeding trick create_preset() uses for its own blank start —
    # this just regenerates the badges from a non-empty
    # PRESET_ORDER_STATE_FILE instead, so the screen opens already
    # numbered in the preset's current order.
    "$SCRIPT_PATH" --internal-preset-tab "" >/dev/null

    while [[ "$pick_valid" == false ]]; do

        rm -f "$FOOTER_CLICK_FILE"

        fzf_result="$(
            fzf \
                --height=100% \
                --no-clear \
                --layout=reverse \
                --border=rounded \
                --border-label="$(screen_border_label "Edit preset \"$preset_name\"")" \
                --border-label-pos=2 \
                --prompt=' 󰣇  ' \
                --pointer='▌' \
                --delimiter=$'\t' \
                --with-nth=2 \
                --nth=1,2,3,4 \
                --header="Tab marks a tool — the number is the order it'll launch in. Tab again to unmark, then remark to move it." \
                --footer='  ↑ ↓  Navigate    Tab  Mark/unmark    Enter  [Save]    Esc  [Cancel]' \
                --bind "tab:transform:$SCRIPT_PATH --internal-preset-tab {1}" \
                --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
                --expect=enter,esc \
                --color="$FZF_COLORS" \
                < "$PRESET_ORDER_LIST_FILE"
        )"

        rm -f "$FOOTER_CLICK_FILE"

        if [[ -z "$fzf_result" ]]; then
            rm -f "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"
            return 1
        fi

        result_lines=("${(@f)fzf_result}")

        if [[ "${result_lines[1]}" != "enter" ]]; then
            rm -f "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"
            return 1
        fi

        selected_commands=()
        if [[ -s "$PRESET_ORDER_STATE_FILE" ]]; then
            for line in "${(@f)$(<"$PRESET_ORDER_STATE_FILE")}"; do
                [[ -z "$line" ]] && continue
                selected_commands+=("$line")
            done
        fi

        # Same guard as create_preset() — unmarking everything isn't
        # "save an empty preset," it's Ctrl-D's job.
        if (( ${#selected_commands[@]} == 0 )); then
            printf '\n'
            printf 'Mark at least one tool with Tab before saving.\n'
            sleep 2
        else
            pick_valid=true
        fi
    done

    rm -f "$PRESET_ORDER_BASE_FILE" "$PRESET_ORDER_LIST_FILE" "$PRESET_ORDER_STATE_FILE"

    printf '%s\n' "${selected_commands[@]}" > "$preset_file"

    printf '\n'
    printf 'Preset "%s" updated with %d command(s).\n' "$preset_name" "${#selected_commands[@]}"
    sleep 1

    return 0
}

# Same convention as confirm_delete_category() — Cancel listed first so
# it's the default and Esc also cancels, count shown so "Delete
# devops?" is real information rather than noise.
confirm_delete_preset() {

    local name="$1"
    local file="$PRESETS_DIR/$name"
    local count=0
    local answer

    [[ -f "$file" ]] && count="$(grep -cv '^[[:space:]]*#\|^[[:space:]]*$' "$file" 2>/dev/null)"

    local noun="commands"
    (( count == 1 )) && noun="command"

    answer="$(
        printf '%s\n' "Cancel" "Delete \"$name\" and its $count $noun" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Delete preset')" \
            --border-label-pos=2 \
            --prompt='  ' \
            --pointer='▌' \
            --header="This can't be undone." \
            `# "Enter chooses" is deliberately not bracketed/clickable, same` \
            `# reason as confirm_delete_category(): Enter acts on whichever` \
            `# row is highlighted, so a clickable [Confirm] would cancel` \
            `# whenever Cancel happened to be highlighted.` \
            --footer='  ↑ ↓  Navigate    Enter  chooses    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ "$answer" == Delete* ]]
}

# Rename a preset — same idiom as rename_category() above, since a
# preset is exactly the same shape (a name that IS a filename, nothing
# else to update). See that function for why --print-query is used as
# the text-entry mechanism instead of something new, and — same fix,
# same reason — why this reads head -n1, not tail -n1.
rename_preset() {

    local old_name="$1"
    local new_name

    rm -f "$FOOTER_CLICK_FILE"

    new_name="$(
        printf '%s\n' "$old_name" |
        fzf \
            --print-query \
            --query="$old_name" \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Rename preset')" \
            --border-label-pos=2 \
            --prompt=' New name: ' \
            --footer='  Type  New name    Enter  [Rename]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --pointer='▌' \
            --color="$FZF_COLORS" |
        head -n1
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$new_name" || "$new_name" == "$old_name" ]] && return 1

    if [[ "$new_name" == */* || "$new_name" == .* ]]; then
        printf '\n'
        printf 'Invalid preset name: %s\n' "$new_name"
        printf 'Names cannot contain "/" or start with ".".\n'
        sleep 2
        return 1
    fi

    if [[ -e "$PRESETS_DIR/$new_name" ]]; then
        printf '\n'
        printf 'A preset named "%s" already exists.\n' "$new_name"
        sleep 2
        return 1
    fi

    mv "$PRESETS_DIR/$old_name" "$PRESETS_DIR/$new_name"
    printf '%s' "$new_name"
}

# ------------------------------------------------------------
# Pick a preset and launch it — the in-app entry point to run_preset(),
# reached via F9. --preset <name> is the other way in, for when you
# already know the name and would rather skip the picker.
#
# Ctrl-D deletes the highlighted preset instead of launching it — same
# key, same confirm-first pattern pick_view() already uses to delete a
# category, so nothing new to learn if you've used that one.
# ------------------------------------------------------------

launch_preset() {

    local -a existing_presets=()
    local -a result_lines=()
    local line preset_name result pick_action clicked_word

    if [[ -d "$PRESETS_DIR" ]]; then
        for line in "$PRESETS_DIR"/*; do
            [[ -f "$line" ]] || continue
            existing_presets+=("${line:t}")
        done
    fi

    if (( ${#existing_presets[@]} == 0 )); then
        printf '\n'
        printf 'No presets yet — F4 → Actions → Create Preset makes one.\n'
        sleep 2
        return 1
    fi

    rm -f "$FOOTER_CLICK_FILE"

    # Width-aware, same idea as pick_view()'s own footer — see
    # build_picker_footer() for why.
    local preset_footer
    preset_footer="$(
        build_picker_footer \
            '  ↑ ↓  Navigate    Enter  [Launch]    Esc  [Cancel]' \
            '  ↑ ↓  Navigate    Enter  [Launch]    Esc  [Cancel]' \
            $'Ctrl-E\t\t[Edit]' $'Ctrl-R\t\t[Rename]' $'Ctrl-D\t\t[Delete]'
    )"

    # Preview pane always on here, no F3 toggle, matching Actions' own
    # always-on pane. A preset list is usually short and the whole point
    # of glancing at one before launching it is seeing what's actually
    # in it, so — like Actions' own always-on pane — there's nothing to
    # remember to turn on. DETAILS_VISIBLE (and F3) still control the
    # pane elsewhere (main list, F2); this screen just doesn't share
    # that particular toggle anymore.
    result="$(
        printf '%s\n' "${existing_presets[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Launch Preset')" \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --preview "${(q)SCRIPT_PATH} --internal-preview-preset {1}" \
            --preview-window="$(details_preview_window)" \
            --footer="$preset_footer" \
            --expect=enter,ctrl-d,ctrl-r,ctrl-e \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    [[ -z "$result" ]] && return 1

    result_lines=("${(@f)result}")
    pick_action="${result_lines[1]}"
    preset_name="${result_lines[2]}"

    # Deliberately not cleared right after fzf exits, unlike most
    # screens here — a footer click reports through this same file
    # (see --internal-footer-click), and a click never lands in
    # --expect's key list, so pick_action above is empty on a click and
    # this is the only way to recover which word was actually clicked.
    # Clearing it before this check (as this function used to) meant a
    # "[Delete]" click always fell through to launching the preset
    # instead of deleting it.
    if [[ -f "$FOOTER_CLICK_FILE" ]]; then
        clicked_word="$(sed -n '1p' "$FOOTER_CLICK_FILE")"
        rm -f "$FOOTER_CLICK_FILE"

        case "$clicked_word" in
            '[Delete]'|Delete) pick_action="ctrl-d" ;;
            '[Rename]'|Rename) pick_action="ctrl-r" ;;
            '[Edit]'|Edit) pick_action="ctrl-e" ;;
            '[Launch]'|Launch) pick_action="enter" ;;
        esac
    fi

    [[ -z "$preset_name" ]] && return 1

    if [[ "$pick_action" == "ctrl-e" ]]; then

        edit_preset "$preset_name"

        # Same redraw-in-place idea as Ctrl-R/Ctrl-D below, whether the
        # edit was saved or cancelled — either way there's nothing more
        # to do than show the (possibly updated) list again.
        launch_preset
        return $?
    fi

    if [[ "$pick_action" == "ctrl-r" ]]; then

        local renamed_preset had_running_session=false

        # A running session for this preset is named after the OLD
        # name (blpreset-<name>, see run_preset()) — renaming the file
        # doesn't reach into a live session to match, so it's worth
        # saying so rather than leaving that to be found out later.
        # The old session just keeps working under its old name until
        # it ends; the next launch of the new name starts fresh, same
        # as editing a running preset's command list already does.
        tmux has-session -t "blpreset-$preset_name" 2>/dev/null && had_running_session=true

        if renamed_preset="$(rename_preset "$preset_name")" && [[ -n "$renamed_preset" ]]; then
            printf '\n'
            printf 'Preset "%s" renamed to "%s".\n' "$preset_name" "$renamed_preset"
            [[ "$had_running_session" == true ]] &&
                printf 'Its running session keeps working under the old name until it ends.\n'
            sleep 1
        fi

        launch_preset
        return $?
    fi

    if [[ "$pick_action" == "ctrl-d" ]]; then

        if confirm_delete_preset "$preset_name"; then
            rm -f "$PRESETS_DIR/$preset_name"
            printf '\n'
            printf 'Preset "%s" deleted.\n' "$preset_name"
            sleep 1
        fi

        # Loop back in rather than return — same pattern pick_view()
        # uses after a category delete, so the list redraws (one preset
        # shorter, or back to the "no presets yet" message) instead of
        # dropping you out to the main list.
        launch_preset
        return $?
    fi

    # run_preset() only ever returns on failure (success execs into
    # tmux and never comes back) — its own error message and pause
    # already happened, so there's nothing more to add here.
    run_preset "$preset_name"
}


# ------------------------------------------------------------
# Show hidden application entries
# ------------------------------------------------------------

# ------------------------------------------------------------
# Footer text, sized to the terminal.
#
# fzf truncates a footer that doesn't fit, and does it silently — a
# beginner would just lose keys off the end with no sign anything was
# cut. build_footer() tries progressively narrower renderings instead
# of ever handing fzf something that might get chopped:
#
#   1. every item, with ⌥ aliases, widest gap   (needs ~102 cols)
#   2. every item, F-keys only, widest gap      (needs ~87 cols)
#   3. every item, F-keys only, narrowest gap   (needs ~79 cols)
#
# The ⌥ aliases go first since the F-keys alone already work without
# the "Option as Meta" terminal setting — losing them costs nothing
# a plain F-key press can't already do. No item is ever dropped
# outright; (3) is the floor, so anything narrower than it is the one
# case this still hands fzf a line that can get silently truncated —
# just above the ~80-column terminal width this project otherwise
# assumes as a baseline, so a plain 80-column terminal already sits in
# that one gap; there's no narrower tier below it to fall back to.
#
# The border/padding overhead below is a real measured constant, not
# an estimate — found after the [Actions] rename (3 characters
# wider than the old [More]) pushed tier 1's line to exactly the old
# budget's ceiling with zero margin, which turned out to still overflow
# in practice: rendering it at every width from 96 to 106 columns found
# the true cutover at 102, six wider than the string itself, not four.
# ------------------------------------------------------------

terminal_width() {

    local width

    # $COLUMNS is 0 in a non-interactive zsh, so ask the terminal.
    width="$(stty size < /dev/tty 2>/dev/null | cut -d' ' -f2)"
    [[ -z "$width" || "$width" == 0 ]] && width="$(tput cols 2>/dev/null)"
    [[ -z "$width" || "$width" == 0 ]] && width=80

    print -r -- "$width"
}

footer_key() {

    # $1 = F-key, $2 = Option letter, $3 = 1 to include the ⌥ alias
    if (( $3 )); then
        printf '%s/⌥%s' "$1" "$2"
    else
        printf '%s' "$1"
    fi
}

footer_actions() {

    local with_alt="$1" gap="$2"
    local -a parts=()

    # First, ahead of Views/Details/Actions/Presets below — F1 reads
    # first the same way it numbers first, rather than trailing behind
    # the very keys it's there to explain. Previously last, deliberately:
    # the reasoning then was that F1=help is close to universal
    # knowledge, not worth spending prime footer space teaching, and
    # least costly to lose if a narrow terminal truncates the string
    # from the end. That protection was accidental, though, not a real
    # priority mechanism — this footer has always been one plain
    # string, truncated by fzf from wherever it runs out of room, so
    # whatever's last pays that cost regardless of which item it is.
    # Moving Help first means Presets is what a narrow terminal
    # sacrifices now instead.
    parts+=("$(footer_key F1 '?' $with_alt)  [Help]")

    # Browsing/navigation, plus the one organizing action that's worth
    # reaching for repeatedly rather than tucked away in [Actions] —
    # Presets, since running one is a recurring thing, not a one-time
    # setup step. Everything else still lives behind [Actions] — named
    # that, not "More", specifically so it reads as "what can I do to
    # the highlighted row" the way a GUI right-click menu would,
    # rather than something vaguer like "more info" or "more results."
    parts+=("$(footer_key F2 V $with_alt)  [Views]")
    parts+=("$(footer_key F3 D $with_alt)  [Details]")
    parts+=("$(footer_key F4 M $with_alt)  [Actions]")

    # Refresh dropped from here. It's now Actions -> Refresh
    # (see pick_more_action()); F5/⌥R still work as a direct keypress
    # exactly as before, this only stops spending a permanent footer
    # slot on something reached for far less often than the four above.

    # Always shown, even without tmux — unlike Create Shortcut on an
    # unsupported platform, this isn't a dead end: pressing it without
    # tmux explains exactly what to install rather than failing
    # silently, and hiding it entirely turned out to mean someone who
    # never had tmux would never learn Presets exist at all. The
    # Actions-menu row carries the "needs tmux" indicator; the footer
    # stays terse like every other entry here.
    parts+=("$(footer_key F9 P $with_alt)  [Presets]")

    local separator="${(l:$gap:: :)}"
    local out="" part

    for part in "${parts[@]}"; do
        [[ -n "$out" ]] && out+="$separator"
        out+="$part"
    done

    printf '  %s' "$out"
}

build_footer() {

    local esc_hint="$1"
    local width=$(( $(terminal_width) - 6 ))   # border and padding — measured live, see comment above

    local nav="  ↑ ↓  Navigate    Type  Search    Enter  [Launch]    Esc  [$esc_hint]"
    local legend="    +  Favorited    #  Categorized    *  Outdated"
    local nav_short="  ↑ ↓  Navigate    Enter  [Launch]    Esc  [$esc_hint]"

    # Compact View drops the +/#/* markers themselves (see
    # build_entries()'s own comment) — explaining marks that no longer
    # appear anywhere would just be confusing, not merely redundant.
    local line1="$nav$legend"
    [[ "$COMPACT_VIEW" == on ]] && line1="$nav"
    (( ${#line1} > width )) && line1="$nav"
    (( ${#line1} > width )) && line1="$nav_short"

    # Tried in order; the last one stands if nothing fits, which is
    # still better than letting fzf cut an item off mid-word. Fields
    # are: ⌥ aliases, gap between items. Fits at 100 columns and up on
    # the first attempt; see the comment above footer_actions() for
    # the three widths this actually degrades through.
    #
    # The "1 4" (⌥-alias) rung is only tried at all when Alt Keybinds
    # (Actions -> Alt Keybinds) is on. Before that toggle existed,
    # whether an alias showed was decided purely by whether it
    # happened to fit — never a real choice, and never consistent with
    # F2/F9's own footer (see build_picker_footer()) not offering
    # aliases at all. Off skips straight to the F-key-only rungs.
    local -a attempts=("1 4" "0 4" "0 2")
    [[ "$CONFIG_ALT_KEYBINDS" == off ]] && attempts=("0 4" "0 2")

    local line2 attempt
    for attempt in "${attempts[@]}"; do
        line2="$(footer_actions ${=attempt})"
        (( ${#line2} <= width )) && break
    done

    printf '%s\n%s' "$line1" "$line2"
}

# ------------------------------------------------------------
# Same two-line, width-aware idea as build_footer()/footer_actions()
# above, generalized for the F2 and F9 pickers' own footers.
# Both had grown past what a single static
# footer string can safely promise (Ctrl-R/Ctrl-D, F3 Details, F9
# Presets all landed there over a few PRs, with nothing checking
# whether they'd actually fit on screen) — fzf just truncates
# mid-word instead of degrading gracefully the way the main list
# already does.
#
# $1 = the full nav line (navigate/search/launch/back, however much
# of that the caller wants), $2 = a shorter fallback nav line, $3+ =
# each action as a "FKEY<TAB>LETTER<TAB>[Label]" spec — LETTER empty
# for a Ctrl-combo, which has no ⌥ alias (Ctrl-R, Ctrl-D). Line 1 tries
# $1 first, falls back to $2 if too wide. The actions are then joined
# onto one line, trying the ⌥-alias rung first — but only when Alt
# Keybinds (Actions -> Alt Keybinds) is on, same toggle build_footer()
# reads, added specifically so this picker footer and the main list's
# stop disagreeing about whether aliases show at all. Then a 4-space
# gap without aliases, then a 2-space gap. F2 alone has 6 actions past
# nav, more than even a 2-space gap reliably fits below ~95 columns —
# confirmed live rather than assumed — so a final rung splits the
# actions across two lines (roughly half each, aliases dropped —
# there's even less room here than the rung that already dropped them)
# instead of handing fzf something it can only truncate mid-word.
# ------------------------------------------------------------

# One action spec ("FKEY<TAB>LETTER<TAB>[Label]") rendered as text —
# "$FKEY/⌥$LETTER  [Label]" when with_alt is on and LETTER isn't
# empty, "$FKEY  [Label]" otherwise. Same shape as footer_key() above,
# just unpacking a spec instead of taking already-separated arguments.
picker_footer_action_text() {

    local spec="$1" with_alt="$2"
    local fkey="${spec%%$'\t'*}"
    local rest="${spec#*$'\t'}"
    local letter="${rest%%$'\t'*}"
    local label="${rest#*$'\t'}"

    if [[ -n "$letter" ]] && (( with_alt )); then
        printf '%s/⌥%s  %s' "$fkey" "$letter" "$label"
    else
        printf '%s  %s' "$fkey" "$label"
    fi
}

build_picker_footer() {

    local nav="$1" nav_short="$2"
    shift 2
    local -a specs=("$@")

    local width=$(( $(terminal_width) - 6 ))

    local line1="$nav"
    (( ${#line1} > width )) && line1="$nav_short"

    local -a attempts=("1 4" "0 4" "0 2")
    [[ "$CONFIG_ALT_KEYBINDS" == off ]] && attempts=("0 4" "0 2")

    local gap_str line2 attempt with_alt gap part spec
    for attempt in "${attempts[@]}"; do
        with_alt="${attempt%% *}"
        gap="${attempt##* }"
        gap_str="${(l:$gap:: :)}"
        line2=""
        for spec in "${specs[@]}"; do
            part="$(picker_footer_action_text "$spec" "$with_alt")"
            [[ -n "$line2" ]] && line2+="$gap_str"
            line2+="$part"
        done
        line2="  $line2"
        (( ${#line2} <= width )) && { printf '%s\n%s' "$line1" "$line2"; return; }
    done

    # Neither single-line rung fit — split the actions across two
    # lines instead. Halved by count, not by rendered width; close
    # enough given how similar each action string's length already is
    # (an F-key/Ctrl-combo, two spaces, a short bracketed word).
    local -a first_half second_half
    local half_count=$(( (${#specs[@]} + 1) / 2 ))
    first_half=("${specs[@]:0:$half_count}")
    second_half=("${specs[@]:$half_count}")

    local line2a line2b
    gap_str="${(l:2:: :)}"

    line2a=""
    for spec in "${first_half[@]}"; do
        part="$(picker_footer_action_text "$spec" 0)"
        [[ -n "$line2a" ]] && line2a+="$gap_str"
        line2a+="$part"
    done
    line2a="  $line2a"

    line2b=""
    for spec in "${second_half[@]}"; do
        part="$(picker_footer_action_text "$spec" 0)"
        [[ -n "$line2b" ]] && line2b+="$gap_str"
        line2b+="$part"
    done
    line2b="  $line2b"

    printf '%s\n%s\n%s' "$line1" "$line2a" "$line2b"
}

run_fzf() {

    local border_label="$1"
    local footer="$2"
    local expected_keys="$3"
    local initial_position="$4"

    local options=(
        --height=100%
        --no-clear
        --layout=reverse
        --border=rounded
        --border-label="$border_label"
        --border-label-pos=2
        --prompt=' 󰣇  '
        --pointer='▌'
        --marker='●'
        --header="$FZF_HEADER"
        --footer="$footer"
        --info=inline
        --no-scrollbar
        --delimiter=$'\t'
        --with-nth=2
        --nth=1,2,3,4
        --color="$FZF_COLORS"

        # Field 3 is the formula name, which is what the preview files
        # are keyed by. Hidden unless DETAILS_VISIBLE says otherwise —
        # the list already needs ~143 columns for its own footer, so
        # the pane only costs width once you actually ask for it.
        #
        # F3/⌥D used to be a native fzf toggle-preview bind, invisible
        # to this script entirely — fast, but it meant Esc could never
        # tell the pane was open, so it always fell straight through to
        # Quit/Views instead of closing the pane first. Now routed
        # through the normal dispatch loop like every other toggle (see
        # DETAILS_VISIBLE), which costs a redraw but lets Esc check
        # state before deciding what "back" means.
        --preview "${(q)SCRIPT_PATH} --internal-preview {1} {3}"
        --preview-window="$(details_preview_window "$DETAILS_VISIBLE")"
        --bind='shift-up:preview-up'
        --bind='shift-down:preview-down'
    )

    if [[ -n "$expected_keys" ]]; then
        options+=(--expect="$expected_keys")
    fi

    if [[ -n "$initial_position" ]]; then
        # "load", not "start" — fzf consumes the input list
        # asynchronously, so "start" fires before it's actually
        # available to move the cursor onto.
        options+=(--bind "load:pos($initial_position)")
    fi

    # Cleared before every call so a stale click from a previous
    # screen/iteration can never leak into this one. See
    # --internal-footer-click above for what actually writes to it.
    rm -f "$FOOTER_CLICK_FILE"
    options+=(--bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click")

    # Same reasoning, for a click on the NAME/SIZE column header — see
    # --internal-header-click above. Only run_fzf() itself needs this:
    # it's the one screen with a NAME/VERSION/SIZE/DESCRIPTION header
    # to click on at all.
    rm -f "$HEADER_CLICK_FILE"
    options+=(--bind "click-header:transform:$SCRIPT_PATH --internal-header-click")

    fzf "${options[@]}"
}


# ------------------------------------------------------------
# Disk usage for the border label — computed once here, not inside
# the loop below, since neither value would meaningfully change
# within a single session (free space is a live `df`, cheap enough to
# check at all; Homebrew's own usage is the value rebuild_cache()
# cached, read fresh here so it reflects the cache this launch is
# actually using).
# ------------------------------------------------------------

FREE_SPACE="$(df -h "$(brew --prefix)" 2>/dev/null | awk 'NR==2 {print $4}' | sed -E 's/([0-9])([KMGT])i?$/\1\2/')"
HOMEBREW_USAGE="$(cat "$HOMEBREW_USAGE_FILE" 2>/dev/null)"

# Opt-in (Actions → Open to Categories) — shows the view picker as the
# very first screen instead of "All", so a launch lands you straight
# in your categories rather than a long flat list. Only makes sense
# once categories are actually populated (bundled, manual, or both);
# reuses pick_view() as-is rather than a separate startup path, so
# every behavior it already has — typing to search, Esc falling back
# to "All", counts reflecting hidden/bundled state — comes for free
# and can never drift out of sync with the F2 screen itself.
#
# Deliberately placed here — after every function in the script has
# been defined, immediately before the loop that will (eventually)
# call all of them anyway — rather than up near where CONFIG_* is
# parsed. zsh doesn't hoist function definitions: a top-level call
# only works once the interpreter's own top-to-bottom pass has already
# reached that function's "name() {" line. pick_view() reaches deep
# into the rest of the app (F4's whole Actions menu — Create Preset,
# Backup, every settings toggle, Launch Preset...), and this used to
# run from up there, near CONFIG_OPEN_TO_CATEGORIES's own declaration —
# fine for whichever of those happened to already be defined by that
# point, silently broken for whichever weren't: the footer went
# missing when launching straight into the view screen with this
# toggle on — build_picker_footer() was one of the not-yet-defined
# ones, so the footer variable came back empty. Confirmed live (a real
# tmux session, the previously-released binary, this exact toggle) and
# fixed generally rather than one function at a time: see
# test/function-order-fixtures.sh, which checks that no top-level call
# anywhere in the script can reach a not-yet-defined function, so a
# future addition to Actions can't reintroduce this by accident.
if [[ "$CONFIG_OPEN_TO_CATEGORIES" == on ]]; then
    pick_view
fi

build_entries

# ------------------------------------------------------------
# Launcher loop
# ------------------------------------------------------------

while true; do

    # A view that's become empty (e.g. F2/F6/F7 just removed its last
    # member, or nothing is hidden) is never handed to fzf at all —
    # open the view picker instead of forcing "All", so you can choose
    # where to go next, including deleting a now-empty category right
    # there with Ctrl-D. Whatever fzf does with zero candidates plus a
    # keypress, not relying on it is safer than finding out.
    if (( ${#entries[@]} == 0 )) && [[ "$CURRENT_VIEW" != "All" ]]; then
        printf '\n'
        printf 'Nothing in "%s".\n' "$CURRENT_VIEW"
        sleep 1
        pick_view
        build_entries
        continue
    fi

    # Disk usage only appears on "All" — a filtered view's border
    # already carries the view name, and both together risks crowding
    # or truncating a border label on a narrower terminal.
    border_label=" 󰣇  Homebrew CLI v$VERSION$(launcher_update_marker) "
    if [[ -n "$HOMEBREW_USAGE" && -n "$FREE_SPACE" ]]; then
        border_label=" 󰣇  Homebrew CLI v$VERSION$(launcher_update_marker) · ${HOMEBREW_USAGE} brew · ${FREE_SPACE} free "
    fi
    esc_hint="Quit"
    hide_label="Hide"

    if [[ "$CURRENT_VIEW" != "All" ]]; then
        border_label=" 󰣇  Homebrew CLI v$VERSION · $CURRENT_VIEW "
        esc_hint="Views"
    fi

    # Takes priority over the view-based hint above — whichever "back"
    # step Esc would otherwise take, closing an open details pane
    # happens first, same as the Hidden-view check below takes
    # priority over the plain hide/unhide label. Not when the pane is
    # pinned on via Actions, though (see DETAILS_PINNED) — Esc skips
    # it entirely then, so the footer shouldn't promise a "[Close]"
    # that particular Esc press won't actually do.
    [[ "$DETAILS_VISIBLE" == true && "$DETAILS_PINNED" == false ]] && esc_hint="Close"

    # In the Hidden view every row is by definition hidden, so F2 can
    # only mean "unhide" — say so rather than making the user infer it.
    [[ "$CURRENT_VIEW" == "Hidden" ]] && hide_label="Unhide"

    fzf_result="$(
        printf '%s\n' "${entries[@]}" |
        run_fzf \
            "$border_label" \
            "$(build_footer "$esc_hint")" \
            'enter,f1,f2,f3,f4,f5,f6,f7,f8,f9,alt-h,alt-v,alt-p,alt-r,alt-f,alt-c,alt-d,alt-m,alt-?,esc' \
            "$restore_position"
    )"

    # Only applies to the run_fzf call just made — actions below that
    # want to keep the cursor on the same item (F4, F6, F7) set this
    # again themselves before their own "continue".
    restore_position=""

    # --------------------------------------------------------
    # Esc / empty result = quit.
    # --------------------------------------------------------

    [[ -z "$fzf_result" ]] && break

    # --------------------------------------------------------
    # First line = pressed key.
    # Second line = selected entry.
    # --------------------------------------------------------

    result_lines=("${(@f)fzf_result}")

    action="${result_lines[1]}"
    selection="${result_lines[2]}"

    # --------------------------------------------------------
    # A footer click reports as a plain "enter" above (see
    # run_fzf/--internal-footer-click) — override $action to match
    # whichever key that word stands in for.
    # --------------------------------------------------------

    if [[ -f "$FOOTER_CLICK_FILE" ]]; then

        clicked_word="$(sed -n '1p' "$FOOTER_CLICK_FILE")"
        rm -f "$FOOTER_CLICK_FILE"

        # "[Views]" appears twice — as the Esc hint on line 1 while
        # filtered, and as F2's own footer label on line 2. No need to
        # tell them apart: Esc-while-filtered and F2 run the same two
        # lines (pick_view; build_entries), so both map to "f2".
        case "$clicked_word" in
            '[Hide]'|Hide|'[Unhide]'|Unhide|F6/⌥H|F6) action="f6" ;;
            '[Views]'|Views|F2/⌥V|F2) action="f2" ;;
            '[Details]'|Details|F3/⌥D|F3) action="f3" ;;
            '[Presets]'|Presets|F9/⌥P|F9) action="f9" ;;
            '[Favorite]'|Favorite|F7/⌥F|F7) action="f7" ;;
            '[Categorize]'|Categorize|F8/⌥C|F8) action="f8" ;;
            '[Actions]'|Actions|F4/⌥M|F4) action="f4" ;;
            '[Help]'|Help|F1/⌥\?|F1) action="f1" ;;
            '[Quit]'|Quit|'[Close]'|Close) action="esc" ;;
            Enter|'[Launch]'|Launch) action="enter" ;;
        esac
    fi

    # --------------------------------------------------------
    # A click on the NAME or SIZE column header sets that column as
    # the active sort, same SORT_ORDER/set_config_value plumbing
    # Actions -> Sort's own toggle_sort uses — but picks a direction
    # too, spreadsheet-style: clicking the column that's already active
    # flips it (ascending <-> descending), clicking the other one
    # switches to it at its own default direction (name defaults
    # ascending, size defaults descending — the same defaults each one
    # already had before direction existed at all). Handled here rather
    # than through $action, since it isn't one of the footer's keys —
    # it acts on this screen directly and loops right back with the
    # list re-sorted.
    # --------------------------------------------------------

    if [[ -f "$HEADER_CLICK_FILE" ]]; then

        clicked_header="$(sed -n '1p' "$HEADER_CLICK_FILE")"
        rm -f "$HEADER_CLICK_FILE"

        new_sort_order=""
        case "$clicked_header" in
            NAME)
                case "$SORT_ORDER" in
                    name)      new_sort_order='name-desc' ;;
                    name-desc) new_sort_order='name' ;;
                    *)         new_sort_order='name' ;;
                esac
                ;;
            SIZE)
                case "$SORT_ORDER" in
                    size)     new_sort_order='size-asc' ;;
                    size-asc) new_sort_order='size' ;;
                    *)        new_sort_order='size' ;;
                esac
                ;;
        esac

        if [[ -n "$new_sort_order" ]]; then
            set_config_value SORT "$new_sort_order"
            SORT_ORDER="$new_sort_order"
            build_fzf_header
            build_entries
            restore_position="$(find_entry_position "${selection%%$'\t'*}")"
            continue
        fi
    fi

    # --------------------------------------------------------
    # F3 / ⌥V — switch view. Doesn't need a selected entry. Always
    # available: even with no categories defined, "All" and "Hidden"
    # are always offered.
    # --------------------------------------------------------

    # --------------------------------------------------------
    # F1 / ⌥? — help. Purely informational, so unlike F4/Actions below
    # it never falls through to another handler; it just redraws
    # where it was.
    # --------------------------------------------------------

    if [[ "$action" == "f1" || "$action" == "alt-?" ]]; then

        pick_help
        restore_position="$(find_entry_position "${selection%%$'\t'*}")"
        continue
    fi

    # --------------------------------------------------------
    # F4 / ⌥M — the [Actions] menu.
    #
    # open_more_menu() runs the whole menu to completion, including
    # the toggle-and-reopen loop for the settings rows — see its own
    # comment. It only ever returns here for two reasons: Esc with
    # nothing left to do (return 1), or one of the entry-scoped rows
    # that needs this screen's own $command/$formula to run (return
    # 2) — so those still fall through to their normal handler below
    # exactly as before, and this block still has to sit above them.
    #
    # $formula isn't parsed from $selection until further down (see
    # "Extract fields from the selected entry" below) — extracted
    # here too, just for Update's own outdated_formulas[] lookup,
    # since pick_more_action() needs it to build that row's hint
    # before this screen's own parse ever runs.
    # --------------------------------------------------------

    if [[ "$action" == "f4" || "$action" == "alt-m" ]]; then

        local action_formula="${selection#*$'\t'}"
        action_formula="${action_formula#*$'\t'}"
        action_formula="${action_formula%%$'\t'*}"

        open_more_menu "$hide_label" true "${selection%%$'\t'*}" "$action_formula"
        more_menu_status=$?

        if (( more_menu_status != 2 )); then
            restore_position="$(find_entry_position "${selection%%$'\t'*}")"
            continue
        fi

        action="$MORE_MENU_FALLTHROUGH_ACTION"
    fi

    # --------------------------------------------------------
    # F9 / ⌥P — Launch Preset. Direct key and footer only, deliberately
    # not duplicated in Actions too — unlike Create Preset (a one-time
    # setup step), running a preset is something to reach for
    # repeatedly, worth its own always-visible key rather than a menu
    # row buried behind F4, redundant with F9 always being shown
    # anyway. launch_preset() does its own picker and, on
    # success, execs into tmux and never returns — a failure (or Esc)
    # falls back to the picker, same as any other action here.
    # --------------------------------------------------------

    if [[ "$action" == "f9" || "$action" == "alt-p" ]]; then

        # Same message shown whether reached via direct keypress or via
        # the footer — Presets stay visible everywhere even without
        # tmux (see footer_actions()), so this is the one place that
        # actually explains the requirement instead of opening
        # launch_preset()'s own picker only to error once something's
        # actually selected.
        if [[ "$TMUX_AVAILABLE" == false ]]; then
            printf '\n'
            printf 'Presets need tmux: brew install tmux\n'
            sleep 2
        else
            launch_preset
        fi

        restore_position="$(find_entry_position "${selection%%$'\t'*}")"
        continue
    fi

    if [[ "$action" == "f2" || "$action" == "alt-v" ]]; then

        pick_view
        build_entries
        continue
    fi

    # --------------------------------------------------------
    # F3 / ⌥D — toggle the details pane. See DETAILS_VISIBLE's own
    # comment for why this goes through the normal dispatch-and-redraw
    # loop instead of fzf's own native toggle-preview bind.
    # --------------------------------------------------------

    if [[ "$action" == "f3" || "$action" == "alt-d" ]]; then

        [[ "$DETAILS_VISIBLE" == true ]] && DETAILS_VISIBLE=false || DETAILS_VISIBLE=true
        # F3 is always a peek, never a standing choice — see
        # DETAILS_PINNED's own comment.
        DETAILS_PINNED=false
        restore_position="$(find_entry_position "${selection%%$'\t'*}")"
        continue
    fi

    # --------------------------------------------------------
    # F5 / ⌥R — rebuild the cache without leaving the launcher.
    # Doesn't need a selected entry.
    # --------------------------------------------------------

    if [[ "$action" == "f5" || "$action" == "alt-r" ]]; then

        refresh_cache_and_state
        continue
    fi

    # --------------------------------------------------------
    # Esc: one step back at a time. A view filter (same idea as F2's
    # picker itself) and the details pane are two independent things
    # Esc can undo, so whichever is currently "open" closes first —
    # closing the pane takes priority over stepping back a view, and
    # only quits once there's truly nothing left to back out of.
    # "Back" while filtered reopens the category picker (same as F5)
    # rather than jumping straight to "All", so you can switch to a
    # different category without detouring through the full list.
    #
    # Skipped entirely when DETAILS_PINNED is true. Turning Details on via Actions is a
    # standing "always on" choice; Esc immediately undoing it on the
    # very next press would make that choice pointless. A pane opened
    # with a quick F3 press is the opposite — Esc closing it first is
    # exactly what it's for — and DETAILS_PINNED is what tells the two
    # apart (see its own comment).
    # --------------------------------------------------------

    if [[ "$action" == "esc" ]]; then

        if [[ "$DETAILS_VISIBLE" == true && "$DETAILS_PINNED" == false ]]; then
            DETAILS_VISIBLE=false
            restore_position="$(find_entry_position "${selection%%$'\t'*}")"
            continue
        fi

        if [[ "$CURRENT_VIEW" != "All" ]]; then
            pick_view
            build_entries
            continue
        fi

        if confirm_quit; then
            break
        fi

        restore_position="$(find_entry_position "${selection%%$'\t'*}")"
        continue
    fi

    # --------------------------------------------------------
    # Ignore actions without a selection.
    # --------------------------------------------------------

    [[ -z "$selection" ]] && continue

    # --------------------------------------------------------
    # Extract fields from the selected entry.
    #
    # Field 1 = executable
    # Field 2 = display text
    # Field 3 = formula
    # Field 4 = description
    # Field 5 = resolved path (last field, from the cache — see Enter
    #           below for why this is preferred over a fresh lookup)
    # --------------------------------------------------------

    command="${selection%%$'\t'*}"

    remaining="${selection#*$'\t'}"
    remaining="${remaining#*$'\t'}"

    formula="${remaining%%$'\t'*}"

    remaining="${remaining#*$'\t'}"
    resolved_path="${remaining#*$'\t'}"

    # --------------------------------------------------------
    # F2 / ⌥H = hide selected entry.
    # --------------------------------------------------------

    if [[ "$action" == "f6" || "$action" == "alt-h" ]]; then

        # A toggle, like F6 and F7. Previously hiding was one-way and
        # unhiding lived on a separate screen where Enter meant
        # "restore" — the only place a familiar key changed meaning.
        if [[ -n "${hidden_commands[$command]-}" ]]; then
            unhide_entry "$command"
        else
            hide_entry "$command"
        fi

        load_hidden_commands
        build_entries
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # Create Shortcut — reached only through Actions now, not a direct
    # key. Made once per tool and rarely touched again, so it moved
    # off F9 in favor of Launch Preset; see pick_more_action().
    # --------------------------------------------------------

    if [[ "$action" == "shortcut" ]]; then

        create_shortcut "$command" "$formula"
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # Launch Flags — same "Actions only, entry-scoped" shape as
    # Create Shortcut above.
    # --------------------------------------------------------

    if [[ "$action" == "launch_flags" ]]; then

        pick_launch_flags "$command"
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # Run With Args — same resolved-path lookup Enter itself uses
    # further down (the cached path if it's still valid, a fresh PATH
    # lookup otherwise), since this is about to launch the tool right
    # now rather than just store a preference like Launch Flags above.
    # --------------------------------------------------------

    if [[ "$action" == "run_with_args" ]]; then

        if [[ -n "$resolved_path" && -x "$resolved_path" ]]; then
            command_path="$resolved_path"
        else
            command_path="$(command -v "$command" 2>/dev/null)"
        fi

        if [[ -z "$command_path" ]]; then
            printf '\n'
            printf 'Unable to find command: %s\n' "$command"
            sleep 1
        else
            run_with_args "$command" "$command_path"
        fi

        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # Update — Update All's own per-entry sibling. $formula is
    # correct here regardless of whether it came fresh from this
    # screen's own parse or the F4 handler's own early extraction
    # above — both read the same field from the same $selection.
    # --------------------------------------------------------

    if [[ "$action" == "update_tool" ]]; then

        update_tool "$command" "$formula"
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # F6 / ⌥F = toggle Favorites membership for selected entry.
    # --------------------------------------------------------

    if [[ "$action" == "f7" || "$action" == "alt-f" ]]; then

        # No index bookkeeping needed: CURRENT_VIEW holds a name, so
        # creating the Favorites file (which reorders CATEGORY_NAMES)
        # can't shift what we're looking at.
        toggle_favorite "$command"
        refresh_category_state
        load_favorite_commands
        load_category_members
        build_entries
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # F7 / ⌥A = toggle selected entry's membership in a category.
    #
    # While a specific category *other than Favorites* is active,
    # this is instant and prompt-free — exactly like F6 for
    # Favorites, just for whatever category you're currently viewing.
    # Favorites itself is excluded here (and from toggle_category's
    # own choices below) on purpose: F6 is the only key that's
    # allowed to touch Favorites membership, full stop. The
    # typed/picked prompt otherwise shows up on "All" (or while
    # viewing Favorites), where there's no non-Favorites "current
    # category" to default to and you genuinely need to say which
    # one.
    # --------------------------------------------------------

    if [[ "$action" == "f8" || "$action" == "alt-c" ]]; then

        # Instant toggle only when a real, non-Favorites category is
        # the active view. "All", "Hidden" and "Favorites" all fall
        # through to the prompt — Hidden isn't a category you can add
        # to, and F6 owns Favorites.
        if [[ "$CURRENT_VIEW" != "All" && "$CURRENT_VIEW" != "Hidden" && "$CURRENT_VIEW" != "Favorites" ]]; then
            toggle_category_direct "$command" "$CURRENT_VIEW"
        else
            toggle_category "$command"
        fi

        refresh_category_state
        load_favorite_commands
        load_category_members

        build_entries
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # Enter = launch selected entry.
    #
    # Prefer the path the cache already verified during the last
    # rebuild over a fresh `command -v` lookup: it's the same value
    # `command -v` would return anyway in the common case (Homebrew
    # re-points this exact path on every upgrade, it doesn't go
    # stale), and using it closes the narrow gap where something on
    # PATH changed in between browsing the list and pressing Enter —
    # what launches is guaranteed to be what was actually shown.
    #
    # Falls back to a fresh lookup if the cached path is missing
    # (a cache built before this existed) or no longer executable (the
    # formula was fully uninstalled since the cache was built) — that
    # fallback is also the entire safety net a stale cache needs; a
    # rename/reinstall elsewhere on PATH is the one case a fresh
    # lookup could find something the cached path wouldn't, and it's
    # rare enough not to justify always paying for a live lookup.
    # --------------------------------------------------------

    if [[ -n "$resolved_path" && -x "$resolved_path" ]]; then
        command_path="$resolved_path"
    else
        command_path="$(command -v "$command" 2>/dev/null)"
    fi

    if [[ -z "$command_path" ]]; then

        printf '\n'
        printf 'Unable to find command: %s\n' "$command"
        sleep 1

        continue
    fi

    # Logged only once command_path is confirmed real, so a launch
    # that fails to even find a command doesn't still count as a use
    # of it. mkdir here rather than assuming CONFIG_DIR already exists
    # — hiding/favoriting/categorizing all create it lazily too, but
    # a config-free first run could reach Enter before any of those.
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$command" >> "$LAUNCH_HISTORY_FILE"
    (( launch_counts[$command]++ ))
    last_launched_order[$command]=$(( ++LAST_LAUNCHED_COUNTER ))

    # Substitutes a flagged wrapper in place of the plain binary when
    # Launch Flags has one configured for this command — see
    # resolve_launch_path()'s own comment. A no-op (returns
    # $command_path unchanged) for every command without one.
    command_path="$(resolve_launch_path "$command" "$command_path")"

    if [[ "$TERMINAL" == "current" ]]; then

        launch_in_current_terminal "$command_path"

    elif [[ "$TERMINAL" == "ghostty" ]]; then

        if ! launch_in_ghostty "$command_path"; then

            printf '\n'
            printf 'Unable to launch: %s\n' "$command"
            printf 'Make sure Ghostty is installed and macOS allows\n'
            printf 'brew-launcher to control Ghostty.\n'

            sleep 2
        fi

    elif [[ "$TERMINAL" == "tmux" ]]; then

        if ! launch_in_tmux "$command_path"; then

            printf '\n'
            printf 'Unable to launch: %s\n' "$command"
            sleep 2
        fi

    fi

done

exit 0
