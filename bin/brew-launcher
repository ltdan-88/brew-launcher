#!/bin/zsh

# ============================================================
# brew-launcher
#
# Interactive launcher for installed Homebrew CLI applications.
#
# Homebrew + fzf
#
# Usage:
#   brew-launcher
#   brew-launcher --refresh
#   brew-launcher --list
#   brew-launcher --version
#   brew-launcher --help
# ============================================================

setopt pipefail
setopt null_glob

# Resolved once, used to re-invoke this same script for the footer
# mouse-click handler below (${0:A} follows symlinks to the real
# path — needed since Homebrew installs this via a symlink chain).
SCRIPT_PATH="${0:A}"

VERSION="0.5.1"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/brew-launcher"
CACHE_FILE="$CACHE_DIR/entries"
STATE_FILE="$CACHE_DIR/state"

# Bumped whenever the cache file's format changes in a way that makes
# an older cache wrong rather than merely stale. Recorded on the first
# line of STATE_FILE; a mismatch forces a rebuild even when Homebrew
# itself hasn't changed. Without this, a cache written by an older
# version stays "valid" indefinitely and format fixes never reach
# anyone whose installed formulae happen not to change.
#
#   2 — entries are newline-terminated (older caches dropped their
#       last entry when read back), and carry the 7th full_name field
CACHE_FORMAT_VERSION=2

# Side-channel for the footer mouse-click handler: which word was
# clicked, and which footer line it was on (for words that mean
# different things depending on context — see --internal-footer-click
# below). Cleared before every fzf call in run_fzf().
# PID-suffixed so two launchers running side by side can't consume
# each other's clicks.
#
# Exported, and only defaulted when unset, because the click handler
# re-runs this same script as a subprocess: computing "$$" fresh there
# would yield the *child's* PID and point at a different file than the
# launcher is watching. Inheriting the parent's value keeps both ends
# of the side-channel pointing at the same path.
export FOOTER_CLICK_FILE="${FOOTER_CLICK_FILE:-$CACHE_DIR/footer-click.$$}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/brew-launcher"
IGNORE_FILE="$CONFIG_DIR/ignore"

# One file per category, one command per line — same convention as
# IGNORE_FILE above. Created/edited in-picker via F6 (Favorites only)
# and F7 (any category), or by hand. "Favorites" is just an ordinary
# category file with a name the picker order treats specially (see
# load_category_names).
CATEGORIES_DIR="$CONFIG_DIR/categories"

# Outdated-formula snapshot. Refreshed independently of the full cache
# (see refresh_outdated_if_stale below) so the outdated indicator doesn't
# go stale for days just because nothing locally installed has changed.
OUTDATED_FILE="$CACHE_DIR/outdated"
OUTDATED_TTL=21600  # 6 hours

# How long to trust the cache without re-asking Homebrew whether
# anything was installed or removed. That check costs ~0.54s of a
# ~0.55s launch, so skipping it is effectively the entire startup time.
#
# The trade is a window where a just-installed tool isn't listed yet.
# 60s keeps that short, and F5 forces a refresh immediately if you hit
# it. --refresh bypasses this entirely.
STATE_TTL=60

# ------------------------------------------------------------
# Help / version
# ------------------------------------------------------------

if [[ "$1" == "--version" || "$1" == "-v" ]]; then
    echo "brew-launcher $VERSION"
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<EOF
brew-launcher $VERSION

Interactive launcher for installed Homebrew CLI applications.

Usage:
  brew-launcher           Launch the application picker
  brew-launcher --refresh Rebuild the application cache
  brew-launcher --list    Print entries as tab-separated plain text
  brew-launcher --version Show version
  brew-launcher --help    Show this help

Requirements:
  Homebrew
  fzf
  python3

Terminal:
  BREW_LAUNCHER_TERMINAL=auto     Default behavior
  BREW_LAUNCHER_TERMINAL=current  Run in the current terminal
  BREW_LAUNCHER_TERMINAL=ghostty  Launch in a new Ghostty tab

Keyboard shortcuts:
  F2 / ⌥H   Hide or unhide selected entry
  F3 / ⌥V   Switch view (All, Favorites, Hidden, your categories)
  F4 / ⌥S   Create a macOS shortcut
  F5 / ⌥R   Refresh the cache without leaving the launcher
  F6 / ⌥F   Toggle Favorites for selected entry
  F7 / ⌥A   Categorize selected entry (adds or removes; instant while
            viewing a category, otherwise prompts for which one)
  The ⌥ (Option) aliases work if F-keys need Fn on your keyboard.
  In stock Terminal.app, enable "Use Option as Meta Key" in the
  profile's Keyboard settings first; Ghostty supports it by default.

Views:
  F3/⌥V switches what you're looking at: All, Favorites, Hidden, then
  your categories. "Hidden" is an ordinary view — Enter still launches
  there, and F2 unhides. Ctrl-D in the picker deletes the highlighted
  category (All, Hidden and Favorites can't be deleted; Favorites has
  its own F6 toggle).

  Esc goes up one level at a time: a filtered view -> the view picker
  -> All -> quit.

Categories:
  F6/⌥F toggles Favorites for the selected entry, instantly. F7/⌥A is
  the same idea for every other category:

    - While viewing a specific category, it instantly adds or removes
      the selected entry from that category — no prompt, exactly like
      F6 does for Favorites.
    - Otherwise it asks which category: pick an existing one, or type
      a new name to create it. Picking one the entry is already in
      removes it.

  F7 never touches Favorites — F6 owns that exclusively — and it
  always refreshes in place rather than navigating you elsewhere.

  No manual file editing needed for any of this. Categories match on
  command name (use --list to find it), not formula name.
  Row markers describe state, they aren't actions:
    "*"  suffixed on the version (e.g. "1.4.7*") — outdated, a newer
         version exists. Upgrading stays Homebrew's job.
    "+"  before the name — favorited
    "#"  before the name — in some category
  "+" and "#" can show together (e.g. "+#").

Mouse:
  Click a row to select it, double-click to launch it. Footer words
  shown in [brackets] are also clickable and do exactly what the key
  next to them does (e.g. clicking [Hide] is the same as pressing
  F2). Plain, unbracketed footer text — like the "+"/"*" legend or
  "Navigate" — isn't clickable; it's there to explain, not to act on.

Behavior:
  • Applications are discovered automatically from Homebrew.
  • The launcher maintains a local cache for fast startup.
  • On macOS, 'auto' prefers Ghostty when available.
  • On Linux, 'auto' uses the current terminal.
  • The launcher remains available after launching an app in Ghostty.
EOF
    exit 0
fi

# ------------------------------------------------------------
# Footer mouse-click handler (internal use only)
#
# Invoked by run_fzf()'s click-footer bind as a fresh subprocess of
# this same script — not by a user. fzf sets FZF_CLICK_FOOTER_WORD
# (and _LINE) in that subprocess's environment for the duration of
# the click; there's no way to hand that back to the *original*
# fzf-invoking process directly, so this writes it to a small file
# (FOOTER_CLICK_FILE) that the main loop reads after fzf exits.
#
# Placed this early specifically so it skips all the normal startup
# work (dependency checks, cache validation) — a mouse click needs to
# feel instant, not pay the cost of a full launch.
#
# Recognized words fall into two groups:
#   - print "accept": same as pressing Enter on the highlighted item,
#     but first records which word was clicked so the main loop can
#     override $action to match (e.g. "Hide" behaves like F2).
#   - print "abort": same as pressing Esc — for words whose meaning
#     is "go back", where there's nothing to record.
# Anything else (decorative words like "Navigate" or the "+"/"*"
# legend) prints "ignore" — the click does nothing, deliberately, so
# an unrecognized or purely-informational click can't accidentally
# launch whatever happens to be highlighted.
# ------------------------------------------------------------

if [[ "$1" == "--internal-footer-click" ]]; then

    case "$FZF_CLICK_FOOTER_WORD" in
        '[Hide]'|Hide|'[Unhide]'|Unhide|F2/⌥H| \
        '[Views]'|Views|F3/⌥V| \
        '[Shortcut]'|Shortcut|F4/⌥S| \
        '[Refresh]'|Refresh|F5/⌥R| \
        '[Favorite]'|Favorite|F6/⌥F| \
        '[Categorize]'|Categorize|F7/⌥A| \
        '[Quit]'|Quit|Enter|'[Launch]'|Launch| \
        '[View]'|View|'[Delete]'|Delete)
            mkdir -p "$CACHE_DIR"
            printf '%s\n%s\n' "$FZF_CLICK_FOOTER_WORD" "$FZF_CLICK_FOOTER_LINE" > "$FOOTER_CLICK_FILE"
            printf 'accept'
            ;;
        '[Back]'|Back|'[Cancel]'|Cancel)
            printf 'abort'
            ;;
        *)
            printf 'ignore'
            ;;
    esac

    exit 0
fi

# Reached only by the launcher itself — the click handler above exits
# before this line, which matters: if the handler installed this trap
# too, it would delete the click file it just wrote on its own exit.
trap 'rm -f "$FOOTER_CLICK_FILE"' EXIT

FORCE_REFRESH=false
LIST_MODE=false

if [[ "$1" == "--refresh" || "$1" == "-r" ]]; then
    FORCE_REFRESH=true
elif [[ "$1" == "--list" || "$1" == "-l" ]]; then
    LIST_MODE=true
elif [[ -n "$1" ]]; then
    echo "Error: unrecognized argument '$1'."
    echo "Run 'brew-launcher --help' for usage."
    exit 1
fi

# ------------------------------------------------------------
# Requirements
# ------------------------------------------------------------

for dependency in brew fzf python3; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        echo "Error: '$dependency' is required."
        exit 1
    fi
done

# ------------------------------------------------------------
# Terminal configuration
# ------------------------------------------------------------

TERMINAL="${BREW_LAUNCHER_TERMINAL:-auto}"

case "$TERMINAL" in
    auto|current|ghostty)
        ;;
    *)
        echo "Error: unsupported terminal '$TERMINAL'."
        echo "Supported values: auto, current, ghostty."
        exit 1
        ;;
esac

if [[ "$TERMINAL" == "auto" ]]; then
    if [[ "$(uname -s)" == "Darwin" ]] &&
       command -v osascript >/dev/null 2>&1 &&
       [[ -d "/Applications/Ghostty.app" ]]; then
        TERMINAL="ghostty"
    else
        TERMINAL="current"
    fi
fi

if [[ "$TERMINAL" == "ghostty" ]] &&
   ! command -v osascript >/dev/null 2>&1; then
    echo "Error: osascript is required when using Ghostty."
    exit 1
fi

mkdir -p "$CACHE_DIR"

# ------------------------------------------------------------
# Homebrew state
# ------------------------------------------------------------

get_state() {
    {
        brew leaves --installed-on-request 2>/dev/null
        brew list --formula --versions 2>/dev/null
    } | LC_ALL=C sort
}

# Deliberately NOT called at startup. These two brew calls cost about
# 0.54s of a 0.55s launch — practically all of it — and they only exist
# to answer "has anything been installed or removed since last time?".
# The cache validation below skips them entirely while the answer is
# still recent (see STATE_TTL), so repeat launches don't pay for them.
CURRENT_STATE=""

# Fills CURRENT_STATE on demand. Returns non-zero if Homebrew can't be
# read at all, which the callers treat as fatal.
ensure_current_state() {

    [[ -n "$CURRENT_STATE" ]] && return 0

    CURRENT_STATE="$(get_state)"

    [[ -n "$CURRENT_STATE" ]]
}

# ------------------------------------------------------------
# Build cache
# ------------------------------------------------------------

rebuild_cache() {

    local tmp_json tmp_sizes tmp_outdated tmp_entries

    tmp_json="$(mktemp "$CACHE_DIR/formulae.XXXXXX")" || return 1
    tmp_sizes="$(mktemp "$CACHE_DIR/sizes.XXXXXX")" || return 1
    tmp_outdated="$(mktemp "$CACHE_DIR/outdated.XXXXXX")" || return 1
    tmp_entries="$(mktemp "$CACHE_DIR/entries.XXXXXX")" || return 1

    # Single cleanup path for all four temp files, so an early return
    # can't leak the ones it didn't know about.
    cleanup_rebuild_temps() {
        rm -f "$tmp_json" "$tmp_sizes" "$tmp_outdated" "$tmp_entries"
    }

    # --------------------------------------------------------
    # Get installed formula metadata.
    # --------------------------------------------------------

    if ! brew info --json=v1 --installed > "$tmp_json" 2>/dev/null; then
        cleanup_rebuild_temps
        return 1
    fi

    # --------------------------------------------------------
    # Get installed formula sizes.
    #
    # Output format:
    #
    #   formula-name    12.4MB
    #
    # This is only called during cache rebuild.
    # --------------------------------------------------------

    if ! brew info --installed --sizes --formula > "$tmp_sizes" 2>/dev/null; then
        : > "$tmp_sizes"
    fi

    # --------------------------------------------------------
    # Get outdated formula names.
    # --------------------------------------------------------

    if ! brew outdated --formula --quiet > "$tmp_outdated" 2>/dev/null; then
        : > "$tmp_outdated"
    fi

    # --------------------------------------------------------
    # Determine Homebrew prefix.
    # --------------------------------------------------------

    local brew_prefix
    brew_prefix="$(brew --prefix 2>/dev/null)" || {
        cleanup_rebuild_temps
        return 1
    }

    python3 - \
        "$tmp_json" \
        "$tmp_sizes" \
        "$tmp_outdated" \
        "$brew_prefix" \
        "$tmp_entries" <<'PY'

import json
import os
import subprocess
import sys

json_file = sys.argv[1]
sizes_file = sys.argv[2]
outdated_file = sys.argv[3]
brew_prefix = sys.argv[4]
output_file = sys.argv[5]

# ------------------------------------------------------------
# Read Homebrew metadata.
# ------------------------------------------------------------

with open(json_file, "r", encoding="utf-8") as f:
    formulae = json.load(f)

# ------------------------------------------------------------
# Get formulae explicitly installed by the user.
# ------------------------------------------------------------

try:
    leaves = subprocess.check_output(
        ["brew", "leaves", "--installed-on-request"],
        text=True,
        stderr=subprocess.DEVNULL,
    ).splitlines()
except Exception:
    leaves = []

leaves = {x.strip() for x in leaves if x.strip()}

# ------------------------------------------------------------
# Read outdated formula names.
# ------------------------------------------------------------

try:
    with open(outdated_file, "r", encoding="utf-8") as f:
        outdated = {
            line.strip()
            for line in f
            if line.strip()
        }
except OSError:
    outdated = set()

# ------------------------------------------------------------
# Read installed formula sizes.
#
# Current Homebrew output is:
#
#   formula-name    12.4MB
#
# We only need the first and last whitespace-separated fields.
# ------------------------------------------------------------

sizes = {}

try:
    with open(sizes_file, "r", encoding="utf-8") as f:

        for raw_line in f:

            line = raw_line.strip()

            if not line:
                continue

            parts = line.split()

            if len(parts) < 2:
                continue

            formula_name = parts[0]
            size = parts[-1]

            sizes[formula_name] = size

except OSError:
    pass

entries = []

# ------------------------------------------------------------
# Discover executable commands.
# ------------------------------------------------------------

for formula in formulae:

    name = formula.get("name", "")
    full_name = formula.get("full_name", name)

    if not name:
        continue

    # Only include formulae explicitly installed by the user.
    if name not in leaves and full_name not in leaves:
        continue

    description = (
        formula.get("desc", "")
        or "Homebrew CLI application"
    )

    # --------------------------------------------------------
    # Installed version.
    # --------------------------------------------------------

    installed_versions = formula.get("installed", [])

    if installed_versions:
        version = installed_versions[-1].get("version", "")
    else:
        version = ""

    # --------------------------------------------------------
    # Installed size.
    # --------------------------------------------------------

    size = sizes.get(full_name)

    if size is None:
        size = sizes.get(name, "")

    # --------------------------------------------------------
    # Stable Homebrew opt path.
    # --------------------------------------------------------

    opt_bin = os.path.join(
        brew_prefix,
        "opt",
        name,
        "bin",
    )

    if not os.path.isdir(opt_bin):
        continue

    try:
        commands = os.listdir(opt_bin)
    except OSError:
        continue
    
    for command in commands:
    
        path = os.path.join(opt_bin, command)

        # Must be a regular file.
        if not os.path.isfile(path):
            continue

        # Must be executable.
        if not os.access(path, os.X_OK):
            continue

        # Ignore common helper/configuration binaries.
        if (
            command.endswith("-config")
            or command.endswith("-build")
            or command.endswith("-cmake")
            or command.endswith("-test")
            or command.endswith("-tests")
        ):
            continue

        # Make sure the command is reachable through PATH.
        found_on_path = False

        for directory in os.environ.get("PATH", "").split(os.pathsep):

            if not directory:
                continue

            candidate = os.path.join(directory, command)

            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
                found_on_path = True
                break

        if not found_on_path:
            continue

        outdated_flag = "1" if (
            name in outdated
            or full_name in outdated
        ) else "0"

        entries.append(
            "\t".join([
                command,
                description,
                name,
                version,
                size,
                outdated_flag,
                full_name,
            ])
        )

# ------------------------------------------------------------
# Remove duplicate command names.
# ------------------------------------------------------------

seen = set()
unique = []
duplicates = []

for entry in sorted(entries, key=str.lower):

    command = entry.split("\t", 1)[0]
    formula = entry.split("\t")[2]

    if command in seen:
        duplicates.append((command, formula))
        continue

    seen.add(command)
    unique.append(entry)

if duplicates:
    print(
        f"Note: {len(duplicates)} duplicate command name(s) hidden "
        "(first match kept):",
        file=sys.stderr,
    )
    for command, formula in duplicates:
        print(f"  {command}  (also provided by {formula})", file=sys.stderr)

# ------------------------------------------------------------
# Write cache.
# ------------------------------------------------------------

# The trailing newline matters: the shell reads this file with
# `while IFS=... read`, and a final line without a newline terminator
# is silently skipped by that loop — which made the alphabetically
# last entry invisible everywhere in the app.
with open(output_file, "w", encoding="utf-8") as f:
    for entry in unique:
        f.write(entry + "\n")

PY

    if [[ -s "$tmp_entries" ]]; then

        mv "$tmp_entries" "$CACHE_FILE"

        # Format version first, then the Homebrew state snapshot.
        #
        # ensure_current_state rather than assuming a caller filled it
        # in: F5 calls rebuild_cache directly, and startup now skips
        # reading Homebrew's state whenever the TTL says it can. Writing
        # an empty snapshot here would make the cache fail every future
        # comparison and rebuild on every launch.
        ensure_current_state
        printf '%s\n%s\n' "$CACHE_FORMAT_VERSION" "$CURRENT_STATE" > "$STATE_FILE"

        # Reuse the outdated snapshot already fetched above instead of
        # making refresh_outdated_if_stale() fetch it again right after.
        cp "$tmp_outdated" "$OUTDATED_FILE" 2>/dev/null

    else

        cleanup_rebuild_temps

        return 1
    fi

    # tmp_entries was moved into place above; cleaning it again here is
    # a harmless no-op.
    cleanup_rebuild_temps

    return 0
}

# ------------------------------------------------------------
# Validate cache
# ------------------------------------------------------------

CACHE_VALID=false

if [[ "$FORCE_REFRESH" == false &&
      -s "$CACHE_FILE" &&
      -s "$STATE_FILE" ]]; then

    # Line 1 is the cache format version, the rest is the Homebrew
    # state snapshot. A state file written before versioning existed
    # has the snapshot on line 1, so its "version" won't match and the
    # cache correctly rebuilds.
    CACHED_FORMAT="$(sed -n '1p' "$STATE_FILE")"

    if [[ "$CACHED_FORMAT" == "$CACHE_FORMAT_VERSION" ]]; then

        # STATE_FILE's mtime is "when we last confirmed the cache
        # matches Homebrew" — set both by a rebuild and by a successful
        # check below. Inside the TTL, trust it and skip the two brew
        # calls entirely; that's the whole speedup.
        #
        # Deliberately does NOT touch the file on a skip: if it did,
        # frequent launches would keep pushing the deadline out and the
        # cache would never be re-verified. As written, at most one
        # real check happens per TTL window.
        state_mtime="$(stat -f %m "$STATE_FILE" 2>/dev/null || stat -c %Y "$STATE_FILE" 2>/dev/null)"
        state_age=$(( $(date +%s) - ${state_mtime:-0} ))

        if (( state_age < STATE_TTL )); then

            CACHE_VALID=true

        else

            CACHED_STATE="$(sed -n '2,$p' "$STATE_FILE")"

            if ensure_current_state && [[ "$CURRENT_STATE" == "$CACHED_STATE" ]]; then
                CACHE_VALID=true
                # Restart the TTL window from this verification.
                touch "$STATE_FILE"
            fi
        fi
    fi
fi

if [[ "$CACHE_VALID" == false ]]; then

    if ! ensure_current_state; then
        echo "Error: unable to determine installed Homebrew formulae."
        exit 1
    fi

    rebuild_cache || {
        echo "Error: unable to build Homebrew application cache."
        exit 1
    }

fi

# ------------------------------------------------------------
# Refresh outdated-formula snapshot if stale
#
# Independent of CACHE_VALID above: a full rebuild already refreshes
# this (see rebuild_cache), but when the entries cache stays valid for
# a long time (nothing locally installed changes), the outdated
# indicator would otherwise never update on its own.
# ------------------------------------------------------------

refresh_outdated_if_stale() {

    local file_mtime file_age

    if [[ "$FORCE_REFRESH" == true ]]; then
        :
    elif [[ -f "$OUTDATED_FILE" ]]; then

        file_mtime="$(stat -f %m "$OUTDATED_FILE" 2>/dev/null || stat -c %Y "$OUTDATED_FILE" 2>/dev/null)"
        file_age=$(( $(date +%s) - ${file_mtime:-0} ))

        if (( file_age < OUTDATED_TTL )); then
            return 0
        fi
    fi

    brew outdated --formula --quiet > "$OUTDATED_FILE" 2>/dev/null || : > "$OUTDATED_FILE"
}

refresh_outdated_if_stale

# ------------------------------------------------------------
# Make sure we actually have applications.
# ------------------------------------------------------------

if [[ ! -s "$CACHE_FILE" ]]; then
    echo "No Homebrew CLI applications were found."
    exit 0
fi

# ------------------------------------------------------------
# Load hidden command names
#
# Callable again after hiding/restoring an entry, so the picker
# can refresh in place instead of restarting the whole process.
# ------------------------------------------------------------

typeset -A outdated_formulas

# A function rather than inline, so the in-launcher refresh (F5) can
# re-read it after rebuilding the cache.
load_outdated_formulas() {

    outdated_formulas=()

    [[ -f "$OUTDATED_FILE" ]] || return

    local outdated_formula

    while IFS= read -r outdated_formula; do
        [[ -z "$outdated_formula" ]] && continue
        outdated_formulas[$outdated_formula]=1
    done < "$OUTDATED_FILE"
}

load_outdated_formulas

typeset -A hidden_commands

load_hidden_commands() {

    hidden_commands=()

    if [[ -f "$IGNORE_FILE" ]]; then
        while IFS= read -r hidden_command; do

            # Remove leading and trailing whitespace.
            hidden_command="${hidden_command#"${hidden_command%%[![:space:]]*}"}"
            hidden_command="${hidden_command%"${hidden_command##*[![:space:]]}"}"

            [[ -z "$hidden_command" ]] && continue
            [[ "$hidden_command" == \#* ]] && continue

            hidden_commands[$hidden_command]=1

        done < "$IGNORE_FILE"
    fi
}

load_hidden_commands

# ------------------------------------------------------------
# Categories
#
# CATEGORY_NAMES is the picker order: index 0 always means "All" (no
# filter). "Favorites" sorts first if it exists; everything else is
# alphabetical. The *list* of category names is discovered once at
# startup; F7 (toggle_category) explicitly reloads it afterward since
# it can create a brand-new category file.
#
# category_members holds only the *currently active* category's
# membership, reloaded whenever the active category changes — not
# all categories at once.
# ------------------------------------------------------------

typeset -a CATEGORY_NAMES

# The active view, held as a *name* rather than an index into
# CATEGORY_NAMES. Three kinds of value:
#
#   All        every visible entry (hidden ones excluded)
#   Hidden     only hidden entries — an ordinary view, not a separate
#              screen, so Enter still launches and F2 unhides
#   <name>     a category
#
# Storing the name rather than an index matters: creating or deleting
# a category reorders CATEGORY_NAMES, so an index silently starts
# pointing at a different category. Every action that could reorder
# the list used to carry its own "look the name back up" loop to work
# around that; holding the name makes those unnecessary.
CURRENT_VIEW="All"

typeset -A category_members

load_category_names() {

    CATEGORY_NAMES=()

    [[ -d "$CATEGORIES_DIR" ]] || return

    local file name has_favorites=false
    local -a others

    for file in "$CATEGORIES_DIR"/*; do

        [[ -f "$file" ]] || continue

        name="${file:t}"

        # "All" and "Hidden" are built-in view names. F7 refuses to
        # create them, but a hand-made file could still exist — skip it
        # rather than listing a duplicate row that the built-in view
        # would shadow anyway.
        if [[ "$name" == "All" || "$name" == "Hidden" ]]; then
            continue
        fi

        if [[ "$name" == "Favorites" ]]; then
            has_favorites=true
            continue
        fi

        others+=("$name")
    done

    others=("${(@o)others}")

    if [[ "$has_favorites" == true ]]; then
        CATEGORY_NAMES=("Favorites" "${others[@]}")
    else
        CATEGORY_NAMES=("${others[@]}")
    fi
}

load_category_names

load_category_members() {

    category_members=()

    # "All" and "Hidden" aren't backed by a category file.
    [[ "$CURRENT_VIEW" == "All" || "$CURRENT_VIEW" == "Hidden" ]] && return

    local category_file="$CATEGORIES_DIR/$CURRENT_VIEW"
    local member

    [[ -f "$category_file" ]] || return

    while IFS= read -r member; do

        # Remove leading and trailing whitespace.
        member="${member#"${member%%[![:space:]]*}"}"
        member="${member%"${member##*[![:space:]]}"}"

        [[ -z "$member" ]] && continue
        [[ "$member" == \#* ]] && continue

        category_members[$member]=1

    done < "$category_file"
}

# The single "what am I looking at?" hub: All, Hidden, and every
# category, fuzzy-searchable.
#
# "Hidden" is deliberately just another row here rather than its own
# screen. It used to be a separate 100-line view that duplicated the
# list renderer and redefined Enter to mean "restore" — the only place
# in the app where a familiar key did something different. Now Enter
# launches everywhere and F2 toggles hidden, matching how F6 and F7
# already behave.
#
# Ctrl-D deletes the highlighted category file. "All" and "Hidden"
# aren't files, and "Favorites" is protected because F6 owns it. No
# confirmation prompt, matching every other action here; the file is
# trivial to recreate.
#
# Esc inside the picker (empty result) resets to "All" — a consistent
# "Esc goes up one level" model: Games -> [Esc] -> picker -> [Esc] ->
# All -> [Esc] -> quit.
pick_view() {

    local choices result result_lines pick_action picked clicked_word

    choices=("All" "${CATEGORY_NAMES[@]}" "Hidden")

    rm -f "$FOOTER_CLICK_FILE"

    result="$(
        printf '%s\n' "${choices[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label=' View ' \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --footer='  ↑ ↓  Navigate    Type  Search    Enter  [View]    Ctrl-D  [Delete]    Esc  [Back]' \
            --expect=enter,ctrl-d \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    if [[ -z "$result" ]]; then
        CURRENT_VIEW="All"
        load_category_members
        return 1
    fi

    result_lines=("${(@f)result}")
    pick_action="${result_lines[1]}"
    picked="${result_lines[2]}"

    if [[ -f "$FOOTER_CLICK_FILE" ]]; then
        clicked_word="$(sed -n '1p' "$FOOTER_CLICK_FILE")"
        rm -f "$FOOTER_CLICK_FILE"

        case "$clicked_word" in
            '[Delete]'|Delete) pick_action="ctrl-d" ;;
            '[View]'|View) pick_action="enter" ;;
        esac
    fi

    [[ -z "$picked" ]] && return 1

    if [[ "$pick_action" == "ctrl-d" ]]; then

        # "All" and "Hidden" aren't category files, and "Favorites" is
        # protected because F6 owns it — deleting it out from under
        # that would leave F6 unable to get it back into this list.
        #
        # Explicit message on refusal, not a silent no-op: otherwise
        # this falls through to rebuilding with whatever view was
        # active before, which looks like the refused delete
        # "navigated" somewhere on its own.
        if [[ "$picked" == "All" || "$picked" == "Hidden" || "$picked" == "Favorites" ]]; then
            printf '\n'
            printf '"%s" can'"'"'t be deleted.\n' "$picked"
            sleep 1
        else
            rm -f "$CATEGORIES_DIR/$picked"
            load_category_names
            load_categorized_commands

            # If the deleted category was the active view, that view no
            # longer exists.
            [[ "$CURRENT_VIEW" == "$picked" ]] && CURRENT_VIEW="All"
        fi

        # Stay in the picker rather than dropping back to "All" —
        # deleting a category is a "still managing categories" action,
        # not a "done, take me back to the list" one.
        pick_view
        return $?
    fi

    CURRENT_VIEW="$picked"

    load_category_members
}

# Separate from category_members above: this tracks Favorites
# membership regardless of which category is currently active, since
# the favorite marker (see FAVORITE_MARKER_TEXT) needs to show in
# every view, not just while filtered to Favorites.
typeset -A favorite_commands

load_favorite_commands() {

    favorite_commands=()

    local favorites_file="$CATEGORIES_DIR/Favorites"
    local member

    [[ -f "$favorites_file" ]] || return

    while IFS= read -r member; do
        [[ -z "$member" ]] && continue
        favorite_commands[$member]=1
    done < "$favorites_file"
}

load_favorite_commands

# Union of every category's membership except Favorites (which has
# its own tracking above) — powers the "#" marker. Scans all category
# files, not just the currently active one, since like the favorite
# marker this needs to show regardless of which view is active.
typeset -A categorized_commands

load_categorized_commands() {

    categorized_commands=()

    local name category_file member i

    for (( i = 1; i <= ${#CATEGORY_NAMES[@]}; i++ )); do

        name="${CATEGORY_NAMES[$i]}"

        [[ "$name" == "Favorites" ]] && continue

        category_file="$CATEGORIES_DIR/$name"

        [[ -f "$category_file" ]] || continue

        while IFS= read -r member; do
            [[ -z "$member" ]] && continue
            categorized_commands[$member]=1
        done < "$category_file"
    done
}

load_categorized_commands

# ------------------------------------------------------------
# --list: plain tab-separated output, no fzf.
#
# Fields: command, formula, version, size, outdated (0/1), description
#
# For scripting/shell-completion use, not for humans — the padded,
# aligned columns fzf shows are built further below and only used
# for the interactive picker.
# ------------------------------------------------------------

if [[ "$LIST_MODE" == true ]]; then

    while IFS=$'\t' read -r command description formula version size outdated full_name; do

        if [[ -n "${hidden_commands[$command]-}" ]]; then
            continue
        fi

        outdated_flag="0"

        if [[ -n "${outdated_formulas[$formula]-}" || -n "${outdated_formulas[$full_name]-}" ]]; then
            outdated_flag="1"
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$command" "$formula" "$version" "$size" "$outdated_flag" "$description"

    done < "$CACHE_FILE"

    exit 0
fi

# ------------------------------------------------------------
# Calculate column widths.
# ------------------------------------------------------------

# Update indicator is a suffix directly on the version number itself
# (e.g. "1.4.7*") rather than a separate column — a trailing asterisk
# is a familiar "there's a footnote on this" convention (price tags,
# citations), and ties it visually to exactly what it's flagging.
#
# Favorite ("+") and "in some category" ("#") markers share one slot
# at the very start of the line, before the name — both are about the
# tool's organizational identity, not its version, so they sit apart
# from the version-attached update indicator. "#" means "belongs to
# at least one category other than Favorites" — Favorites membership
# already has its own "+", so repeating that as "#" too would just
# be re-showing the same fact. Plain ASCII throughout rather than
# fancier glyphs like "★" or an arrow — "★" didn't render distinctly
# from "*" in testing (font fallback), and "↑" would collide in
# meaning with the footer's own "↑ ↓ Navigate" hint. What each symbol
# means is spelled out in the footer instead. Both markers are shown
# in every view, not just their own filtered one, since toggling from
# the "All" view otherwise gives no visible feedback at all.
# The footer legend names these in the past participle — "Favorited",
# "Categorized", "Outdated" — for two reasons. Semantically they
# describe a *state* a row is in, whereas every bracketed footer item
# is an *action* you can take; "Update" read as a verb and implied the
# launcher would update something, which it never does (that's
# Homebrew's job). Practically, the participles also can't collide
# with the click handler's action words: a bare "Favorite" in the
# legend would be clickable and fire F6.
UPDATE_INDICATOR_TEXT="*"
FAVORITE_MARKER_TEXT="+"
CATEGORIZED_MARKER_TEXT="#"
LEFT_MARKER_WIDTH=$(( ${#FAVORITE_MARKER_TEXT} + ${#CATEGORIZED_MARKER_TEXT} + 2 ))

max_name=4
max_version=7
max_size=4

while IFS=$'\t' read -r command description formula version size outdated full_name; do

    display_name="$formula"

    if [[ "$formula" != "$command" ]]; then
        display_name="$formula ($command)"
    fi

    if (( ${#display_name} > max_name )); then
        max_name=${#display_name}
    fi

    if (( ${#version} > max_version )); then
        max_version=${#version}
    fi

    if (( ${#size} > max_size )); then
        max_size=${#size}
    fi

done < "$CACHE_FILE"

max_name=$((max_name + 3))
# +2 gap, +1 more so the update-indicator suffix (e.g. "1.4.7*") on
# the single longest version string still leaves a full gap, not a
# squeezed one, before the next column.
max_version=$((max_version + 2 + ${#UPDATE_INDICATOR_TEXT}))
max_size=$((max_size + 2))

# ------------------------------------------------------------
# Build fzf display entries.
#
# Field 1 = actual executable
# Field 2 = display text
# Field 3 = formula
# Field 4 = description
#
# Callable again after hiding/restoring an entry. Column widths
# (computed once above) are reused rather than recalculated.
# ------------------------------------------------------------

build_entries() {

    # These MUST be local. The read loop below assigns to `command`
    # and `formula`, which are also the names the launcher loop uses
    # for the currently selected entry — and this function reads with
    # a plain redirect, so it runs in the current shell. Without
    # `local`, finishing the loop leaves both empty, so anything the
    # caller does with "$command" *after* calling build_entries gets
    # an empty string. That silently broke the cursor-restore on F6
    # and F7 (find_entry_position "" never matches, so no position was
    # ever passed to fzf and the cursor snapped back to the top).
    local command description formula version size outdated full_name
    local display_name name_fmt version_text version_fmt size_fmt
    local left_marker left_marker_fmt display

    entries=()

    while IFS=$'\t' read -r command description formula version size outdated full_name; do

        # Three-way view filter. "Hidden" is the only view that shows
        # hidden entries, and it shows nothing else — which is what
        # lets it be an ordinary view instead of a separate screen.
        if [[ "$CURRENT_VIEW" == "Hidden" ]]; then

            [[ -z "${hidden_commands[$command]-}" ]] && continue

        else

            [[ -n "${hidden_commands[$command]-}" ]] && continue

            if [[ "$CURRENT_VIEW" != "All" && -z "${category_members[$command]-}" ]]; then
                continue
            fi
        fi

        display_name="$formula"

        if [[ "$formula" != "$command" ]]; then
            display_name="$formula ($command)"
        fi

        left_marker=" "

        if [[ -n "${favorite_commands[$command]-}" ]]; then
            left_marker="$FAVORITE_MARKER_TEXT"
        fi

        if [[ -n "${categorized_commands[$command]-}" ]]; then
            left_marker="${left_marker}${CATEGORIZED_MARKER_TEXT}"
        fi

        left_marker_fmt="$(printf "%-${LEFT_MARKER_WIDTH}s" "$left_marker")"

        name_fmt="$(printf "%-${max_name}s" "$display_name")"

        version_text="$version"

        if [[ -n "${outdated_formulas[$formula]-}" || -n "${outdated_formulas[$full_name]-}" ]]; then
            version_text="${version}${UPDATE_INDICATOR_TEXT}"
        fi

        version_fmt="$(printf "%-${max_version}s" "$version_text")"
        size_fmt="$(printf "%-${max_size}s" "$size")"

        display="$left_marker_fmt$name_fmt$version_fmt$size_fmt$description"

        entries+=(
            "$command"$'\t'"$display"$'\t'"$formula"$'\t'"$description"
        )

    done < "$CACHE_FILE"
}

build_entries

# ------------------------------------------------------------
# Find an entry's 1-based line number in the current entries array,
# so an action that doesn't remove the highlighted item (favoriting,
# assigning a category, creating a shortcut) can restore the cursor
# to it via run_fzf's initial_position, instead of always jumping
# back to the top of the list on every fzf restart.
# ------------------------------------------------------------

find_entry_position() {

    local target="$1"
    local i entry_command

    for (( i = 1; i <= ${#entries[@]}; i++ )); do
        entry_command="${entries[$i]%%$'\t'*}"

        if [[ "$entry_command" == "$target" ]]; then
            echo "$i"
            return 0
        fi
    done

    return 1
}

# ------------------------------------------------------------
# Column header
# ------------------------------------------------------------

FZF_HEADER="$(
    printf "%-${LEFT_MARKER_WIDTH}s%-${max_name}s%-${max_version}s%-${max_size}s%s" \
        "" \
        "NAME" \
        "VERSION" \
        "SIZE" \
        "DESCRIPTION"
)"

# ------------------------------------------------------------
# fzf colors
# ------------------------------------------------------------

FZF_COLORS='
fg:#cdd6f4,
bg:#1e1e2e,
fg+:#f5e0e6,
bg+:#313244,
hl:#89b4fa,
hl+:#89b4fa,
info:#a6adc8,
prompt:#89b4fa,
pointer:#f38ba8,
marker:#a6e3a1,
spinner:#f5c2e7,
header:#a6adc8,
border:#45475a,
label:#89b4fa,
query:#f5e0e6
'

# ------------------------------------------------------------
# Launch application in the current terminal
# ------------------------------------------------------------

launch_in_current_terminal() {
    local command_path="$1"

    # exec replaces this process, so the EXIT trap never runs — clean
    # the click file up by hand before handing the terminal over.
    rm -f "$FOOTER_CLICK_FILE"

    exec "$command_path"
}

# ------------------------------------------------------------
# Launch application in Ghostty
# ------------------------------------------------------------

launch_in_ghostty() {

    local command_path="$1"

    osascript - "$command_path" <<'APPLESCRIPT'
on run argv

    set commandPath to item 1 of argv

    tell application "Ghostty"

        activate

        if (count of windows) = 0 then

            set newWindow to new window
            set newTerminal to focused terminal of newWindow

        else

            set newTab to new tab in front window
            set newTerminal to focused terminal of newTab

        end if

        input text ("exec " & quoted form of commandPath) to newTerminal

        send key "enter" to newTerminal

    end tell

end run
APPLESCRIPT

    return $?
}

# ------------------------------------------------------------
# Create macOS .command shortcut
# ------------------------------------------------------------

create_shortcut() {

    local command="$1"
    local formula="$2"

    if [[ "$(uname -s)" != "Darwin" ]]; then
        printf '\n'
        printf 'Shortcuts are only supported on macOS.\n'
        sleep 1
        return 1
    fi

    local shortcut_dir="/Applications/TUIs"

    if ! mkdir -p "$shortcut_dir" 2>/dev/null; then
        printf '\n'
        printf 'Unable to create shortcut directory:\n'
        printf '%s\n' "$shortcut_dir"
        printf 'Check that you have permission to write to /Applications.\n'
        sleep 2
        return 1
    fi

    local filename

    if [[ "$formula" == "$command" ]]; then
        filename="${formula}.command"
    else
        filename="${formula}-${command}.command"
    fi

    local shortcut_path="${shortcut_dir}/${filename}"

    if [[ -e "$shortcut_path" ]]; then
        printf '\n'
        printf 'Shortcut already exists:\n'
        printf '%s\n' "$shortcut_path"
        sleep 2
        return 0
    fi

    local command_path
    command_path="$(command -v "$command" 2>/dev/null)"

    if [[ -z "$command_path" ]]; then
        printf '\n'
        printf 'Unable to find command: %s\n' "$command"
        sleep 2
        return 1
    fi

    if ! cat > "$shortcut_path" <<EOF
#!/bin/zsh
exec "$command_path"
EOF
    then
        printf '\n'
        printf 'Unable to create shortcut:\n'
        printf '%s\n' "$shortcut_path"
        sleep 2
        return 1
    fi
    
    if ! chmod +x "$shortcut_path"; then
        rm -f "$shortcut_path"
    
        printf '\n'
        printf 'Unable to make shortcut executable:\n'
        printf '%s\n' "$shortcut_path"
        sleep 2
        return 1
    fi

    printf '\n'
    printf 'Created shortcut:\n'
    printf '%s\n' "$shortcut_path"
    sleep 2
}

# ------------------------------------------------------------
# Hide an application entry
# ------------------------------------------------------------

hide_entry() {

    local command="$1"

    mkdir -p "$CONFIG_DIR"

    # Do not add the same command more than once.
    if [[ -f "$IGNORE_FILE" ]] &&
       grep -Fqx "$command" "$IGNORE_FILE" 2>/dev/null; then
        return 0
    fi

    printf '%s\n' "$command" >> "$IGNORE_FILE"
}


# ------------------------------------------------------------
# Restore a hidden application entry
# ------------------------------------------------------------

unhide_entry() {

    local command="$1"
    local tmp_ignore

    if [[ ! -f "$IGNORE_FILE" ]]; then
        return 0
    fi

    tmp_ignore="$(mktemp "$CACHE_DIR/ignore.XXXXXX")" || return 1

    python3 - "$IGNORE_FILE" "$tmp_ignore" "$command" <<'PY'
import sys

ignore_file = sys.argv[1]
output_file = sys.argv[2]
target = sys.argv[3]

with open(ignore_file, "r", encoding="utf-8") as f:
    lines = f.readlines()

with open(output_file, "w", encoding="utf-8") as f:
    for line in lines:
        stripped = line.strip()

        if stripped == target:
            continue

        f.write(line)
PY

    mv "$tmp_ignore" "$IGNORE_FILE"
}

# ------------------------------------------------------------
# Toggle an entry's Favorites membership
#
# Favorites is an ordinary category file (see load_category_names),
# so this just edits that one file directly — no separate mechanism.
# ------------------------------------------------------------

toggle_favorite() {

    local command="$1"
    local favorites_file="$CATEGORIES_DIR/Favorites"
    local tmp_favorites

    mkdir -p "$CATEGORIES_DIR"

    if [[ -f "$favorites_file" ]] &&
       grep -Fqx "$command" "$favorites_file" 2>/dev/null; then

        # Temp file goes in CACHE_DIR, never CATEGORIES_DIR — every
        # file in the latter is treated as a category by
        # load_category_names, so an interrupted edit would leave a
        # phantom category behind.
        tmp_favorites="$(mktemp "$CACHE_DIR/Favorites.XXXXXX")" || return 1
        grep -Fvx "$command" "$favorites_file" > "$tmp_favorites" 2>/dev/null
        mv "$tmp_favorites" "$favorites_file"

    else

        printf '%s\n' "$command" >> "$favorites_file"
    fi
}

# Same shape as toggle_favorite above, generalized to an arbitrary
# named category — the instant, no-prompt toggle F7 uses when a
# specific category is already active, so it behaves exactly like F6
# does for Favorites instead of always opening the picker/prompt.
toggle_category_direct() {

    local command="$1"
    local category_name="$2"
    local category_file="$CATEGORIES_DIR/$category_name"
    local tmp_category

    mkdir -p "$CATEGORIES_DIR"

    if [[ -f "$category_file" ]] &&
       grep -Fqx "$command" "$category_file" 2>/dev/null; then

        # CACHE_DIR, not CATEGORIES_DIR — see toggle_favorite above.
        tmp_category="$(mktemp "$CACHE_DIR/category.XXXXXX")" || return 1
        grep -Fvx "$command" "$category_file" > "$tmp_category" 2>/dev/null
        mv "$tmp_category" "$category_file"

    else

        printf '%s\n' "$command" >> "$category_file"
    fi
}

# ------------------------------------------------------------
# Toggle an entry's membership in a category by name, typed or picked
#
# Same add/remove toggle as toggle_favorite, generalized to any
# category — picking or typing a category the entry is already in
# removes it instead of being a no-op. That's how you unassign a
# category: press F7/⌥A again and pick/type the same one.
#
# Uses fzf's own --print-query: if the typed text matches an existing
# category it's selected normally; if it matches nothing, Enter still
# exits and --print-query reports the typed text, which is treated as
# a brand-new category name and created on the spot.
#
# Return code notes what happened: 0 = added, 2 = removed, 1 =
# cancelled (no category chosen). Not currently used by the caller —
# F7 always just refreshes in place regardless of which happened —
# kept for whoever's debugging next.
# ------------------------------------------------------------

toggle_category() {

    local command="$1"
    local category_name
    local tmp_category
    local default_query=""
    local name
    local choices=()

    # Favorites is excluded from this list entirely — F6 is the only
    # key allowed to touch Favorites membership. This prompt is only
    # ever reached while on "All" or while viewing Favorites itself
    # (see the F7 dispatch above), and in neither case is there a
    # non-Favorites category to default to, so default_query is left
    # blank rather than pointed at a category that isn't even a
    # choice anymore.
    for name in "${CATEGORY_NAMES[@]}"; do
        [[ "$name" == "Favorites" ]] && continue
        choices+=("$name")
    done

    rm -f "$FOOTER_CLICK_FILE"

    category_name="$(
        printf '%s\n' "${choices[@]}" |
        fzf \
            --print-query \
            --query="$default_query" \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label=' Categorize ' \
            --border-label-pos=2 \
            --prompt=' New or existing: ' \
            --footer='  ↑ ↓  Navigate    Type  New name or pick one    Enter  [Categorize]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --pointer='▌' \
            --color="$FZF_COLORS" |
        tail -n1
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$category_name" ]] && return 1

    # The typed name becomes a filename directly, so reject anything
    # that would escape CATEGORIES_DIR or silently fail. A "/" is an
    # easy typo ("Games/Action") that would otherwise fail with no
    # feedback at all, which reads as the key being broken.
    if [[ "$category_name" == */* || "$category_name" == .* ]]; then
        printf '\n'
        printf 'Invalid category name: %s\n' "$category_name"
        printf 'Names cannot contain "/" or start with ".".\n'
        sleep 2
        return 1
    fi

    # "All" and "Hidden" are built-in view names, not category files.
    # A category called either would show up twice in the view picker,
    # be shadowed by the built-in view (so its members were
    # unreachable), and be undeletable, since Ctrl-D refuses those
    # names. Refuse to create the trap in the first place.
    if [[ "$category_name" == "All" || "$category_name" == "Hidden" ]]; then
        printf '\n'
        printf '"%s" is a built-in view name.\n' "$category_name"
        printf 'Pick a different category name.\n'
        sleep 2
        return 1
    fi

    mkdir -p "$CATEGORIES_DIR"

    local category_file="$CATEGORIES_DIR/$category_name"

    if [[ -f "$category_file" ]] &&
       grep -Fqx "$command" "$category_file" 2>/dev/null; then

        # CACHE_DIR, not CATEGORIES_DIR — see toggle_favorite above.
        tmp_category="$(mktemp "$CACHE_DIR/category.XXXXXX")" || return 1
        grep -Fvx "$command" "$category_file" > "$tmp_category" 2>/dev/null
        mv "$tmp_category" "$category_file"
        return 2

    else

        printf '%s\n' "$command" >> "$category_file"
        return 0
    fi
}


# ------------------------------------------------------------
# Show hidden application entries
# ------------------------------------------------------------

run_fzf() {

    local border_label="$1"
    local footer="$2"
    local expected_keys="$3"
    local initial_position="$4"

    local options=(
        --height=100%
        --no-clear
        --layout=reverse
        --border=rounded
        --border-label="$border_label"
        --border-label-pos=2
        --prompt=' 󰣇  '
        --pointer='▌'
        --marker='●'
        --header="$FZF_HEADER"
        --footer="$footer"
        --info=inline
        --no-scrollbar
        --delimiter=$'\t'
        --with-nth=2
        --nth=1,2,3,4
        --color="$FZF_COLORS"
    )

    if [[ -n "$expected_keys" ]]; then
        options+=(--expect="$expected_keys")
    fi

    if [[ -n "$initial_position" ]]; then
        # "load", not "start" — fzf consumes the input list
        # asynchronously, so "start" fires before it's actually
        # available to move the cursor onto.
        options+=(--bind "load:pos($initial_position)")
    fi

    # Cleared before every call so a stale click from a previous
    # screen/iteration can never leak into this one. See
    # --internal-footer-click above for what actually writes to it.
    rm -f "$FOOTER_CLICK_FILE"
    options+=(--bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click")

    fzf "${options[@]}"
}


# ------------------------------------------------------------
# Launcher loop
# ------------------------------------------------------------

while true; do

    # A view that's become empty (e.g. F2/F6/F7 just removed its last
    # member, or nothing is hidden) is never handed to fzf at all —
    # open the view picker instead of forcing "All", so you can choose
    # where to go next, including deleting a now-empty category right
    # there with Ctrl-D. Whatever fzf does with zero candidates plus a
    # keypress, not relying on it is safer than finding out.
    if (( ${#entries[@]} == 0 )) && [[ "$CURRENT_VIEW" != "All" ]]; then
        printf '\n'
        printf 'Nothing in "%s".\n' "$CURRENT_VIEW"
        sleep 1
        pick_view
        build_entries
        continue
    fi

    border_label=" 󰣇  Homebrew CLI v$VERSION "
    esc_hint="Quit"
    hide_label="Hide"

    if [[ "$CURRENT_VIEW" != "All" ]]; then
        border_label=" 󰣇  Homebrew CLI v$VERSION · $CURRENT_VIEW "
        esc_hint="Views"
    fi

    # In the Hidden view every row is by definition hidden, so F2 can
    # only mean "unhide" — say so rather than making the user infer it.
    [[ "$CURRENT_VIEW" == "Hidden" ]] && hide_label="Unhide"

    fzf_result="$(
        printf '%s\n' "${entries[@]}" |
        run_fzf \
            "$border_label" \
            "  ↑ ↓  Navigate    Type  Search    Enter  [Launch]    Esc  [$esc_hint]    +  Favorited    #  Categorized    *  Outdated
  F2/⌥H  [$hide_label]    F3/⌥V  [Views]    F4/⌥S  [Shortcut]    F5/⌥R  [Refresh]    F6/⌥F  [Favorite]    F7/⌥A  [Categorize]" \
            'enter,f2,f3,f4,f5,f6,f7,alt-h,alt-v,alt-s,alt-r,alt-f,alt-a,esc' \
            "$restore_position"
    )"

    # Only applies to the run_fzf call just made — actions below that
    # want to keep the cursor on the same item (F4, F6, F7) set this
    # again themselves before their own "continue".
    restore_position=""

    # --------------------------------------------------------
    # Esc / empty result = quit.
    # --------------------------------------------------------

    [[ -z "$fzf_result" ]] && break

    # --------------------------------------------------------
    # First line = pressed key.
    # Second line = selected entry.
    # --------------------------------------------------------

    result_lines=("${(@f)fzf_result}")

    action="${result_lines[1]}"
    selection="${result_lines[2]}"

    # --------------------------------------------------------
    # A footer click reports as a plain "enter" above (see
    # run_fzf/--internal-footer-click) — override $action to match
    # whichever key that word stands in for. "Category" means
    # different things on different footer lines (the Esc hint on
    # line 1 vs. F5's own label on line 2), so the clicked line
    # number breaks the tie.
    # --------------------------------------------------------

    if [[ -f "$FOOTER_CLICK_FILE" ]]; then

        clicked_word="$(sed -n '1p' "$FOOTER_CLICK_FILE")"
        rm -f "$FOOTER_CLICK_FILE"

        # "[Views]" appears twice — as the Esc hint on line 1 while
        # filtered, and as F3's own label on line 2. No need to tell
        # them apart: Esc-while-filtered and F3 run the same two lines
        # (pick_view; build_entries), so both map to "f3".
        case "$clicked_word" in
            '[Hide]'|Hide|'[Unhide]'|Unhide|F2/⌥H) action="f2" ;;
            '[Views]'|Views|F3/⌥V) action="f3" ;;
            '[Shortcut]'|Shortcut|F4/⌥S) action="f4" ;;
            '[Refresh]'|Refresh|F5/⌥R) action="f5" ;;
            '[Favorite]'|Favorite|F6/⌥F) action="f6" ;;
            '[Categorize]'|Categorize|F7/⌥A) action="f7" ;;
            '[Quit]'|Quit) action="esc" ;;
            Enter|'[Launch]'|Launch) action="enter" ;;
        esac
    fi

    # --------------------------------------------------------
    # F3 / ⌥V — switch view. Doesn't need a selected entry. Always
    # available: even with no categories defined, "All" and "Hidden"
    # are always offered.
    # --------------------------------------------------------

    if [[ "$action" == "f3" || "$action" == "alt-v" ]]; then

        pick_view
        build_entries
        continue
    fi

    # --------------------------------------------------------
    # F5 / ⌥R — rebuild the cache without leaving the launcher.
    # Doesn't need a selected entry.
    # --------------------------------------------------------

    if [[ "$action" == "f5" || "$action" == "alt-r" ]]; then

        printf '\n'
        printf 'Refreshing…\n'

        # Clear the memoised state so rebuild_cache re-reads Homebrew
        # rather than reusing whatever was captured at startup, which
        # may be minutes old. Re-reading is the point of pressing F5.
        CURRENT_STATE=""

        # rebuild_cache always rebuilds — it doesn't consult
        # FORCE_REFRESH — and it refreshes the outdated snapshot as a
        # side effect, so there's nothing else to force here.
        if rebuild_cache; then
            load_outdated_formulas
            load_hidden_commands
            load_category_names
            load_categorized_commands
            load_favorite_commands
            load_category_members
            build_entries
        else
            printf 'Refresh failed — keeping the existing list.\n'
            sleep 2
        fi

        continue
    fi

    # --------------------------------------------------------
    # Esc: back out of a category filter first, only quit once
    # already on "All" — same one-step-at-a-time idea as F3's
    # hidden-entries screen already using Esc to go back. "Back"
    # while filtered reopens the category picker (same as F5) rather
    # than jumping straight to "All", so you can switch to a
    # different category without detouring through the full list.
    # --------------------------------------------------------

    if [[ "$action" == "esc" ]]; then

        if [[ "$CURRENT_VIEW" != "All" ]]; then
            pick_view
            build_entries
            continue
        fi

        break
    fi

    # --------------------------------------------------------
    # Ignore actions without a selection.
    # --------------------------------------------------------

    [[ -z "$selection" ]] && continue

    # --------------------------------------------------------
    # Extract fields from the selected entry.
    #
    # Field 1 = executable
    # Field 2 = display text
    # Field 3 = formula
    # Field 4 = description
    # --------------------------------------------------------

    command="${selection%%$'\t'*}"

    remaining="${selection#*$'\t'}"
    remaining="${remaining#*$'\t'}"

    formula="${remaining%%$'\t'*}"

    # --------------------------------------------------------
    # F2 / ⌥H = hide selected entry.
    # --------------------------------------------------------

    if [[ "$action" == "f2" || "$action" == "alt-h" ]]; then

        # A toggle, like F6 and F7. Previously hiding was one-way and
        # unhiding lived on a separate screen where Enter meant
        # "restore" — the only place a familiar key changed meaning.
        if [[ -n "${hidden_commands[$command]-}" ]]; then
            unhide_entry "$command"
        else
            hide_entry "$command"
        fi

        load_hidden_commands
        build_entries
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # F4 / ⌥S = create macOS .command shortcut.
    # --------------------------------------------------------

    if [[ "$action" == "f4" || "$action" == "alt-s" ]]; then

        create_shortcut "$command" "$formula"
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # F6 / ⌥F = toggle Favorites membership for selected entry.
    # --------------------------------------------------------

    if [[ "$action" == "f6" || "$action" == "alt-f" ]]; then

        # No index bookkeeping needed: CURRENT_VIEW holds a name, so
        # creating the Favorites file (which reorders CATEGORY_NAMES)
        # can't shift what we're looking at.
        toggle_favorite "$command"
        load_category_names
        load_categorized_commands
        load_favorite_commands
        load_category_members
        build_entries
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # F7 / ⌥A = toggle selected entry's membership in a category.
    #
    # While a specific category *other than Favorites* is active,
    # this is instant and prompt-free — exactly like F6 for
    # Favorites, just for whatever category you're currently viewing.
    # Favorites itself is excluded here (and from toggle_category's
    # own choices below) on purpose: F6 is the only key that's
    # allowed to touch Favorites membership, full stop. The
    # typed/picked prompt otherwise shows up on "All" (or while
    # viewing Favorites), where there's no non-Favorites "current
    # category" to default to and you genuinely need to say which
    # one.
    # --------------------------------------------------------

    if [[ "$action" == "f7" || "$action" == "alt-a" ]]; then

        # Instant toggle only when a real, non-Favorites category is
        # the active view. "All", "Hidden" and "Favorites" all fall
        # through to the prompt — Hidden isn't a category you can add
        # to, and F6 owns Favorites.
        if [[ "$CURRENT_VIEW" != "All" && "$CURRENT_VIEW" != "Hidden" && "$CURRENT_VIEW" != "Favorites" ]]; then
            toggle_category_direct "$command" "$CURRENT_VIEW"
        else
            toggle_category "$command"
        fi

        load_category_names
        load_categorized_commands
        load_favorite_commands
        load_category_members

        build_entries
        restore_position="$(find_entry_position "$command")"
        continue
    fi

    # --------------------------------------------------------
    # Enter = launch selected entry.
    # --------------------------------------------------------

    command_path="$(command -v "$command" 2>/dev/null)"

    if [[ -z "$command_path" ]]; then

        printf '\n'
        printf 'Unable to find command: %s\n' "$command"
        sleep 1

        continue
    fi

    if [[ "$TERMINAL" == "current" ]]; then

        launch_in_current_terminal "$command_path"

    elif [[ "$TERMINAL" == "ghostty" ]]; then

        if ! launch_in_ghostty "$command_path"; then

            printf '\n'
            printf 'Unable to launch: %s\n' "$command"
            printf 'Make sure Ghostty is installed and macOS allows\n'
            printf 'brew-launcher to control Ghostty.\n'

            sleep 2
        fi

    fi

done

exit 0
