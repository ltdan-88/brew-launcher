pointer:#bf616a,
marker:#a3be8c,
spinner:#b48ead,
header:#4c566a,
border:#434c5e,
label:#88c0d0,
query:#eceff4
'
        ;;
    dracula)
        FZF_COLORS='
fg:#f8f8f2,
bg:#282a36,
fg+:#f8f8f2,
bg+:#44475a,
hl:#bd93f9,
hl+:#bd93f9,
info:#6272a4,
prompt:#bd93f9,
pointer:#ff79c6,
marker:#50fa7b,
spinner:#ffb86c,
header:#6272a4,
border:#44475a,
label:#bd93f9,
query:#f8f8f2
'
        ;;
    green)
        # A real CRT with a green-phosphor tube could only ever show
        # one hue at different intensities — no red, no blue. Every
        # slot below stays inside that same green, brightness doing
        # the work color does in the other themes, rather than
        # reaching for an off-hue accent the real hardware never had.
        FZF_COLORS='
fg:#33ff66,
bg:#000000,
fg+:#ccffdd,
bg+:#003311,
hl:#33ff66,
hl+:#ccffdd,
info:#1f8f42,
prompt:#33ff66,
pointer:#ccffdd,
marker:#33ff66,
spinner:#33ff66,
header:#1f8f42,
border:#114422,
label:#33ff66,
query:#ccffdd
'
        ;;
    amber)
        # Same reasoning as green above — one hue, varied by
        # intensity, matching what an actual amber-phosphor monitor
        # (Hercules-style, common on early IBM terminals) could show.
        FZF_COLORS='
fg:#ffbf00,
bg:#000000,
fg+:#ffe699,
bg+:#332200,
hl:#ffbf00,
hl+:#ffe699,
info:#996f00,
prompt:#ffbf00,
pointer:#ffe699,
marker:#ffbf00,
spinner:#ffbf00,
header:#996f00,
border:#4d3800,
label:#ffbf00,
query:#ffe699
'
        ;;
    solarized-dark)
        FZF_COLORS='
fg:#839496,
bg:#002b36,
fg+:#93a1a1,
bg+:#073642,
hl:#268bd2,
hl+:#268bd2,
info:#586e75,
prompt:#268bd2,
pointer:#dc322f,
marker:#859900,
spinner:#cb4b16,
header:#586e75,
border:#073642,
label:#268bd2,
query:#93a1a1
'
        ;;
    solarized-light)
        FZF_COLORS='
fg:#657b83,
bg:#fdf6e3,
fg+:#586e75,
bg+:#eee8d5,
hl:#268bd2,
hl+:#268bd2,
info:#93a1a1,
prompt:#268bd2,
pointer:#dc322f,
marker:#859900,
spinner:#cb4b16,
header:#93a1a1,
border:#eee8d5,
label:#268bd2,
query:#586e75
'
        ;;
    red-sands)
        # From the iTerm2-Color-Schemes collection (mbadolato/iTerm2-
        # Color-Schemes), the reference most terminal color schemes get
        # ported through. A genuinely red theme rather than a theme
        # with a red accent — every other palette here uses red only
        # as one accent among several; this one's actual background
        # is the red. fg/bg/pointer/marker/spinner below are its own
        # published foreground, background and ANSI colors unchanged.
        # It's a classic 16-color ANSI scheme rather than a from-scratch
        # UI palette though, so border and info/header have no official
        # equivalent to carry over — reused its own bright-black ANSI
        # entry for both rather than inventing an unpublished shade.
        FZF_COLORS='
fg:#d7c9a7,
bg:#7a251e,
fg+:#ffffff,
bg+:#a4a390,
hl:#e7b000,
hl+:#e7b000,
info:#6e6e6e,
prompt:#e7b000,
pointer:#00bbbb,
marker:#00bb00,
spinner:#0072ff,
header:#6e6e6e,
border:#6e6e6e,
label:#e7b000,
query:#ffffff
'
        ;;
    custom)
        if [[ -z "$CONFIG_CUSTOM_COLORS" ]]; then
            echo "Error: THEME=custom needs a CUSTOM_COLORS line too."
            echo "Add one to $CONFIG_FILE, in fzf's own --color format, e.g.:"
            echo "CUSTOM_COLORS=fg:#cdd6f4,bg:#1e1e2e,fg+:#f5e0e6,bg+:#313244,hl:#89b4fa,hl+:#89b4fa,info:#a6adc8,prompt:#89b4fa,pointer:#f38ba8,marker:#a6e3a1,spinner:#f5c2e7,header:#a6adc8,border:#45475a,label:#89b4fa,query:#f5e0e6"
            exit 1
        fi
        FZF_COLORS="$CONFIG_CUSTOM_COLORS"
        ;;
    *)
        echo "Error: unknown theme '$THEME_NAME'."
        echo "Supported values: catppuccin, gruvbox, tokyonight, nord, dracula, green, amber, solarized-dark, solarized-light, red-sands, custom."
        exit 1
        ;;
esac

mkdir -p "$CACHE_DIR"

# file_mtime() is defined up near the top of the file (before
# Help/version), not here next to its original use — --diagnose needs
# it too, from a dispatch block that runs well before this point, and
# zsh has no function hoisting.

# ------------------------------------------------------------
# Homebrew state
# ------------------------------------------------------------

get_state() {
    {
        brew leaves --installed-on-request 2>/dev/null
        brew list --formula --versions 2>/dev/null
    } | LC_ALL=C sort
}

# Deliberately NOT called at startup. These two brew calls cost about
# 0.54s of a 0.55s launch — practically all of it — and they only exist
# to answer "has anything been installed or removed since last time?".
# The cache validation below skips them entirely while the answer is
# still recent (see STATE_TTL), so repeat launches don't pay for them.
CURRENT_STATE=""

# Fills CURRENT_STATE on demand. Returns non-zero if Homebrew can't be
# read at all, which the callers treat as fatal.
ensure_current_state() {

    [[ -n "$CURRENT_STATE" ]] && return 0

    CURRENT_STATE="$(get_state)"

    [[ -n "$CURRENT_STATE" ]]
}

# ------------------------------------------------------------
# Fetch outdated formulae as tab-separated "name<TAB>version" lines,
# written to $1.
#
# Shared by rebuild_cache() and refresh_outdated_if_stale() so there's
# exactly one place that knows the actual command and output format —
# these drifted out of sync once already, when refresh_outdated_if_
# stale() switched to --json=v2 for the version string the details
# pane needed, but rebuild_cache() kept its own separate --quiet,
# name-only fetch. Every fresh rebuild silently overwrote the correct
# file with the old format immediately afterward, so a formula's
# "Update available" line in the details pane would go missing right
# after the exact refresh that was supposed to populate it.
# ------------------------------------------------------------

fetch_outdated_formulae() {

    local target_file="$1"

    brew outdated --formula --json=v2 2>/dev/null | python3 -c '
import json, sys

try:
    data = json.load(sys.stdin)
except (ValueError, TypeError):
    data = {}

for formula in data.get("formulae", []):
    name = formula.get("name", "")
    current_version = formula.get("current_version", "")
    if name and current_version:
        print(f"{name}\t{current_version}")
' > "$target_file" || : > "$target_file"
}

# ------------------------------------------------------------
# Prune category files (Favorites included — it's just another file
# under CATEGORIES_DIR) of any command that's no longer installed.
#
# A Favorites count of "0" despite two genuine entries in
# the file reads as a bug, not obviously-correct behavior. Both had
# been uninstalled since being favorited — compute_category_counts()
# already excludes anything not currently known when it counts, so
# the number itself was accurate, but the stale line just sat there
# forever with nothing explaining the gap. Three options existed:
# leave the stale reference (so
# reinstalling brings the favorite/category back automatically), show
# the gap explicitly ("2, 0 installed"), or clean it up when a rebuild
# confirms it's actually gone. Went with cleaning it up.
#
# Runs once per real cache rebuild, not on every launch — the set of
# installed formulae has to be freshly confirmed for "no longer
# installed" to mean anything, and rebuild_cache() just finished doing
# exactly that. Comments and blank lines pass through untouched; only
# an actual command line for something no longer installed is removed.
# Presets are deliberately left alone — a stale command in a preset
# already fails gracefully at run time (that pane just doesn't open),
# and silently shrinking someone's saved pane layout felt like a
# different, more surprising kind of change than trimming a list.
# ------------------------------------------------------------

prune_stale_category_members() {

    [[ -d "$CATEGORIES_DIR" ]] || return 0
    [[ -s "$CACHE_FILE" ]] || return 0

    local -A prune_known_commands
    local prune_known_command
    local category_file member trimmed tmp_pruned

    while IFS=$'\t' read -r prune_known_command _; do
        [[ -n "$prune_known_command" ]] && prune_known_commands[$prune_known_command]=1
    done < "$CACHE_FILE"

    for category_file in "$CATEGORIES_DIR"/*(N); do

        [[ -f "$category_file" ]] || continue

        tmp_pruned="$(mktemp "$CACHE_DIR/prune.XXXXXX")" || continue

        while IFS= read -r member; do

            trimmed="${member#"${member%%[![:space:]]*}"}"
            trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"

            if [[ -z "$trimmed" || "$trimmed" == \#* ]]; then
                printf '%s\n' "$member" >> "$tmp_pruned"
                continue
            fi

            [[ -n "${prune_known_commands[$trimmed]-}" ]] &&
                printf '%s\n' "$member" >> "$tmp_pruned"

        done < "$category_file"

        mv "$tmp_pruned" "$category_file"
    done
}

# ------------------------------------------------------------
# Build cache
# ------------------------------------------------------------

rebuild_cache() {

    local tmp_json tmp_sizes tmp_outdated tmp_entries

    tmp_json="$(mktemp "$CACHE_DIR/formulae.XXXXXX")" || return 1
    tmp_sizes="$(mktemp "$CACHE_DIR/sizes.XXXXXX")" || return 1
    tmp_outdated="$(mktemp "$CACHE_DIR/outdated.XXXXXX")" || return 1
    tmp_entries="$(mktemp "$CACHE_DIR/entries.XXXXXX")" || return 1

    # Single cleanup path for all four temp files, so an early return
    # can't leak the ones it didn't know about.
    cleanup_rebuild_temps() {
        rm -f "$tmp_json" "$tmp_sizes" "$tmp_outdated" "$tmp_entries"
    }

    # --------------------------------------------------------
    # Get installed formula metadata.
    # --------------------------------------------------------

    if ! brew info --json=v1 --installed > "$tmp_json" 2>/dev/null; then
        cleanup_rebuild_temps
        return 1
    fi

    # --------------------------------------------------------
    # Get installed formula sizes.
    #
    # Output format:
    #
    #   formula-name    12.4MB
    #
    # This is only called during cache rebuild.
    # --------------------------------------------------------

    if ! brew info --installed --sizes --formula > "$tmp_sizes" 2>/dev/null; then
        : > "$tmp_sizes"
    fi

    # --------------------------------------------------------
    # Get outdated formulae, with the version that's available.
    # --------------------------------------------------------

    fetch_outdated_formulae "$tmp_outdated"

    # --------------------------------------------------------
    # Determine Homebrew prefix.
    # --------------------------------------------------------

    local brew_prefix
    brew_prefix="$(brew --prefix 2>/dev/null)" || {
        cleanup_rebuild_temps
        return 1
    }

    if [[ ! -f "$CACHE_WRITER_PY" ]]; then
        echo "Error: cache writer not found: $CACHE_WRITER_PY" >&2
        echo "This usually means a broken/incomplete install." >&2
        cleanup_rebuild_temps
        return 1
    fi

    python3 "$CACHE_WRITER_PY" \
        "$tmp_json" \
        "$tmp_sizes" \
        "$tmp_outdated" \
        "$brew_prefix" \
        "$tmp_entries" \
        "$PREVIEW_DIR" \
        "$PREVIEW_CATEGORY_MARKER" \
        "$PREVIEW_PRESET_MARKER"

    if [[ -s "$tmp_entries" ]]; then

        mv "$tmp_entries" "$CACHE_FILE"

        # See prune_stale_category_members() — needs the fresh
        # CACHE_FILE just moved into place above to know what's
        # actually still installed.
        prune_stale_category_members

        # Format version first, then the Homebrew state snapshot.
        #
        # ensure_current_state rather than assuming a caller filled it
        # in: F5 calls rebuild_cache directly, and startup now skips
        # reading Homebrew's state whenever the TTL says it can. Writing
        # an empty snapshot here would make the cache fail every future
        # comparison and rebuild on every launch.
        ensure_current_state
        printf '%s\n%s\n' "$CACHE_FORMAT_VERSION" "$CURRENT_STATE" > "$STATE_FILE"

        # Reuse the outdated snapshot already fetched above instead of
        # making refresh_outdated_if_stale() fetch it again right after.
        cp "$tmp_outdated" "$OUTDATED_FILE" 2>/dev/null

        du -sh "$(brew --prefix)/Cellar" 2>/dev/null |
            awk '{print $1}' |
            sed -E 's/([0-9])([KMGT])i?$/\1\2/' \
            > "$HOMEBREW_USAGE_FILE"

    else

        cleanup_rebuild_temps

        return 1
    fi

    # tmp_entries was moved into place above; cleaning it again here is
    # a harmless no-op.
    cleanup_rebuild_temps

    return 0
}

# ------------------------------------------------------------
# Validate cache
# ------------------------------------------------------------

CACHE_VALID=false

if [[ "$FORCE_REFRESH" == false &&
      -s "$CACHE_FILE" &&
      -s "$STATE_FILE" ]]; then

    # Line 1 is the cache format version, the rest is the Homebrew
    # state snapshot. A state file written before versioning existed
    # has the snapshot on line 1, so its "version" won't match and the
    # cache correctly rebuilds.
    CACHED_FORMAT="$(sed -n '1p' "$STATE_FILE")"

    if [[ "$CACHED_FORMAT" == "$CACHE_FORMAT_VERSION" ]]; then

        # STATE_FILE's mtime is "when we last confirmed the cache
        # matches Homebrew" — set both by a rebuild and by a successful
        # check below. Inside the TTL, trust it and skip the two brew
        # calls entirely; that's the whole speedup.
        #
        # Deliberately does NOT touch the file on a skip: if it did,
        # frequent launches would keep pushing the deadline out and the
        # cache would never be re-verified. As written, at most one
        # real check happens per TTL window.
        state_mtime="$(file_mtime "$STATE_FILE")"
        state_age=$(( $(date +%s) - ${state_mtime:-0} ))

        if (( state_age < STATE_TTL )); then

            CACHE_VALID=true

        else

            CACHED_STATE="$(sed -n '2,$p' "$STATE_FILE")"

            if ensure_current_state && [[ "$CURRENT_STATE" == "$CACHED_STATE" ]]; then
                CACHE_VALID=true
                # Restart the TTL window from this verification.
                touch "$STATE_FILE"
            fi
        fi
    fi
fi

if [[ "$CACHE_VALID" == false ]]; then

    if ! ensure_current_state; then
        echo "Error: unable to determine installed Homebrew formulae."
        exit 1
    fi

    rebuild_cache || {
        echo "Error: unable to build Homebrew application cache."
        exit 1
    }

fi

# ------------------------------------------------------------
# Refresh outdated-formula snapshot if stale
#
# Independent of CACHE_VALID above: a full rebuild already refreshes
# this (see rebuild_cache), but when the entries cache stays valid for
# a long time (nothing locally installed changes), the outdated
# indicator would otherwise never update on its own.
# ------------------------------------------------------------

refresh_outdated_if_stale() {

    # Named distinctly from the file_mtime() helper it calls — a
    # local variable shadowing a function of the same name is safe in
    # zsh (separate namespaces) but reads exactly like the collision
    # that caused the v0.4.2 cursor bug, so it's avoided on sight
    # rather than relied on being technically fine.
    local outdated_mtime file_age

    if [[ "$FORCE_REFRESH" == true ]]; then
        :
    elif [[ -s "$OUTDATED_FILE" ]] && [[ "$(head -1 "$OUTDATED_FILE")" != *$'\t'* ]]; then
        # Pre-0.11.0 format: one plain formula name per line, no
        # version column. Refresh now regardless of TTL, rather than
        # silently reading an empty "version" for everything (which
        # reads as false, so the outdated marker would just stop
        # showing at all) until the TTL happened to expire on its own.
        :
    elif [[ -f "$OUTDATED_FILE" ]]; then

        outdated_mtime="$(file_mtime "$OUTDATED_FILE")"
        file_age=$(( $(date +%s) - ${outdated_mtime:-0} ))

        if (( file_age < OUTDATED_TTL )); then
            return 0
        fi
    fi

    fetch_outdated_formulae "$OUTDATED_FILE"
}

refresh_outdated_if_stale

# ------------------------------------------------------------
# Make sure we actually have applications.
# ------------------------------------------------------------

if [[ ! -s "$CACHE_FILE" ]]; then
    echo "No Homebrew CLI applications were found."
    exit 0
fi

# ------------------------------------------------------------
# Load hidden command names
#
# Callable again after hiding/restoring an entry, so the picker
# can refresh in place instead of restarting the whole process.
# ------------------------------------------------------------

typeset -A outdated_formulas

# A function rather than inline, so the in-launcher refresh (F5) can
# re-read it after rebuilding the cache.
#
# Values are the available version string, not just "1" — the details
# pane shows it directly. Every existing truthiness check (`-n
# "${outdated_formulas[$x]-}"`) still works unchanged: a real version
# string is non-empty, same as the old sentinel value was.
load_outdated_formulas() {

    outdated_formulas=()

    [[ -f "$OUTDATED_FILE" ]] || return

    local outdated_formula outdated_version

    while IFS=$'\t' read -r outdated_formula outdated_version; do
        [[ -z "$outdated_formula" ]] && continue
        outdated_formulas[$outdated_formula]="$outdated_version"
    done < "$OUTDATED_FILE"
}

load_outdated_formulas

# The bundled curated list of genuinely auxiliary commands (see
# "Bundled defaults") — read straight from the cache's default_hidden
# field (field 11), which rebuild_cache() already stamped on every
# entry regardless of the DEFAULT_HIDDEN config setting. Kept separate
# from hidden_commands below so hide_entry()/unhide_entry() can tell
# "hidden because bundled" apart from "hidden because IGNORE_FILE
# says so" — they need different files to write to.
typeset -A bundled_hidden_commands

load_bundled_hidden_commands() {

    bundled_hidden_commands=()

    [[ -f "$CACHE_FILE" ]] || return

    local raw_command raw_default_hidden
    local _f2 _f3 _f4 _f5 _f6 _f7 _f8 _f9 _f10

    while IFS=$'\t' read -r raw_command _f2 _f3 _f4 _f5 _f6 _f7 _f8 _f9 _f10 raw_default_hidden; do
        [[ "$raw_default_hidden" == "1" ]] && bundled_hidden_commands[$raw_command]=1
    done < "$CACHE_FILE"
}

# Commands force-shown despite being in bundled_hidden_commands above
# — the one place F6 records "I actually want this one," since there's
# no line in bundled_hidden_commands to remove the way there would be
# for an ordinary IGNORE_FILE entry.
typeset -A shown_commands

load_shown_commands() {

    shown_commands=()

    [[ -f "$SHOWN_FILE" ]] || return

    local member

    while IFS= read -r member; do
        [[ -z "$member" ]] && continue
        shown_commands[$member]=1
    done < "$SHOWN_FILE"
}

typeset -A hidden_commands

load_hidden_commands() {

    hidden_commands=()

    if [[ -f "$IGNORE_FILE" ]]; then
        while IFS= read -r hidden_command; do

            # Remove leading and trailing whitespace.
            hidden_command="${hidden_command#"${hidden_command%%[![:space:]]*}"}"
            hidden_command="${hidden_command%"${hidden_command##*[![:space:]]}"}"

            [[ -z "$hidden_command" ]] && continue
            [[ "$hidden_command" == \#* ]] && continue

            hidden_commands[$hidden_command]=1

        done < "$IGNORE_FILE"
    fi

    # Layer the bundled defaults on top, unless the user's own F6 press
    # already showed this one despite the bundled data (SHOWN_FILE) or
    # the whole feature is switched off. Reloaded here rather than
    # trusted from an earlier call — this function already gets called
    # fresh after anything that could change hiding state, and doing
    # the same for its two inputs keeps that one guarantee in one place
    # instead of every call site remembering to pair it up itself.
    load_bundled_hidden_commands
    load_shown_commands

    if [[ "$CONFIG_DEFAULT_HIDDEN" != off ]]; then
        local bundled_command
        for bundled_command in "${(k)bundled_hidden_commands[@]}"; do
            [[ -n "${shown_commands[$bundled_command]-}" ]] && continue
            hidden_commands[$bundled_command]=1
        done
    fi
}

load_hidden_commands

# Tallied from LAUNCH_HISTORY_FILE on demand rather than kept
# permanently in sync — the file is a plain append-only log (see its
# own definition above for why), so counting means reading it once,
# which stays cheap at any realistic size for a personal tool.
typeset -A launch_counts

# Recency of last launch, for the Recently Launched view — a different
# question from launch_counts' own tally (something launched once
# yesterday and something launched 50 times last year rank oppositely
# on the two). LAUNCH_HISTORY_FILE has no timestamp column, but being
# strictly append-only means it doesn't need one: each command's LAST
# line number in the file already says exactly how recent it is
# relative to every other command's own last line. Assigned in the
# same read pass as launch_counts below rather than a second file
# read — line_number is a plain incrementing counter, not the real
# line number of any specific row (blank lines are skipped without
# advancing it), which is all a relative ordering needs.
#
# LAST_LAUNCHED_COUNTER carries that same counter forward past this
# initial load, in memory, for any launch that happens later in this
# same process — see run_with_args() and the main loop's own
# Enter-launch, the two places that increment it further. A file
# reread after every single launch would give the exact same
# ordering; incrementing in memory is just cheaper and matches how
# launch_counts itself only mutates in memory afterward too.
typeset -A last_launched_order
LAST_LAUNCHED_COUNTER=0

load_launch_counts() {

    launch_counts=()
    last_launched_order=()
    LAST_LAUNCHED_COUNTER=0

    [[ -f "$LAUNCH_HISTORY_FILE" ]] || return

    local logged_command

    while IFS= read -r logged_command; do
        [[ -z "$logged_command" ]] && continue
        (( launch_counts[$logged_command]++ ))
        (( LAST_LAUNCHED_COUNTER++ ))
        last_launched_order[$logged_command]=$LAST_LAUNCHED_COUNTER
    done < "$LAUNCH_HISTORY_FILE"
}

load_launch_counts

# Filled in by build_entries() as it reads the cache — every row
# already carries this, so recording it costs nothing extra and gives
# the Recently Added view a lookup that survives past the read loop
# without changing the shape of the `entries` tuples the rest of the
# script parses.
typeset -A install_times

# Same idea as install_times above, for SORT_ORDER=size — the display
# string as-is (e.g. "1.7MB"), not yet converted to bytes; that
# conversion only needs to happen for whatever survived the current
# view's filter, so it's done once per sort rather than for every
# installed formula on every build_entries() call.
typeset -A entry_sizes

# Parses a human-formatted size string (e.g. "1.7MB", "410.8KB", the
# same text `brew info --sizes` reports and the SIZE column already
# shows) into a whole number of bytes, for SORT_ORDER=size's sort key.
# Unrecognized input (a missing size, or a unit outside KB/MB/GB/TB)
# sorts as 0 rather than erroring the whole list out — worse position,
# not a crash.
size_sort_key() {

    local size_text="$1"
    local number multiplier

    case "$size_text" in
        *TB) number="${size_text%TB}"; multiplier=$((1024*1024*1024*1024)) ;;
        *GB) number="${size_text%GB}"; multiplier=$((1024*1024*1024)) ;;
        *MB) number="${size_text%MB}"; multiplier=$((1024*1024)) ;;
        *KB) number="${size_text%KB}"; multiplier=1024 ;;
        *B)  number="${size_text%B}";  multiplier=1 ;;
        *)   number="$size_text";      multiplier=1 ;;
    esac

    if [[ ! "$number" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf '0'
        return
    fi

    printf '%.0f' "$(( number * multiplier ))"
}

# ------------------------------------------------------------
# Categories
#
# CATEGORY_NAMES is the picker order: index 0 always means "All" (no
# filter). "Favorites" sorts first if it exists; everything else is
# alphabetical. The *list* of category names is discovered once at
# startup; F7 (toggle_category) explicitly reloads it afterward since
# it can create a brand-new category file.
#
# category_members holds only the *currently active* category's
# membership, reloaded whenever the active category changes — not
# all categories at once.
# ------------------------------------------------------------

typeset -a CATEGORY_NAMES

# The active view, held as a *name* rather than an index into
# CATEGORY_NAMES. Three kinds of value:
#
#   All        every visible entry (hidden ones excluded)
#   Hidden     only hidden entries — an ordinary view, not a separate
#              screen, so Enter still launches and F2 unhides
#   <name>     a category
#
# Storing the name rather than an index matters: creating or deleting
# a category reorders CATEGORY_NAMES, so an index silently starts
# pointing at a different category. Every action that could reorder
# the list used to carry its own "look the name back up" loop to work
# around that; holding the name makes those unnecessary.
CURRENT_VIEW="All"

# Whether the F3 details pane is currently open. Used to be fzf's own
# native toggle-preview bind, invisible to this script entirely — but
# that meant Esc could never know the pane was open, so it always fell
# straight through to Quit/Views instead of just closing the pane
# first. Routed through the normal dispatch-and-redraw loop instead,
# same as every other toggle (F6/F7/F8) already works, so Esc can
# check this before deciding what "back" means.
DETAILS_VISIBLE=false

# F2/F9's own F3 preview (what's inside the highlighted category/
# preset) shares this exact flag rather than tracking its own — first
# shipped as a separate PICKER_DETAILS_VISIBLE precisely so turning
# one on wouldn't silently turn the other on too, but the intended
# behavior turned out to be the opposite: once on, it should stay on
# everywhere a details pane is available. One flag, one on/off
# state, everywhere F3 (or Actions -> Details) can toggle it.

# Turning Details on via Actions is meant as a standing preference
# ("always on"), but the main list's own Esc-closes-the-pane-first
# behavior (see the "Whether the F3 details pane" comment above) would
# immediately undo it on the very next Esc, indistinguishable from a
# pane opened with a quick F3 press. Tracks *how* the pane was last
# turned on: F3 always sets this false (a peek — Esc closing it first
# is exactly the point), Actions -> Details sets it to match
# DETAILS_VISIBLE (a standing choice — Esc should skip straight past
# it to whatever the next back-step is, same as if the pane weren't
# there). This is the flag that lets Esc tell the two cases apart
# without guessing.
DETAILS_PINNED=false

typeset -A category_members

load_category_names() {

    CATEGORY_NAMES=()

    local file name has_favorites=false
    local -a others
    typeset -A seen_names

    if [[ -d "$CATEGORIES_DIR" ]]; then

        for file in "$CATEGORIES_DIR"/*; do

            [[ -f "$file" ]] || continue

            name="${file:t}"

            # These are all built-in view names. F7 refuses to create a
            # category with any of them, but a hand-made file could still
            # exist — skip it rather than listing a duplicate row that the
            # built-in view would shadow anyway.
            if [[ "$name" == "All" || "$name" == "Hidden" \
                  || "$name" == "Most Used" || "$name" == "Recently Added" \
                  || "$name" == "Recently Launched" ]]; then
                continue
            fi

            if [[ "$name" == "Favorites" ]]; then
                has_favorites=true
                continue
            fi

            others+=("$name")
            seen_names[$name]=1
        done
    fi

    # Bundled-only categories (see load_bundled_categories) don't have
    # a real file yet, but still need to be browsable — merge in any
    # category name they reference that a real file hasn't already
    # added above. No dependency on CATEGORIES_DIR existing at all:
    # a totally fresh install with zero user categories still gets a
    # full set of bundled ones to browse.
    #
    # Built up in two steps rather than one nested expansion — a
    # `${(u)${(v)assoc}}` chained inline silently skipped the dedupe
    # flag in testing, while assigning the values to a plain array
    # first and applying (u) to that worked correctly.
    local bundled_category
    local -a bundled_category_values bundled_category_names

    bundled_category_values=("${(@v)default_category_commands}")
    bundled_category_names=("${(u)bundled_category_values[@]}")

    for bundled_category in "${bundled_category_names[@]}"; do
        [[ -n "${seen_names[$bundled_category]-}" ]] && continue
        others+=("$bundled_category")
        seen_names[$bundled_category]=1
    done

    others=("${(@o)others}")

    if [[ "$has_favorites" == true ]]; then
        CATEGORY_NAMES=("Favorites" "${others[@]}")
    else
        CATEGORY_NAMES=("${others[@]}")
    fi
}

load_category_members() {

    category_members=()

    # "All" and "Hidden" aren't backed by a category file.
    [[ "$CURRENT_VIEW" == "All" || "$CURRENT_VIEW" == "Hidden" ]] && return

    local category_file="$CATEGORIES_DIR/$CURRENT_VIEW"
    local member

    if [[ -f "$category_file" ]]; then
        while IFS= read -r member; do

            # Remove leading and trailing whitespace.
            member="${member#"${member%%[![:space:]]*}"}"
            member="${member%"${member##*[![:space:]]}"}"

            [[ -z "$member" ]] && continue
            [[ "$member" == \#* ]] && continue

            category_members[$member]=1

        done < "$category_file"
    fi

    # Bundled members (see load_bundled_categories) — added on top of
    # whatever the real file above already contributed, so a category
    # that's part real, part bundled shows both. Works even when the
    # file above doesn't exist at all, which is exactly the bundled-
    # only case load_category_names() added this name to browse in
    # the first place.
    for member in "${(k)default_category_commands[@]}"; do
        [[ "${default_category_commands[$member]}" == "$CURRENT_VIEW" ]] && \
            category_members[$member]=1
    done
}

# " *" once a newer brew-launcher itself is available, "" otherwise.
# Reuses the exact outdated-formulae snapshot every other "*" marker in
# this app already reads from (see load_outdated_formulas above) —
# brew-launcher is just another installed formula to that mechanism,
# so this rides the same refresh timer/F5-refresh cadence rather than
# running a separate check of its own, with the same freshness caveat
# already documented in Troubleshooting for every other outdated
# marker: it reflects whatever Homebrew last knew locally, not a live
# check on every launch.
launcher_update_marker() {
    [[ -n "${outdated_formulas[brew-launcher]-}" ]] && printf '*'
}

# Shared border-label shape for every screen that isn't the main list —
# same " Homebrew CLI vX · <label> " format the main list already uses
# for a filtered view, just without the disk-usage figures (those only
# fit comfortably on the one screen that has the room and reason to
# carry them). Consistency matters more now that Open to Categories can
# make View the very first thing a launch shows — every screen should
# still read as brew-launcher, not just the main list.
screen_border_label() {
    printf ' 󰣇  Homebrew CLI v%s%s · %s ' "$VERSION" "$(launcher_update_marker)" "$1"
}

# Confirm before deleting a category. Returns 0 to proceed.
#
# Deleting is the one irreversible action in the launcher — F2, F6 and
# F7 are all toggles you can undo with the same key, but a category you
# spent time curating is gone for good. It also sits in the view
# picker, which is now the main navigation hub, so it's easy to reach
# by accident.
#
# The member count is the point of the prompt: "Delete Games?" is noise
# when it holds one entry and genuinely worth pausing over when it
# holds twenty. Cancel is listed first so it's the default and Esc also
# cancels — the safe outcome takes no thought.
confirm_delete_category() {

    local name="$1"
    local file="$CATEGORIES_DIR/$name"
    local count=0
    local answer

    [[ -f "$file" ]] && count="$(grep -c '[^[:space:]]' "$file" 2>/dev/null || echo 0)"

    local noun="entries"
    (( count == 1 )) && noun="entry"

    answer="$(
        printf '%s\n' "Cancel" "Delete \"$name\" and its $count $noun" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Delete category')" \
            --border-label-pos=2 \
            --prompt='  ' \
            --pointer='▌' \
            --header="This can't be undone." \
            `# "Enter chooses" is deliberately not bracketed/clickable:` \
            `# Enter acts on the highlighted row, so a clickable` \
            `# [Confirm] would cancel whenever Cancel was highlighted.` \
            --footer='  ↑ ↓  Navigate    Enter  chooses    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS"
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ "$answer" == Delete* ]]
}

# Rename a category: type a new name, prefilled with the current one
# via fzf's own --print-query — the same "type a name" idiom
# toggle_category() already uses to accept a brand new category name,
# reused here instead of inventing a second text-entry mechanism. A
# category IS its filename (see CATEGORIES_DIR throughout this file),
# so renaming one is nothing more than moving that file; nothing else
# to update anywhere. Prints the new name on success for the caller to
# react to (e.g. updating CURRENT_VIEW), nothing on cancel/failure.
rename_category() {

    local old_name="$1"
    local new_name

    rm -f "$FOOTER_CLICK_FILE"

    # head -n1, not tail -n1: with --print-query the typed text is
    # always the FIRST line, followed by the matched row (if any) from
    # the single-row list below it. That list only ever contains
    # old_name itself, so almost any edit that keeps a prefix of it
    # (e.g. "Weathers" -> "Weather") still fuzzy-matches it, and
    # tail -n1 would grab that stale match instead of what was typed —
    # silently discarding the rename entirely, since it then reads as
    # "new name == old name" (e.g. renaming "Weathers" to "Weather" did
    # nothing). tail -n1 made sense for toggle_category(),
    # which offers a real list of choices and deliberately prefers an
    # exact existing match over the raw query; there is no such list
    # here, so the query is always what we want.
    new_name="$(
        printf '%s\n' "$old_name" |
        fzf \
            --print-query \
            --query="$old_name" \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Rename category')" \
            --border-label-pos=2 \
            --prompt=' New name: ' \
            --footer='  Type  New name    Enter  [Rename]    Esc  [Cancel]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --pointer='▌' \
            --color="$FZF_COLORS" |
        head -n1
    )"

    rm -f "$FOOTER_CLICK_FILE"

    [[ -z "$new_name" || "$new_name" == "$old_name" ]] && return 1

    # Same filename-safety rule toggle_category() already applies when
    # creating a category by typing a brand new name.
    if [[ "$new_name" == */* || "$new_name" == .* ]]; then
        printf '\n'
        printf 'Invalid category name: %s\n' "$new_name"
        printf 'Names cannot contain "/" or start with ".".\n'
        sleep 2
        return 1
    fi

    if [[ "$new_name" == "All" || "$new_name" == "Hidden" || "$new_name" == "Favorites" \
          || "$new_name" == "Most Used" || "$new_name" == "Recently Added" \
          || "$new_name" == "Recently Launched" ]]; then
        printf '\n'
        printf '"%s" is a built-in view name.\n' "$new_name"
        printf 'Pick a different name.\n'
        sleep 2
        return 1
    fi

    if [[ -e "$CATEGORIES_DIR/$new_name" ]]; then
        printf '\n'
        printf 'A category named "%s" already exists.\n' "$new_name"
        printf 'Delete or rename that one first if you meant to merge them.\n'
        sleep 2
        return 1
    fi

    mv "$CATEGORIES_DIR/$old_name" "$CATEGORIES_DIR/$new_name"
    printf '%s' "$new_name"
}

# The single "what am I looking at?" hub: All, Hidden, and every
# category, fuzzy-searchable.
#
# "Hidden" is deliberately just another row here rather than its own
# screen. It used to be a separate 100-line view that duplicated the
# list renderer and redefined Enter to mean "restore" — the only place
# in the app where a familiar key did something different. Now Enter
# launches everywhere and F2 toggles hidden, matching how F6 and F7
# already behave.
#
# Ctrl-D deletes the highlighted category file. "All" and "Hidden"
# aren't files, and "Favorites" is protected because F6 owns it. No
# confirmation prompt, matching every other action here; the file is
# trivial to recreate.
#
# Esc inside the picker (empty result) resets to "All" — a consistent
# "Esc goes up one level" model: Games -> [Esc] -> picker -> [Esc] ->
# All -> [Esc] -> quit.
# ------------------------------------------------------------
# The [Actions] menu — second-tier actions.
#
# The split is by what you're doing, not by how often: browsing
# (find something, look at it, run it) stays on the main footer,
# while organizing and maintenance live here. Those are the things
# you do while setting the launcher up or once in a blue moon, and
# they were costing six of the seven footer slots you look at every
# single launch.
#
# Every action here keeps its direct key, still live on the main
# list — this menu is the discovery path, not the only one. It
# prints each key beside its label so it teaches its own shortcut
# and works itself out of a job.
# ------------------------------------------------------------

# ------------------------------------------------------------
# F1 — the help screen.
#
# Used to be deliberately left off the footer on the theory that
# F1=help is close to universal knowledge, not worth spending space
# teaching. Not finding it in practice is direct evidence that
# assumption doesn't hold for everyone; now the first item in
# footer_actions(), reading first the same way it numbers first,
# rather than trailing the very keys it explains. Still not in the Actions
# menu's own listing — Actions already means "act on the highlighted
# row," and Help isn't that. Purely informational: the same fzf list
# idiom as every other screen here, every row inert, Enter/Esc both
# just go back.
#
# Split across a topic picker plus four short screens rather than one
# long scrolling list — the single-list version had grown past 100
# rows as features accumulated, which read as a wall of text rather
# than something organized. Same "one level down, its own screen"
# restructuring Settings itself already went through for the same
# reason. pick_help() is the topic picker (kept as the function every
# existing call site already calls, so nothing above it needed to
# change); each show_help_*() below is one topic, same flat-list idiom
# the single screen used to be, just scoped smaller. Esc from a topic
# returns to this picker; Esc from here returns to whatever screen
# opened it, exactly as the old single screen already did.
# ------------------------------------------------------------

pick_help() {

    local -a topics=(
        "keys"$'\t'"$(printf '%-22s%s' 'Keys' 'Markers, F-keys, and the details pane')"
        "actions"$'\t'"$(printf '%-22s%s' 'Actions Menu' 'Bulk actions and everything else under F4')"
        "settings"$'\t'"$(printf '%-22s%s' 'Settings Reference' 'What each toggle in F4 -> Settings does')"
        "mouse"$'\t'"$(printf '%-22s%s' 'Mouse & Good to Know' 'Clicking, timing, and how Esc behaves')"
    )
    local result chosen

    while true; do

        rm -f "$FOOTER_CLICK_FILE"

        result="$(
            printf '%s\n' "${topics[@]}" |
            fzf \
                --height=100% \
                --no-clear \
                --layout=reverse \
                --border=rounded \
                --border-label="$(screen_border_label 'Help')" \
                --border-label-pos=2 \
                --prompt=' 󰣇  ' \
                --pointer='▌' \
                --delimiter=$'\t' \
                --with-nth=2 \
                --footer='  ↑ ↓  Navigate    Enter  [Open]    Esc  [Back]' \
                --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
                --color="$FZF_COLORS"
        )"

        rm -f "$FOOTER_CLICK_FILE"

        [[ -z "$result" ]] && return 0

        chosen="${result%%$'\t'*}"

        case "$chosen" in
            keys)     show_help_keys ;;
            actions)  show_help_actions_menu ;;
            settings) show_help_settings_reference ;;
            mouse)    show_help_mouse_and_notes ;;
        esac
    done
}

# Shared by all four show_help_*() screens below — same flat-list
# idiom the single pre-split screen already used, every row inert,
# Enter/Esc both just return to pick_help()'s own topic list.
show_help_screen() {

    local -a rows=("$@")

    rm -f "$FOOTER_CLICK_FILE"

    printf '%s\n' "${rows[@]}" |
        fzf \
            --height=100% \
            --no-clear \
            --layout=reverse \
            --border=rounded \
            --border-label="$(screen_border_label 'Help')" \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --footer='  ↑ ↓  Navigate    Enter/Esc  [Back]' \
            --bind "click-footer:transform:$SCRIPT_PATH --internal-footer-click" \
            --color="$FZF_COLORS" \
            > /dev/null

    rm -f "$FOOTER_CLICK_FILE"
}

show_help_keys() {

    local -a rows=()

    rows+=("Markers — shown next to an entry, not things you press")
    rows+=("  +  Favorited        #  Categorized        *  Outdated")
    rows+=("")
    rows+=("The same * appears after brew-launcher's own version in the border")
    rows+=("above once a newer brew-launcher itself is available to install —")
    rows+=("same outdated-formula check, brew-launcher is just another one to it")
    rows+=("")
    rows+=("First tier — always on screen")
    rows+=("  F2 / ⌥V   Switch view (All, Favorites, categories, Most Used,")
    rows+=("            Recently Launched, Recently Added, Hidden) — F3 there")
    rows+=("            previews what's in the highlighted category, Ctrl-R")
    rows+=("            renames it, Ctrl-D deletes it")
    rows+=("  F3 / ⌥D   Show or hide the details pane")
    rows+=("  F4 / ⌥M   Open the Actions menu — see Actions Menu")
    rows+=("            F4 and F9 also work from inside the view picker (F2)")
    if [[ "$TMUX_AVAILABLE" == true ]]; then
        rows+=("  F9 / ⌥P   Launch a preset — new window if there's one to open,")
        rows+=("            otherwise reattaches if it's already running")
        rows+=("            Its own details pane, always on, previews what's in")
        rows+=("            the highlighted preset. Ctrl-E rearranges it (same")
        rows+=("            Tab-to-mark screen as Create Preset, seeded from its")
        rows+=("            current members — can add/remove too, not just")
        rows+=("            reorder), Ctrl-R renames it, Ctrl-D deletes it")
    else
        rows+=("  F9 / ⌥P   Launch a preset — needs tmux: brew install tmux")
    fi
    rows+=("")
    rows+=("Second tier — F4, or press directly at any time")
    rows+=("  F5 / ⌥R   Refresh the cache — also works from the view picker (F2)")
    rows+=("  F6 / ⌥H   Hide or unhide the selected entry")
    rows+=("  F7 / ⌥F   Toggle Favorites for the selected entry")
    rows+=("  F8 / ⌥C   Categorize the selected entry")
    rows+=("")
    rows+=("Details pane, once open")
    rows+=("  Shift-Up / Shift-Down   Scroll it")
    rows+=("  Esc                     Closes it first — back/quit on the next press")

    show_help_screen "${rows[@]}"
}

