#!/bin/zsh

# ============================================================
# brew-launcher
#
# Interactive launcher for installed Homebrew CLI applications.
#
# macOS + Homebrew + fzf + Ghostty
#
# Usage:
#   brew-launcher
#   brew-launcher --refresh
#   brew-launcher --version
#   brew-launcher --help
# ============================================================

setopt pipefail
setopt null_glob

VERSION="0.1.1"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/brew-launcher"
CACHE_FILE="$CACHE_DIR/entries"
STATE_FILE="$CACHE_DIR/state"

# ------------------------------------------------------------
# Help / version
# ------------------------------------------------------------

if [[ "$1" == "--version" || "$1" == "-v" ]]; then
    echo "brew-launcher $VERSION"
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<EOF
brew-launcher $VERSION

Interactive launcher for installed Homebrew CLI applications.

Usage:
  brew-launcher           Launch the application picker
  brew-launcher --refresh Rebuild the application cache
  brew-launcher --version Show version
  brew-launcher --help    Show this help

Requirements:
  macOS
  Homebrew
  fzf
  Ghostty

Behavior:
  • Applications are discovered automatically from Homebrew.
  • The launcher maintains a local cache for fast startup.
  • Selecting an application opens it in a new Ghostty tab.
  • If Ghostty is not running, it is launched automatically.
  • The launcher remains available after launching an app.
EOF
    exit 0
fi

FORCE_REFRESH=false

if [[ "$1" == "--refresh" || "$1" == "-r" ]]; then
    FORCE_REFRESH=true
fi

# ------------------------------------------------------------
# Requirements
# ------------------------------------------------------------

for dependency in brew fzf python3 osascript; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        echo "Error: '$dependency' is required."
        exit 1
    fi
done

# Ghostty itself doesn't need to be on PATH, because it is
# launched through macOS's application system.

mkdir -p "$CACHE_DIR"

# ------------------------------------------------------------
# Homebrew state
#
# Two relatively cheap Homebrew calls are used to determine
# whether the cached application list is still current.
# ------------------------------------------------------------

get_state() {
    {
        brew leaves --installed-on-request 2>/dev/null
        brew list --formula --versions 2>/dev/null
    } | LC_ALL=C sort
}

CURRENT_STATE="$(get_state)"

if [[ -z "$CURRENT_STATE" ]]; then
    echo "Error: unable to determine installed Homebrew formulae."
    exit 1
fi

# ------------------------------------------------------------
# Build cache
# ------------------------------------------------------------

rebuild_cache() {

    local tmp_json="$CACHE_DIR/formulae.json"
    local tmp_entries="$CACHE_DIR/entries.tmp"

    # One Homebrew call for all installed metadata.
    if ! brew info --json=v1 --installed > "$tmp_json" 2>/dev/null; then
        rm -f "$tmp_json"
        return 1
    fi

    # Determine the Homebrew prefix.
    local brew_prefix
    brew_prefix="$(brew --prefix 2>/dev/null)" || {
        rm -f "$tmp_json"
        return 1
    }

    python3 - "$tmp_json" "$brew_prefix" "$tmp_entries" <<'PY'
import json
import os
import subprocess
import sys

json_file = sys.argv[1]
brew_prefix = sys.argv[2]
output_file = sys.argv[3]

# ------------------------------------------------------------
# Read Homebrew metadata
# ------------------------------------------------------------

with open(json_file, "r", encoding="utf-8") as f:
    formulae = json.load(f)

# ------------------------------------------------------------
# Get formulae explicitly installed by the user.
# ------------------------------------------------------------

try:
    leaves = subprocess.check_output(
        ["brew", "leaves", "--installed-on-request"],
        text=True,
        stderr=subprocess.DEVNULL,
    ).splitlines()
except Exception:
    leaves = []

leaves = {x.strip() for x in leaves if x.strip()}

entries = []

# ------------------------------------------------------------
# Discover executable commands.
# ------------------------------------------------------------

for formula in formulae:

    name = formula.get("name", "")
    full_name = formula.get("full_name", name)

    if not name:
        continue

    # Only include formulae explicitly installed by the user.
    if name not in leaves and full_name not in leaves:
        continue

    description = (
        formula.get("desc", "")
        or "Homebrew CLI application"
    )

    # Homebrew's opt path remains stable across upgrades.
    opt_bin = os.path.join(
        brew_prefix,
        "opt",
        name,
        "bin",
    )

    if not os.path.isdir(opt_bin):
        continue

    try:
        commands = os.listdir(opt_bin)
    except OSError:
        continue

    for command in commands:

        path = os.path.join(opt_bin, command)

        # Must be a regular file.
        if not os.path.isfile(path):
            continue

        # Must be executable.
        if not os.access(path, os.X_OK):
            continue

        # Ignore common helper/configuration binaries.
        if (
            command.endswith("-config")
            or command.endswith("-build")
            or command.endswith("-cmake")
            or command.endswith("-test")
            or command.endswith("-tests")
        ):
            continue

        # Make sure the command is actually reachable through PATH.
        found_on_path = False

        for directory in os.environ.get("PATH", "").split(os.pathsep):

            if not directory:
                continue

            candidate = os.path.join(directory, command)

            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
                found_on_path = True
                break

        if not found_on_path:
            continue

        entries.append(
            f"{command}\t{description}\t{full_name}"
        )

# ------------------------------------------------------------
# Remove duplicate command names.
# ------------------------------------------------------------

seen = set()
unique = []

for entry in sorted(entries, key=str.lower):

    command = entry.split("\t", 1)[0]

    if command in seen:
        continue

    seen.add(command)
    unique.append(entry)

# ------------------------------------------------------------
# Write cache.
# ------------------------------------------------------------

with open(output_file, "w", encoding="utf-8") as f:
    f.write("\n".join(unique))

PY

    if [[ -s "$tmp_entries" ]]; then

        mv "$tmp_entries" "$CACHE_FILE"

        printf '%s\n' "$CURRENT_STATE" > "$STATE_FILE"

    else

        rm -f "$tmp_entries"
        rm -f "$tmp_json"

        return 1
    fi

    rm -f "$tmp_json"

    return 0
}

# ------------------------------------------------------------
# Validate cache
# ------------------------------------------------------------

CACHE_VALID=false

if [[ "$FORCE_REFRESH" == false &&
      -s "$CACHE_FILE" &&
      -s "$STATE_FILE" ]]; then

    CACHED_STATE="$(cat "$STATE_FILE")"

    if [[ "$CURRENT_STATE" == "$CACHED_STATE" ]]; then
        CACHE_VALID=true
    fi
fi

if [[ "$CACHE_VALID" == false ]]; then

    rebuild_cache || {
        echo "Error: unable to build Homebrew application cache."
        exit 1
    }

fi

# ------------------------------------------------------------
# Make sure we actually have applications.
# ------------------------------------------------------------

if [[ ! -s "$CACHE_FILE" ]]; then
    echo "No Homebrew CLI applications were found."
    exit 0
fi

# ------------------------------------------------------------
# Calculate command column width.
# ------------------------------------------------------------

max_command=$(
    cut -f1 "$CACHE_FILE" |
    awk '
        {
            if (length > max)
                max = length
        }
        END {
            print max + 3
    }'
)

# ------------------------------------------------------------
# Build fzf display entries.
#
# Field 1 = actual executable
# Field 2 = display text
# Field 3 = formula
# ------------------------------------------------------------

entries=()

while IFS=$'\t' read -r command description formula; do

    command_fmt="$(printf "%-${max_command}s" "$command")"

    entries+=(
        "$command"$'\t'"$command_fmt$description"$'\t'"$formula"
    )

done < "$CACHE_FILE"

# ------------------------------------------------------------
# fzf colors
# ------------------------------------------------------------

FZF_COLORS='
fg:#cdd6f4,
bg:#1e1e2e,
fg+:#f5e0e6,
bg+:#313244,
hl:#89b4fa,
hl+:#89b4fa,
info:#a6adc8,
prompt:#89b4fa,
pointer:#f38ba8,
marker:#a6e3a1,
spinner:#f5c2e7,
header:#a6adc8,
border:#45475a,
label:#89b4fa,
query:#f5e0e6
'

# ------------------------------------------------------------
# Launch application in Ghostty
#
# The command path is passed as an AppleScript argument.
# This avoids shell/AppleScript quoting problems.
# ------------------------------------------------------------

launch_in_ghostty() {

    local command_path="$1"

    osascript - "$command_path" <<'APPLESCRIPT'
on run argv

    set commandPath to item 1 of argv

    tell application "Ghostty"

        activate

        if (count of windows) = 0 then

            -- Ghostty isn't currently showing a window.
            -- Create a new window.

            set newWindow to new window
            set newTerminal to focused terminal of newWindow

        else

            -- Ghostty is already running.
            -- Create a new tab in the front window.

            set newTab to new tab in front window
            set newTerminal to focused terminal of newTab

        end if

        -- Use the terminal's shell to execute the application.
        input text ("exec " & quoted form of commandPath) to newTerminal

        send key "enter" to newTerminal

    end tell

end run
APPLESCRIPT

    return $?
}

# ------------------------------------------------------------
# Launcher loop
# ------------------------------------------------------------

while true; do

    selection=$(
        printf '%s\n' "${entries[@]}" |
        fzf \
            --height=100% \
            --layout=reverse \
            --border=rounded \
            --border-label=' 󰣇  Homebrew CLI ' \
            --border-label-pos=2 \
            --prompt=' 󰣇  ' \
            --pointer='▌' \
            --marker='●' \
            --header='  ↑ ↓  Navigate    Type  Search    Enter  Launch    Esc  Quit' \
            --info=inline \
            --no-scrollbar \
            --delimiter=$'\t' \
            --with-nth=2 \
            --nth=1,2,3 \
            --color="$FZF_COLORS"
    )

    # --------------------------------------------------------
    # Esc / empty selection = quit.
    # --------------------------------------------------------

    [[ -z "$selection" ]] && break

    # --------------------------------------------------------
    # Extract the actual executable name.
    # --------------------------------------------------------

    command="${selection%%$'\t'*}"

    # --------------------------------------------------------
    # Resolve the executable.
    # --------------------------------------------------------

    command_path="$(command -v "$command" 2>/dev/null)"

    if [[ -z "$command_path" ]]; then

        printf '\n'
        printf 'Unable to find command: %s\n' "$command"
        sleep 1

        continue
    fi

    # --------------------------------------------------------
    # Launch it in Ghostty.
    # --------------------------------------------------------

    if ! launch_in_ghostty "$command_path"; then

        printf '\n'
        printf 'Unable to launch: %s\n' "$command"
        printf 'Make sure Ghostty is installed and macOS allows\n'
        printf 'brew-launcher to control Ghostty.\n'

        sleep 2
    fi

done

exit 0
