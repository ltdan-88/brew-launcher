        rows+=("     Create Preset  Pick tools to save as a new preset")
        rows+=("                    Tab shows the launch order as a number;")
        rows+=("                    Tab again unmarks and renumbers the rest")
    else
        rows+=("     Create Preset  needs tmux: brew install tmux")
    fi
    if [[ "$(uname -s)" == "Darwin" || "$(uname -s)" == "Linux" ]]; then
        rows+=("  Create Shortcut  macOS .command or Linux .desktop file")
    fi
    rows+=("      Launch Flags  Extra arguments to always pass this entry —")
    rows+=("                    applies to presets it's in too. Blank clears")
    rows+=("     Run With Args  Launch this entry now with extra arguments,")
    rows+=("                    just once. Prefilled with its Launch Flags.")
